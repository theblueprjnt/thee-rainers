---
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Thee Rainers',
  description = 'Systemic boxing performance. Seven levers. Autonomic regulation. Built for fighters who think in structures, not sessions.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://theerainers.com');

const siteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://theerainers.com/#organization",
      "name": "Thee Rainers",
      "url": "https://theerainers.com",
      "logo": "https://theerainers.com/images/logo-trb.png",
      "sameAs": ["https://www.youtube.com/@Rainers"],
      "description": "Systemic boxing performance methodology. The Rainers Blueprint is a vertically integrated operating system built on the 7 Holy Virtues, 7 Performance Levers, and the Word of God."
    },
    {
      "@type": "Person",
      "@id": "https://theerainers.com/#founder",
      "name": "Rainers",
      "url": "https://theerainers.com/about",
      "jobTitle": "Boxing Performance Architect",
      "worksFor": { "@id": "https://theerainers.com/#organization" },
      "knowsAbout": [
        "Systemic Boxing Performance",
        "Kinetic Chain Integrity",
        "Autonomic Regulation",
        "Perceptual Training",
        "Neural Boxing",
        "Footwork Methodology"
      ]
    }
  ]
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5LQ7HPXG');</script>
    <!-- End Google Tag Manager -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/images/nobg_theerainersblueprint.png" />
    <link rel="apple-touch-icon" href="/images/nobg_theerainersblueprint.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Thee Rainers" />
    <meta property="og:title" content="Thee Rainers | Boxing Tech &amp; Performance" />
    <meta property="og:description" content="Your ambition is ahead of your gym. Build the base. Everything else follows." />
    <meta property="og:image" content="https://theerainers.com/images/og_social_share.jpg" />
    <meta property="og:url" content="https://theerainers.com" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@theerainers" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content="https://theerainers.com/images/og_social_share.jpg" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={siteSchema} />
    <!-- Cloudflare Web Analytics -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "6c995d4bc9a446c3b92eba609ef3ba69"}'></script>
    <!-- Funnel event helper — single source of truth for dataLayer pushes -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.trackEvent = function(name, data) {
        try { window.dataLayer.push(Object.assign({ event: name }, data || {})); } catch (e) {}
      };

      // Product registry — Stripe Payment Link IDs and community lookup keys
      // mapped to GA4-shaped ecommerce items. Keep in sync with vault.astro
      // products array and create-checkout.ts PRICE_IDS.
      var TR_PRODUCTS = {
        '7sY28r8lt1D06XU6446J20n': { id: 'defense_workshop',        name: 'Defense Workshop',        price: 197 },
        '6oUaEX7hp6Xk3LIdww6J20p': { id: 'workshop_replay',         name: 'Workshop Replay',         price:  79 },
        'bJe14n8lt81ogyu3VW6J20k': { id: 'footwork_blueprint',      name: 'Footwork Blueprint',      price:  47 },
        '5kQdR91X5dlIeqm8cc6J20l': { id: 'shadowboxing_blueprint',  name: 'Shadowboxing Blueprint',  price:  47 },
        '14A4gz59hgxUaa65006J20m': { id: 'bundle_both_blueprints',  name: 'Bundle (Both Blueprints)', price:  87 },
        'greatness_monthly':       { id: 'greatness_monthly',       name: 'Greatness Community — Monthly', price: 39 },
        'greatness_annual':        { id: 'greatness_annual',        name: 'Greatness Community — Annual',  price: 390 }
      };

      // Delegated click — fires begin_checkout for ANY buy button site-wide.
      // Covers <a href="buy.stripe.com/..."> AND <button data-checkout="...">.
      document.addEventListener('click', function(e) {
        var t = e.target && e.target.closest && e.target.closest('a[href*="buy.stripe.com"], button[data-checkout]');
        if (!t) return;
        var product = null;
        if (t.tagName === 'A') {
          var m = (t.getAttribute('href') || '').match(/buy\.stripe\.com\/(\w+)/);
          if (m) product = TR_PRODUCTS[m[1]];
        } else {
          product = TR_PRODUCTS[t.getAttribute('data-checkout') || ''];
        }
        if (!product) return;
        window.trackEvent('begin_checkout', {
          ecommerce: {
            currency: 'USD',
            value: product.price,
            items: [{ item_id: product.id, item_name: product.name, price: product.price, quantity: 1 }]
          }
        });
      });
    </script>
    <slot name="head" />
  </head>
  <body class="bg-bg text-ink min-h-screen flex flex-col overflow-x-hidden">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5LQ7HPXG" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Email capture tollbooth — entry pages only -->
    <div id="tr-popup" role="dialog" aria-modal="true" aria-labelledby="tr-popup-heading"
      class="fixed inset-0 z-[200] flex items-end sm:items-center justify-center p-4 hidden pointer-events-none"
      style="background: rgba(10,10,10,0.65); backdrop-filter: blur(3px);">
      <div class="bg-white w-full max-w-[440px] relative pointer-events-auto"
        style="box-shadow: 0 24px 80px rgba(0,0,0,0.4);">

        <button id="tr-popup-close"
          aria-label="Close"
          class="absolute top-4 right-4 text-[#0A0A0A]/25 hover:text-[#0A0A0A] transition-colors text-xl leading-none font-bold cursor-pointer bg-transparent border-0 p-1">
          &times;
        </button>

        <div class="p-8 pb-6">
          <p class="text-[#D4A373] text-[10px] tracking-widest uppercase mb-4">Free · 30-Day Protocol</p>
          <h2 id="tr-popup-heading" class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.85] mb-3"
            style="font-size: clamp(1.6rem, 4vw, 2rem);">
            Build the base<br/>before anything else.
          </h2>
          <p class="text-[#0A0A0A]/55 text-sm leading-relaxed mb-6">
            30-day stance foundation. No gym. No equipment. The structural base most athletes never build. Free.
          </p>

          <form id="tr-popup-form" class="flex flex-col gap-3">
            <label for="tr-popup-email" class="sr-only">Email address</label>
            <input
              type="email"
              id="tr-popup-email"
              name="email"
              placeholder="your@email.com"
              autocomplete="email"
              required
              class="w-full border border-[#0A0A0A]/15 bg-[#F7F6F4] px-4 py-3.5 text-sm text-[#0A0A0A] placeholder:text-[#0A0A0A]/30 focus:outline-none focus:border-[#0057FF] transition-colors duration-200"
            />
            <button type="submit" id="tr-popup-submit"
              class="w-full inline-flex items-center justify-center rounded-none font-bold bg-[#0057FF] text-white px-6 py-4 text-sm tracking-wide uppercase hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 transition-colors duration-150 disabled:opacity-40 cursor-pointer border-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4A373] focus-visible:ring-offset-2">
              Get the Free Protocol →
            </button>
          </form>

          <div id="tr-popup-success" class="hidden text-center py-4">
            <p class="font-black text-[#0A0A0A] text-base uppercase tracking-tight mb-1">It's on the way.</p>
            <p class="text-[#0A0A0A]/45 text-sm">Check your inbox. Day 1 starts when you decide.</p>
          </div>

          <p class="text-[#0A0A0A]/20 text-[10px] mt-4 text-center">Your email. Nothing else.</p>
        </div>
      </div>
    </div>

  </body>
</html>

<script is:inline>
(function() {
  var STORAGE_KEY = 'tr_popup_v2';

  // Only fire on organic entry pages — never interrupt purchase flow
  var ENTRY_PAGES = ['/', '/links', '/footwork-foundation', '/lever-audit'];
  var path = window.location.pathname.replace(/\/$/, '') || '/';
  var isEntryPage = ENTRY_PAGES.indexOf(path) !== -1;

  function isDismissed() {
    try { return !!localStorage.getItem(STORAGE_KEY); } catch(e) { return false; }
  }

  // Any dismiss is permanent
  function dismiss() {
    try { localStorage.setItem(STORAGE_KEY, '1'); } catch(e) {}
    var popup = document.getElementById('tr-popup');
    if (popup) popup.classList.add('hidden');
  }

  function showPopup() {
    if (isDismissed()) return;
    var popup = document.getElementById('tr-popup');
    if (!popup) return;
    popup.classList.remove('hidden');
    var emailInput = document.getElementById('tr-popup-email');
    if (emailInput) setTimeout(function() { emailInput.focus(); }, 50);
  }

  // Fire at 8s on entry pages only
  if (isEntryPage && !isDismissed()) {
    setTimeout(showPopup, 8000);
  }

  document.addEventListener('DOMContentLoaded', function() {
    var closeBtn = document.getElementById('tr-popup-close');
    var form     = document.getElementById('tr-popup-form');
    var submit   = document.getElementById('tr-popup-submit');
    var success  = document.getElementById('tr-popup-success');

    if (closeBtn) closeBtn.addEventListener('click', dismiss);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') dismiss();
    });

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = (document.getElementById('tr-popup-email').value || '').trim();
        if (!email) return;

        submit.disabled = true;
        submit.textContent = 'Sending...';

        fetch('/api/lead-capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, full_name: '', source: 'popup-foundation' }),
        })
        .then(function(r) { return r.json(); })
        .then(function() {
          if (window.trackEvent) window.trackEvent('generate_lead', { lead_source: 'popup-foundation', currency: 'USD', value: 0 });
          dismiss();
          if (form) form.classList.add('hidden');
          if (success) success.classList.remove('hidden');
          var a = document.createElement('a');
          a.href = '/pdfs/footwork-foundation.pdf';
          a.download = '30-Day-Footwork-Foundation-Thee-Rainers.pdf';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(dismiss, 3000);
        })
        .catch(function() {
          submit.disabled = false;
          submit.textContent = 'Get the Free Protocol →';
        });
      });
    }
  });
})();
</script>
