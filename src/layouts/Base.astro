---
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Thee Rainers',
  description = 'Systemic boxing performance. Seven levers. Autonomic regulation. Built for fighters who think in structures, not sessions.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://theerainers.com');

const siteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://theerainers.com/#organization",
      "name": "Thee Rainers",
      "url": "https://theerainers.com",
      "logo": "https://theerainers.com/images/logo-trb.png",
      "sameAs": ["https://www.youtube.com/@Rainers"],
      "description": "Systemic boxing performance methodology. The Rainers Blueprint is a vertically integrated operating system built on the 7 Holy Virtues, 7 Performance Levers, and the Word of God."
    },
    {
      "@type": "Person",
      "@id": "https://theerainers.com/#founder",
      "name": "Rainers",
      "url": "https://theerainers.com/about",
      "jobTitle": "Boxing Performance Architect",
      "worksFor": { "@id": "https://theerainers.com/#organization" },
      "knowsAbout": [
        "Systemic Boxing Performance",
        "Kinetic Chain Integrity",
        "Autonomic Regulation",
        "Perceptual Training",
        "Neural Boxing",
        "Footwork Methodology"
      ]
    }
  ]
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5LQ7HPXG');</script>
    <!-- End Google Tag Manager -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/images/logo-trb.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/images/logo-trb.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Thee Rainers" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://theerainers.com/images/rainers-training.jpg" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@theerainers" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content="https://theerainers.com/images/rainers-training.jpg" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={siteSchema} />
    <!-- Cloudflare Web Analytics -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "6c995d4bc9a446c3b92eba609ef3ba69"}'></script>
    <!-- Funnel event helper — single source of truth for dataLayer pushes -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.trackEvent = function(name, data) {
        try { window.dataLayer.push(Object.assign({ event: name }, data || {})); } catch (e) {}
      };

      // Product registry — Stripe Payment Link IDs (live defense workshop only)
      // and Checkout Session lookup keys mapped to GA4-shaped ecommerce items.
      // Keep in sync with shop.astro products array and create-checkout.ts.
      var TR_PRODUCTS = {
        // Defense Workshop (live) still uses a Stripe Payment Link.
        '7sY28r8lt1D06XU6446J20n': { id: 'defense_workshop',        name: 'Defense Workshop',        price: 197 },
        // Lookup keys for data-checkout buttons (Checkout Session migration).
        'shadowboxing':            { id: 'shadowboxing_blueprint',  name: 'Shadowboxing Blueprint',  price:  47 },
        'workshop_replay':         { id: 'workshop_replay',         name: 'Workshop Replay',         price:  79 },
        'greatness_monthly':       { id: 'greatness_monthly',       name: 'Greatness Community — Monthly', price: 39 },
        'greatness_annual':        { id: 'greatness_annual',        name: 'Greatness Community — Annual',  price: 390 }
      };

      // Delegated click — fires begin_checkout for ANY buy button site-wide.
      // Covers <a href="buy.stripe.com/..."> AND <button data-checkout="...">.
      document.addEventListener('click', function(e) {
        var t = e.target && e.target.closest && e.target.closest('a[href*="buy.stripe.com"], button[data-checkout]');
        if (!t) return;
        var product = null;
        if (t.tagName === 'A') {
          var m = (t.getAttribute('href') || '').match(/buy\.stripe\.com\/(\w+)/);
          if (m) product = TR_PRODUCTS[m[1]];
        } else {
          product = TR_PRODUCTS[t.getAttribute('data-checkout') || ''];
        }
        if (!product) return;
        window.trackEvent('begin_checkout', {
          ecommerce: {
            currency: 'USD',
            value: product.price,
            items: [{ item_id: product.id, item_name: product.name, price: product.price, quantity: 1 }]
          }
        });
      });

      // ── Site-wide Checkout Session handler ────────────────────────────────
      // Any <button data-checkout="LOOKUP_KEY"> on any page calls
      // /api/create-checkout and redirects to the Stripe Checkout URL.
      // Idempotent — safe on view transitions / re-init.
      function initCheckoutButtons() {
        document.querySelectorAll('button[data-checkout]').forEach(function (btn) {
          if (btn.dataset.checkoutBound === 'true') return;
          btn.dataset.checkoutBound = 'true';
          btn.addEventListener('click', async function () {
            var key = btn.dataset.checkout;
            if (!key) return;
            // Yield before any synchronous DOM work — keeps INP low
            await new Promise(function(r) { setTimeout(r, 0); });
            var originalHTML = btn.innerHTML;
            // Find a sibling [data-checkout-error] for inline error display.
            var scope = btn.parentElement;
            var errorEl = null;
            while (scope && !errorEl) {
              errorEl = scope.querySelector('[data-checkout-error]');
              scope = scope.parentElement;
            }
            if (errorEl) errorEl.classList.add('hidden');
            btn.disabled = true;
            btn.innerHTML = '<svg class="animate-spin h-4 w-4 mr-2 inline" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg> Processing...';
            btn.classList.add('opacity-80', 'cursor-not-allowed');
            var restore = function () {
              btn.disabled = false;
              btn.innerHTML = originalHTML;
              btn.classList.remove('opacity-80', 'cursor-not-allowed');
            };
            try {
              var res = await fetch('/api/create-checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ lookupKey: key }),
              });
              var data = await res.json();
              if (data && data.url) {
                window.location.href = data.url;
                return;
              }
              var errMsg = (data && data.error) ? data.error : 'Checkout unavailable';
              console.error('[checkout] API error:', errMsg);
              restore();
              if (errorEl) {
                errorEl.classList.remove('hidden');
              } else {
                btn.insertAdjacentHTML('afterend', '<p class="tr-checkout-err text-[var(--red)] text-xs font-bold tracking-wide mt-2">Checkout temporarily unavailable — email rainers@theerainers.com</p>');
              }
            } catch (err) {
              console.error('[checkout] fetch error:', err);
              restore();
              if (errorEl) {
                errorEl.classList.remove('hidden');
              } else {
                btn.insertAdjacentHTML('afterend', '<p class="tr-checkout-err text-[var(--red)] text-xs font-bold tracking-wide mt-2">Checkout temporarily unavailable — email rainers@theerainers.com</p>');
              }
            }
          });
        });
      }
      // Defer binding to idle time — prevents checkout init from blocking INP
      function scheduleCheckoutInit() {
        if (typeof requestIdleCallback !== 'undefined') {
          requestIdleCallback(initCheckoutButtons, { timeout: 2000 });
        } else {
          setTimeout(initCheckoutButtons, 0);
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', scheduleCheckoutInit);
      } else {
        scheduleCheckoutInit();
      }
      document.addEventListener('astro:page-load', scheduleCheckoutInit);
    </script>
    <slot name="head" />
  </head>
  <body class="bg-white text-[#0A0A0A] min-h-screen flex flex-col overflow-x-hidden">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5LQ7HPXG" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Email capture — entry pages only. Centered, Apple-restraint, single product. -->
    <div id="tr-popup" role="dialog" aria-modal="true" aria-labelledby="tr-popup-heading"
      class="fixed inset-0 z-[200] flex items-center justify-center p-5 hidden pointer-events-none tr-popup-overlay"
      style="background: rgba(10,10,10,0.62); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);">
      <div class="bg-white w-full max-w-[420px] relative pointer-events-auto tr-popup-card"
        style="box-shadow: 0 30px 80px rgba(0,0,0,0.35);">

        <button id="tr-popup-close"
          aria-label="Close"
          class="absolute top-3 right-3 text-[#0A0A0A]/30 hover:text-[#0A0A0A] transition-colors text-2xl leading-none cursor-pointer bg-transparent border-0 p-2">
          &times;
        </button>

        <div class="p-6 pb-5">
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-2">Free · The Footwork Blueprint</p>
          <h2 id="tr-popup-heading" class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.88] mb-2"
            style="font-size: clamp(1.4rem, 4vw, 1.75rem);">
            Start with the base.
          </h2>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed mb-5">
            21 pages. 56 drills. Full video breakdown. Free.
          </p>

          <form id="tr-popup-form" class="flex flex-col gap-2.5">
            <label for="tr-popup-name" class="sr-only">Your name</label>
            <input
              type="text"
              id="tr-popup-name"
              name="name"
              placeholder="Your name"
              autocomplete="name"
              required
              class="w-full border border-[#0A0A0A]/15 bg-[#F7F6F4] px-4 py-3 text-sm text-[#0A0A0A] placeholder:text-[#0A0A0A]/30 focus:outline-none focus:border-[var(--blue)] focus:bg-white transition-colors duration-200"
            />
            <label for="tr-popup-email" class="sr-only">Email address</label>
            <input
              type="email"
              id="tr-popup-email"
              name="email"
              placeholder="your@email.com"
              autocomplete="email"
              required
              class="w-full border border-[#0A0A0A]/15 bg-[#F7F6F4] px-4 py-3 text-sm text-[#0A0A0A] placeholder:text-[#0A0A0A]/30 focus:outline-none focus:border-[var(--blue)] focus:bg-white transition-colors duration-200"
            />
            <button type="submit" id="tr-popup-submit"
              class="w-full inline-flex items-center justify-center rounded-none font-bold text-white bg-[var(--blue)] px-6 py-3.5 text-sm tracking-wide uppercase transition-colors duration-150 hover:bg-[#0A0A0A] disabled:opacity-50 cursor-pointer border-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--blue)] focus-visible:ring-offset-2">
              Get the Blueprint · Free →
            </button>
          </form>

          <div id="tr-popup-success" class="hidden text-center py-4">
            <p class="font-black text-[#0A0A0A] text-base uppercase tracking-tight mb-1">It's downloading.</p>
            <p class="text-[#0A0A0A]/50 text-sm">Save the PDF when prompted. Day 1 starts when you decide.</p>
          </div>

          <p class="text-[#0A0A0A]/30 text-[10px] mt-3 text-center tracking-wide">No payment. No spam. Unsubscribe any time.</p>
        </div>
      </div>
    </div>

  </body>
</html>

<script is:inline>
(function() {
  var STORAGE_KEY = 'tr_popup_v2';

  // Only fire on organic entry pages — never interrupt purchase flow
  // /foundation is itself a capture page — don't double-prompt.
  var ENTRY_PAGES = ['/', '/lever-audit-quiz'];
  var path = window.location.pathname.replace(/\/$/, '') || '/';
  var isEntryPage = ENTRY_PAGES.indexOf(path) !== -1;

  function isDismissed() {
    try { return !!localStorage.getItem(STORAGE_KEY); } catch(e) { return false; }
  }

  // Any dismiss is permanent
  function dismiss() {
    try { localStorage.setItem(STORAGE_KEY, '1'); } catch(e) {}
    var popup = document.getElementById('tr-popup');
    if (popup) popup.classList.add('hidden');
  }

  function showPopup() {
    if (isDismissed()) return;
    var popup = document.getElementById('tr-popup');
    if (!popup) return;
    popup.classList.remove('hidden');
    var emailInput = document.getElementById('tr-popup-email');
    if (emailInput) setTimeout(function() { emailInput.focus(); }, 50);
  }

  // Fire on entry pages only — whichever happens first: 15s OR user scrolls past 40% of page.
  // Apple-restraint: don't interrupt people who just landed.
  if (isEntryPage && !isDismissed()) {
    var fired = false;
    var fire = function() {
      if (fired) return;
      fired = true;
      window.removeEventListener('scroll', onScroll);
      showPopup();
    };
    var onScroll = function() {
      var max = (document.documentElement.scrollHeight - window.innerHeight) || 1;
      if ((window.scrollY / max) > 0.65) fire();
    };
    setTimeout(fire, 15000);
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Idempotent init — runs sync on first load AND on every astro:page-load
  // event (forward-compatible with ClientRouter). Guard prevents double-bind.
  function initPopup() {
    var closeBtn = document.getElementById('tr-popup-close');
    var form     = document.getElementById('tr-popup-form');
    var submit   = document.getElementById('tr-popup-submit');
    var success  = document.getElementById('tr-popup-success');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    if (closeBtn) closeBtn.addEventListener('click', dismiss);
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') dismiss();
    });

    // PDF-first wiring. The user always gets the file even if the lead-capture
    // backend fails. Trigger download → show success → fire webhook in background.
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var name  = (document.getElementById('tr-popup-name').value  || '').trim();
      var email = (document.getElementById('tr-popup-email').value || '').trim();
      if (!email || !name) return;
      submit.disabled = true;
      submit.textContent = 'Preparing...';

      // 1. PDF download first — contract with the user.
      var a = document.createElement('a');
      a.href = '/pdfs/foundation.pdf';
      a.download = 'The-Footwork-Blueprint-Thee-Rainers.pdf';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);

      // 2. Show success state immediately.
      if (form) form.classList.add('hidden');
      if (success) success.classList.remove('hidden');
      if (window.trackEvent) window.trackEvent('generate_lead', { lead_source: 'popup-footwork-blueprint', currency: 'USD', value: 0 });

      // 3. Fire Make.com in background (non-blocking).
      fetch('/api/lead-capture', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, full_name: name, source: 'popup-footwork-blueprint' }),
      }).catch(function(err) { console.warn('[popup] background webhook failed:', err); });

      setTimeout(dismiss, 3200);
    });
  }

  initPopup();
  document.addEventListener('astro:page-load', initPopup);
})();
</script>
