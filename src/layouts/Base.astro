---
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import CookieConsent from '../components/site/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hideFooterHelp?: boolean;
}

const {
  title = 'Thee Rainers',
  description = 'Boxing built on purpose. Free footwork blueprint, live defense workshops, and 1-on-1 coaching from Rainers.',
  hideFooterHelp = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://theerainers.com');

const siteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://theerainers.com/#organization",
      "name": "Thee Rainers",
      "url": "https://theerainers.com",
      "logo": "https://theerainers.com/images/logo-trb.png",
      "sameAs": ["https://www.youtube.com/@Rainers"],
      "description": "Systemic boxing performance methodology. The Rainers Blueprint is a vertically integrated operating system built on the 7 Holy Virtues, 7 Performance Levers, and the Word of God."
    },
    {
      "@type": "Person",
      "@id": "https://theerainers.com/#founder",
      "name": "Rainers",
      "url": "https://theerainers.com/about",
      "jobTitle": "Boxing Performance Architect",
      "worksFor": { "@id": "https://theerainers.com/#organization" },
      "knowsAbout": [
        "Systemic Boxing Performance",
        "Kinetic Chain Integrity",
        "Autonomic Regulation",
        "Perceptual Training",
        "Neural Boxing",
        "Footwork Methodology"
      ]
    }
  ]
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Google Consent Mode v2 defaults — must load before GTM -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });
      // Restore prior 'granted' choice synchronously so GTM sees it on first load.
      try {
        if (localStorage.getItem('trb_consent_v1') === 'granted') {
          gtag('consent', 'update', {
            analytics_storage: 'granted',
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
          });
        }
      } catch (_) {}
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>
    if (new URLSearchParams(window.location.search).get('smoke') !== '1') {
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-5LQ7HPXG');
    }
    </script>
    <!-- End Google Tag Manager -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/images/logo-trb-opt.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/images/logo-trb-opt.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Thee Rainers" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://theerainers.com/images/og-card.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@theerainers" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://theerainers.com/images/og-card.jpg" />
    <meta name="twitter:image:alt" content="Rainers competing in the ring" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={siteSchema} />
    <!-- Cloudflare Web Analytics -->
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "6c995d4bc9a446c3b92eba609ef3ba69"}'></script>
    <!-- Funnel event helper — single source of truth for dataLayer pushes -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.trackEvent = function(name, data) {
        if (new URLSearchParams(window.location.search).get('smoke') === '1') return;
        try { window.dataLayer.push(Object.assign({ event: name }, data || {})); } catch (e) {}
      };

      // Product registry — Stripe Payment Link IDs (live defense workshop only)
      // and Checkout Session lookup keys mapped to GA4-shaped ecommerce items.
      // Keep in sync with shop.astro products array and create-checkout.ts.
      var TR_PRODUCTS = {
        // Checkout Session lookup keys — keep in sync with create-checkout.ts PRODUCTS map.
        'footwork':                    { id: 'footwork_blueprint',      name: 'Footwork Blueprint',          price:   9 },
        'shadowboxing':                { id: 'shadowboxing_blueprint',  name: 'Shadowboxing Blueprint',      price:  19 },
        'bundle':                      { id: 'complete_bundle',         name: 'Complete Bundle',             price:  24 },
        'defense_workshop_early':      { id: 'defense_workshop',        name: 'Defense Workshop (Early)',    price:  39 },
        'defense_workshop_standard':   { id: 'defense_workshop',        name: 'Defense Workshop',           price:  49 },
        'workshop_replay':             { id: 'workshop_replay',         name: 'Workshop Replay',             price:  49 },
        'greatness_monthly':           { id: 'greatness_monthly',       name: 'The Weekly Session Monthly', price:  39 },
        'greatness_annual':            { id: 'greatness_annual',        name: 'The Weekly Session Annual',  price: 390 }
      };

      // Delegated click — fires begin_checkout for ANY buy button site-wide.
      // Covers <a href="buy.stripe.com/..."> AND <button data-checkout="...">.
      var TR_SID = (function() { try { var s = sessionStorage.getItem('_tr_sid') || ''; if (!s) { s = Math.random().toString(36).slice(2,10); sessionStorage.setItem('_tr_sid', s); } return s; } catch(e2) { return ''; } })();

      document.addEventListener('click', function(e) {
        var t = e.target && e.target.closest && e.target.closest('a[href*="buy.stripe.com"], button[data-checkout]');
        if (!t) return;
        var product = null;
        if (t.tagName === 'A') {
          var m = (t.getAttribute('href') || '').match(/buy\.stripe\.com\/(\w+)/);
          if (m) product = TR_PRODUCTS[m[1]];
        } else {
          product = TR_PRODUCTS[t.getAttribute('data-checkout') || ''];
        }
        if (!product) return;
        try { navigator.sendBeacon('/api/track', JSON.stringify({event:'checkout_click',page:location.pathname,detail:product.id,session:TR_SID})); window.trackEvent('checkout_click',{detail:product.id}); } catch(e2){}
        window.trackEvent('begin_checkout', {
          ecommerce: {
            currency: 'USD',
            value: product.price,
            items: [{ item_id: product.id, item_name: product.name, price: product.price, quantity: 1 }]
          }
        });
      });

      // ── Site-wide Checkout Session handler ────────────────────────────────
      // Any <button data-checkout="LOOKUP_KEY"> on any page calls
      // /api/create-checkout and redirects to the Stripe Checkout URL.
      // Idempotent — safe on view transitions / re-init.
      function initCheckoutButtons() {
        document.querySelectorAll('button[data-checkout]').forEach(function (btn) {
          if (btn.dataset.checkoutBound === 'true') return;
          btn.dataset.checkoutBound = 'true';
          btn.addEventListener('click', async function () {
            var key = btn.dataset.checkout;
            if (!key) return;
            // Yield before any synchronous DOM work — keeps INP low
            await new Promise(function(r) { setTimeout(r, 0); });
            var originalHTML = btn.innerHTML;
            // Find a sibling [data-checkout-error] for inline error display.
            var scope = btn.parentElement;
            var errorEl = null;
            while (scope && !errorEl) {
              errorEl = scope.querySelector('[data-checkout-error]');
              scope = scope.parentElement;
            }
            if (errorEl) errorEl.classList.add('hidden');
            btn.disabled = true;
            btn.innerHTML = '<svg class="animate-spin h-4 w-4 mr-2 inline" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg> Processing...';
            btn.classList.add('opacity-80', 'cursor-not-allowed');
            var restore = function () {
              btn.disabled = false;
              btn.innerHTML = originalHTML;
              btn.classList.remove('opacity-80', 'cursor-not-allowed');
            };
            try {
              var res = await fetch('/api/create-checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ lookupKey: key }),
              });
              var data = await res.json();
              if (data && data.url) {
                window.location.href = data.url;
                return;
              }
              var errMsg = (data && data.error) ? data.error : 'Checkout unavailable';
              console.error('[checkout] API error:', errMsg);
              restore();
              if (errorEl) {
                errorEl.classList.remove('hidden');
              } else {
                btn.insertAdjacentHTML('afterend', '<p class="tr-checkout-err text-[var(--red)] text-xs font-bold tracking-wide mt-2">Checkout temporarily unavailable. Email rainers@theerainers.com</p>');
              }
            } catch (err) {
              console.error('[checkout] fetch error:', err);
              restore();
              if (errorEl) {
                errorEl.classList.remove('hidden');
              } else {
                btn.insertAdjacentHTML('afterend', '<p class="tr-checkout-err text-[var(--red)] text-xs font-bold tracking-wide mt-2">Checkout temporarily unavailable. Email rainers@theerainers.com</p>');
              }
            }
          });
        });
      }
      // Defer binding to idle time — prevents checkout init from blocking INP
      function scheduleCheckoutInit() {
        if (typeof requestIdleCallback !== 'undefined') {
          requestIdleCallback(initCheckoutButtons, { timeout: 2000 });
        } else {
          setTimeout(initCheckoutButtons, 0);
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', scheduleCheckoutInit);
      } else {
        scheduleCheckoutInit();
      }
    </script>
    <slot name="head" />
  </head>
  <body class="bg-white text-[#0A0A0A] min-h-screen flex flex-col overflow-x-hidden">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5LQ7HPXG" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer hideHelp={hideFooterHelp} />

    <!-- Email capture — entry pages only. Centered, Apple-restraint, single product. -->
    <div id="tr-popup" role="dialog" aria-modal="true" aria-labelledby="tr-popup-heading"
      class="fixed inset-0 z-[200] flex items-center justify-center p-5 hidden pointer-events-none tr-popup-overlay"
      style="background: rgba(10,10,10,0.62); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);">
      <div class="bg-white w-full max-w-[420px] relative pointer-events-auto tr-popup-card"
        style="box-shadow: 0 30px 80px rgba(0,0,0,0.35);">

        <button id="tr-popup-close"
          aria-label="Close"
          class="absolute top-3 right-3 text-[#0A0A0A]/30 hover:text-[#0A0A0A] transition-colors text-2xl leading-none cursor-pointer bg-transparent border-0 p-2">
          &times;
        </button>

        <div class="p-6 pb-5">
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-2">$19 · The Footwork Blueprint</p>
          <h2 id="tr-popup-heading" class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.88] mb-2"
            style="font-size: clamp(1.4rem, 4vw, 1.75rem);">
            Start with the base.
          </h2>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed mb-5">
            4 footwork bases, 56+ rounds of drills. Full video breakdown included.
          </p>

          <button type="button" data-checkout="footwork" id="tr-popup-submit"
            class="w-full inline-flex items-center justify-center rounded-none font-bold text-white bg-[var(--red)] px-6 py-3.5 text-sm tracking-wide uppercase transition-colors duration-150 hover:opacity-85 disabled:opacity-50 cursor-pointer border-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--red)] focus-visible:ring-offset-2">
            Get the Blueprint · $19 →
          </button>

          <p class="text-[#0A0A0A]/30 text-[10px] mt-3 text-center tracking-wide">One-time purchase. Instant PDF download.</p>
        </div>
      </div>
    </div>

  <img src="https://tracker.metricool.com/c3po.jpg?hash=788f135aa4dcbab8c0bd6195948f6bfd" width="0" height="0" style="position:absolute;overflow:hidden;" aria-hidden="true" />
  <CookieConsent />
  </body>
</html>

<script is:inline>
(function() {
  var STORAGE_KEY = 'tr_popup_v2';

  // Only fire on organic entry pages — never interrupt purchase flow
  // /foundation is itself a capture page — don't double-prompt.
  var ENTRY_PAGES = ['/'];
  var path = window.location.pathname.replace(/\/$/, '') || '/';
  var isEntryPage = ENTRY_PAGES.indexOf(path) !== -1;

  function isDismissed() {
    try { return !!localStorage.getItem(STORAGE_KEY); } catch(e) { return false; }
  }

  // Any dismiss is permanent
  function dismiss() {
    try { localStorage.setItem(STORAGE_KEY, '1'); } catch(e) {}
    var popup = document.getElementById('tr-popup');
    if (popup) popup.classList.add('hidden');
  }

  function showPopup() {
    if (isDismissed()) return;
    var popup = document.getElementById('tr-popup');
    if (!popup) return;
    popup.classList.remove('hidden');
    var submitBtn = document.getElementById('tr-popup-submit');
    if (submitBtn) setTimeout(function() { submitBtn.focus(); }, 50);
  }

  // Fire on entry pages only — whichever happens first: 15s OR user scrolls past 40% of page.
  // Apple-restraint: don't interrupt people who just landed.
  if (isEntryPage && !isDismissed()) {
    var fired = false;
    var fire = function() {
      if (fired) return;
      fired = true;
      window.removeEventListener('scroll', onScroll);
      showPopup();
    };
    var onScroll = function() {
      var max = (document.documentElement.scrollHeight - window.innerHeight) || 1;
      if ((window.scrollY / max) > 0.65) fire();
    };
    setTimeout(fire, 15000);
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Idempotent init — guard on popup.dataset.bound prevents double-bind.
  // Checkout itself is handled by the site-wide data-checkout handler below.
  function initPopup() {
    var popup    = document.getElementById('tr-popup');
    var closeBtn = document.getElementById('tr-popup-close');
    if (!popup || popup.dataset.bound === 'true') return;
    popup.dataset.bound = 'true';

    if (closeBtn) closeBtn.addEventListener('click', dismiss);
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') dismiss();
    });
  }

  initPopup();
})();
</script>
