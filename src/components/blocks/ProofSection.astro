---
// ProofSection — text testimonial wall. Reads from src/data/testimonials.json.
// Renders nothing when the array is empty. Add entries to that file to populate.
//
// JSON entry shape:
// {
//   "id": "unique-slug",
//   "name": "First name or handle",
//   "persona": "Boxer · 3 years training",   // optional, shown as subtext
//   "quote": "Exact words from the student.", // must be verbatim — never paraphrase
//   "tag": "blueprint" | "community" | "coaching" | null
// }
//
// How to add a testimonial:
// 1. Get written permission from the student.
// 2. Copy their exact words — no edits, no em dashes, no cleanup.
// 3. Add the entry to src/data/testimonials.json.
// 4. Deploy. The section appears automatically once the array is non-empty.

import testimonials from '../../data/testimonials.json';

const TAG_LABELS: Record<string, string> = {
  blueprint: 'Blueprint',
  community: 'Community',
  coaching: '1-on-1',
};

const TAG_COLORS: Record<string, string> = {
  blueprint: 'var(--blue)',
  community: 'var(--purple)',
  coaching: 'rgba(255,255,255,0.30)',
};
---

{testimonials.length > 0 && (
  <section class="bg-[#0A0A0A] border-t border-white/5">
    <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 py-16 md:py-24">

      <div class="mb-12">
        <p class="text-white/30 text-[11px] tracking-widest uppercase mb-4">In Their Words</p>
        <h2 class="font-black text-white uppercase tracking-tighter leading-[0.86]"
          style="font-size: clamp(2rem, 4vw, 3rem);">
          What they said.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-white/5">
        {testimonials.map((t: any) => (
          <figure class="bg-[#0A0A0A] p-8 md:p-10 flex flex-col">
            {t.tag && TAG_LABELS[t.tag] && (
              <p class="text-[10px] tracking-widest uppercase font-bold mb-6"
                style={`color: ${TAG_COLORS[t.tag] ?? 'rgba(255,255,255,0.3)'}`}>
                {TAG_LABELS[t.tag]}
              </p>
            )}
            <blockquote class="font-bold text-white text-lg leading-snug tracking-tight flex-1 mb-8">
              "{t.quote}"
            </blockquote>
            <figcaption class="flex items-center gap-3">
              <span class="h-px w-6 bg-white/20 shrink-0" />
              <span>
                {t.name && (
                  <span class="text-white text-[11px] font-bold tracking-widest uppercase">{t.name}</span>
                )}
                {t.name && t.persona && (
                  <span class="text-white/35 text-[11px] tracking-wide"> · {t.persona}</span>
                )}
                {!t.name && t.persona && (
                  <span class="text-white/35 text-[11px] tracking-wide">{t.persona}</span>
                )}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>

    </div>
  </section>
)}
