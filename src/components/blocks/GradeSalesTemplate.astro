---
// Shared section template for /coaching/grade-1, grade-2, grade-3. Individual
// page files supply grade-specific data; this component owns the structure
// and section order from the owner's doc so the three pages stay consistent.
//
// Color law: terra restricted to CTA fills only (same fix as /coaching).
import FourLayers from './FourLayers.astro';
import ProofSection from './ProofSection.astro';

interface Props {
  gradeNumber: 1 | 2 | 3;
  name: string;
  price: string;
  term: string;
  priceId: string;
  features: string[];
  seatsTaken?: number;
  seatsMax?: number;
}

const { gradeNumber, name, price, term, priceId, features, seatsTaken, seatsMax } = Astro.props;
const isGrade3 = gradeNumber === 3;
---

<!-- ── HERO ──────────────────────────────────────────────────────────── -->
<section class="relative bg-[#0B0B0C] overflow-hidden px-6 md:px-12 lg:px-20 py-28 md:py-36">
  <div class="max-w-[720px] mx-auto text-center">
    <p class="text-white/60 text-[11px] tracking-widest uppercase font-bold mb-6">{name}</p>
    <h1 class="font-black uppercase tracking-tighter text-white mb-6"
      style="font-size: clamp(3rem, 6vw, 4.5rem); line-height: 0.95;">
      <!-- COPY: headline -->
    </h1>
    <p class="text-white/50 text-base leading-relaxed mb-10 max-w-[520px] mx-auto">
      <!-- COPY: subhead, who it's for plus main outcome -->
    </p>
    <button type="button" data-checkout={priceId} class="tr-btn">
      <!-- COPY: hero CTA label -->
    </button>
    <p data-checkout-error class="hidden text-[var(--terra)] text-xs font-bold tracking-wide mt-3">
      Checkout unavailable. Email rainers@theerainers.com
    </p>
  </div>
</section>

<!-- ── PROBLEM / CURRENT STATE ──────────────────────────────────────── -->
<section class="bg-white px-6 md:px-12 lg:px-20 py-16 md:py-24">
  <div class="max-w-[720px] mx-auto text-left">
    <p class="text-[#0B0B0C]/60 text-[11px] tracking-widest uppercase font-bold mb-4">Where You Are Now</p>
    <!-- COPY: problem / current state -->
  </div>
</section>

<!-- ── TRANSFORMATION ────────────────────────────────────────────────── -->
<section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 py-16 md:py-24">
  <div class="max-w-[900px] mx-auto">
    <p class="text-[#0B0B0C]/60 text-[11px] tracking-widest uppercase font-bold mb-10 text-left">The Shift</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-[#0B0B0C]/8">
      <div class="bg-[var(--warm)] p-8 md:p-10 text-left">
        <p class="text-[#0B0B0C]/40 text-[10px] tracking-widest uppercase font-bold mb-4">Before</p>
        <!-- COPY: before -->
      </div>
      <div class="bg-[var(--warm)] p-8 md:p-10 text-left">
        <p class="text-[#0B0B0C]/40 text-[10px] tracking-widest uppercase font-bold mb-4">After</p>
        <!-- COPY: after -->
      </div>
    </div>
  </div>
</section>

<!-- ── WHAT'S INSIDE (feature bullets, verbatim from the approved card) ── -->
<section class="bg-white px-6 md:px-12 lg:px-20 py-16 md:py-24">
  <div class="max-w-[720px] mx-auto text-left">
    <p class="text-[#0B0B0C]/60 text-[11px] tracking-widest uppercase font-bold mb-8">What's Inside</p>
    <ul class="flex flex-col gap-4">
      {features.map(f => (
        <li class="text-[#0B0B0C]/70 text-sm leading-relaxed pl-5 relative before:content-['·'] before:absolute before:left-0 before:text-[#0B0B0C]/25">{f}</li>
      ))}
    </ul>
  </div>
</section>

<!-- ── THE FOUR LAYERS ──────────────────────────────────────────────── -->
<FourLayers />

<!-- ── HOW IT WORKS ──────────────────────────────────────────────────── -->
<section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 py-16 md:py-24">
  <div class="max-w-[1100px] mx-auto">
    <div class="text-center mb-16">
      <span class="block text-[11px] font-bold tracking-widest uppercase text-[#0B0B0C]/60 mb-4">How It Works</span>
      <h2 style="font-size: clamp(2rem, 4vw, 3rem);"><!-- COPY: section headline --></h2>
      <span class="block w-10 h-0.5 bg-[#0B0B0C]/8 mx-auto mt-5"></span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-[#0B0B0C]/8">
      <div class="bg-[var(--warm)] p-8 md:p-10 text-left">
        <p class="text-[#0B0B0C]/60 text-[10px] tracking-widest uppercase font-bold mb-5">01</p>
        <h3 class="font-black text-[#0B0B0C] uppercase tracking-tight text-base leading-tight mb-4"><!-- COPY: step 1 label --></h3>
        <p class="text-[#0B0B0C]/60 text-sm leading-relaxed"><!-- COPY: step 1 body --></p>
      </div>
      <div class="bg-[var(--warm)] p-8 md:p-10 text-left">
        <p class="text-[#0B0B0C]/60 text-[10px] tracking-widest uppercase font-bold mb-5">02</p>
        <h3 class="font-black text-[#0B0B0C] uppercase tracking-tight text-base leading-tight mb-4"><!-- COPY: step 2 label --></h3>
        <p class="text-[#0B0B0C]/60 text-sm leading-relaxed"><!-- COPY: step 2 body --></p>
      </div>
      <div class="bg-[var(--warm)] p-8 md:p-10 text-left">
        <p class="text-[#0B0B0C]/60 text-[10px] tracking-widest uppercase font-bold mb-5">03</p>
        <h3 class="font-black text-[#0B0B0C] uppercase tracking-tight text-base leading-tight mb-4"><!-- COPY: step 3 label --></h3>
        <p class="text-[#0B0B0C]/60 text-sm leading-relaxed"><!-- COPY: step 3 body --></p>
      </div>
    </div>
  </div>
</section>

<!-- ── SOCIAL PROOF (null on empty) ─────────────────────────────────── -->
<ProofSection />

{isGrade3 && (
  <!-- ── GRADE 3 ONLY: seats + in-person terms ─────────────────────── -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-14 border-t border-[#0B0B0C]/8">
    <div class="max-w-[720px] mx-auto text-left">
      <p class="text-[#0B0B0C]/60 text-[11px] tracking-widest uppercase font-bold mb-3">Availability</p>
      <p class="font-black text-[#0B0B0C] text-2xl tracking-tight mb-10">{seatsTaken ?? 0} of {seatsMax ?? 5} seats taken</p>
      <p class="text-[#0B0B0C]/60 text-[11px] tracking-widest uppercase font-bold mb-3">In-Person Terms</p>
      <p class="text-[#0B0B0C]/70 text-sm leading-relaxed"><!-- COPY: who travels, who pays, how it is scheduled --></p>
    </div>
  </section>
)}

<!-- ── PRICE + WHAT HAPPENS NEXT ────────────────────────────────────── -->
<section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 py-16 md:py-24 border-t border-[#0B0B0C]/8">
  <div class="max-w-[600px] mx-auto text-left">
    <div class="flex items-baseline gap-2 mb-8">
      <span class="font-medium text-[#0B0B0C]" style="font-size: 1.5rem;">{price}</span>
      <span class="text-[#0B0B0C]/60 text-sm">{term}</span>
    </div>
    <p class="text-[#0B0B0C]/60 text-[11px] tracking-widest uppercase font-bold mb-3">What Happens Next</p>
    <p class="text-[#0B0B0C]/70 text-sm leading-relaxed mb-10"><!-- COPY: what happens next --></p>
    <button type="button" data-checkout={priceId} class="tr-btn">
      <!-- COPY: price section CTA label -->
    </button>
    <p data-checkout-error class="hidden text-[var(--terra)] text-xs font-bold tracking-wide mt-3">
      Checkout unavailable. Email rainers@theerainers.com
    </p>
  </div>
</section>

<!-- ── FAQ (accordion, matches /coaching) ───────────────────────────── -->
<section class="bg-white px-6 md:px-12 lg:px-20 py-16 md:py-24">
  <div class="max-w-[720px] mx-auto">
    <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter text-2xl leading-tight mb-10 text-left">Common Questions</h2>
    <div class="flex flex-col divide-y divide-[#0B0B0C]/10 border-t border-b border-[#0B0B0C]/10">
      <details class="group py-5">
        <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-bold text-[#0B0B0C] text-sm">
          <!-- COPY: FAQ question 1 -->
          <span class="shrink-0 text-[#0B0B0C]/30 text-lg group-open:rotate-45 transition-transform duration-200">+</span>
        </summary>
        <p class="text-[#0B0B0C]/50 text-xs leading-relaxed mt-3"><!-- COPY: FAQ answer 1 --></p>
      </details>
      <details class="group py-5">
        <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-bold text-[#0B0B0C] text-sm">
          <!-- COPY: FAQ question 2 -->
          <span class="shrink-0 text-[#0B0B0C]/30 text-lg group-open:rotate-45 transition-transform duration-200">+</span>
        </summary>
        <p class="text-[#0B0B0C]/50 text-xs leading-relaxed mt-3"><!-- COPY: FAQ answer 2 --></p>
      </details>
      <details class="group py-5">
        <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-bold text-[#0B0B0C] text-sm">
          <!-- COPY: FAQ question 3 -->
          <span class="shrink-0 text-[#0B0B0C]/30 text-lg group-open:rotate-45 transition-transform duration-200">+</span>
        </summary>
        <p class="text-[#0B0B0C]/50 text-xs leading-relaxed mt-3"><!-- COPY: FAQ answer 3 --></p>
      </details>
      <details class="group py-5">
        <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-bold text-[#0B0B0C] text-sm">
          <!-- COPY: FAQ question 4 -->
          <span class="shrink-0 text-[#0B0B0C]/30 text-lg group-open:rotate-45 transition-transform duration-200">+</span>
        </summary>
        <p class="text-[#0B0B0C]/50 text-xs leading-relaxed mt-3"><!-- COPY: FAQ answer 4 --></p>
      </details>
      <details class="group py-5">
        <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-bold text-[#0B0B0C] text-sm">
          <!-- COPY: FAQ question 5 -->
          <span class="shrink-0 text-[#0B0B0C]/30 text-lg group-open:rotate-45 transition-transform duration-200">+</span>
        </summary>
        <p class="text-[#0B0B0C]/50 text-xs leading-relaxed mt-3"><!-- COPY: FAQ answer 5 --></p>
      </details>
    </div>
  </div>
</section>

<!-- ── FINAL CTA ─────────────────────────────────────────────────────── -->
<section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 py-20 md:py-28 text-center">
  <div class="max-w-[600px] mx-auto">
    <h2 class="font-black uppercase tracking-tighter text-white mb-8"
      style="font-size: clamp(2rem, 4vw, 3rem); line-height: 0.95;">
      <!-- COPY: headline -->
    </h2>
    <button type="button" data-checkout={priceId} class="tr-btn">
      <!-- COPY: final CTA label -->
    </button>
    <p data-checkout-error class="hidden text-[var(--terra)] text-xs font-bold tracking-wide mt-3">
      Checkout unavailable. Email rainers@theerainers.com
    </p>
  </div>
</section>
