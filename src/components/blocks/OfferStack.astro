---
// OfferStack — three photo cards with overlay titles, Myron card rhythm, TRB terracotta.
// Defense Workshop is live Nov 29, 2026 -- the strip below renders both a
// "before" and "after" version server-side, and a client script (same
// src/data/defense-workshop.ts end-time check as defense-workshop.astro)
// shows the right one and hides the other. Done client-side so this never
// goes stale between deploys.
import { WORKSHOP_DATE_LABEL } from '../../data/defense-workshop.ts';

// Task 8.4: the ladder, cheapest first. Free guide, then $30 bundle, then
// the Defense Workshop strip (rendered between the two card rows below --
// its own before/after toggle is unchanged from task 1/2), then the $79
// Masterclass. Grades ($347/$997/$12,000) render separately in
// GradePricing.astro, directly below this section on the homepage.
const cards = [
  {
    image: '/images/rainers-coaching-opt.jpg',
    imageWebp: '/images/rainers-coaching-opt.webp',
    imageAlt: 'Padwork training',
    kicker: 'Free',
    title: 'Start free.',
    href: '/first-training',
    cta: 'Get the Free Guide',
  },
  {
    image: '/images/footwork-cover-opt.jpg',
    imageWebp: '/images/footwork-cover-opt.webp',
    imageAlt: 'The Footwork Blueprint',
    kicker: '$30 · Bundle',
    title: 'The Blueprints.',
    href: '/shop',
    cta: 'Get the Blueprints',
  },
];

const masterclassCard = {
  image: '/images/course-vsl-thumb.jpg',
  imageAlt: 'The Masterclass',
  kicker: '$79 · Masterclass',
  title: 'The Masterclass.',
  href: '/masterclass',
  cta: 'Get the Masterclass',
};
---

<section class="bg-[var(--warm)] py-20 md:py-28" id="programs">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20">

    <div class="tr-section-head mb-16">
      <span class="kicker">The Ladder</span>
      <h2 style="font-size: clamp(2.4rem, 4.8vw, 3.6rem);">
        <!-- DRAFT: voice pass Rainers -->
        Choose where to start.
      </h2>
      <span class="divider"></span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {cards.map(card => (
        <div class="flex flex-col">
          <!-- Image with overlay -->
          <div class="relative overflow-hidden group" style="aspect-ratio: 3/4;">
            <picture>
              {card.imageWebp && <source srcset={card.imageWebp} type="image/webp" />}
              <img
                src={card.image}
                alt={card.imageAlt}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover object-center grayscale transition-transform duration-700 group-hover:scale-[1.04]"
              />
            </picture>
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(11,11,12,0.85) 0%, rgba(11,11,12,0.25) 55%, transparent 100%);"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
              <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-2">{card.kicker}</p>
              <h3 class="font-black text-white uppercase tracking-tighter leading-tight mb-3" style="font-size: clamp(1.8rem, 3vw, 2.4rem);">
                <!-- DRAFT: voice pass Rainers -->
                {card.title}
              </h3>
              <div class="h-px w-10 bg-[var(--terra)]"></div>
            </div>
          </div>
          <!-- Button below card -->
          <div class="bg-[var(--warm)] border border-[#0B0B0C]/8 px-8 py-6">
            <a href={card.href} class="tr-btn" style="width:100%;justify-content:center;">
              <!-- DRAFT: voice pass Rainers -->
              {card.cta}
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Event strip — Defense Workshop, before the event: ticket purchase -->
    <div id="workshop-strip-before" class="mt-6 bg-[var(--warm)] border border-[#0B0B0C]/8 px-8 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="inline-block w-2 h-2 rounded-full bg-[var(--terra)] shrink-0 animate-pulse" aria-hidden="true"></span>
        <p class="text-[#0B0B0C]/60 text-[11px] font-bold tracking-widest uppercase">Defense Workshop &middot; {WORKSHOP_DATE_LABEL}</p>
      </div>
      <a href="/defense-workshop#tickets"
        class="text-[var(--terra)] text-[11px] font-bold tracking-widest uppercase hover:opacity-70 transition-opacity shrink-0">
        Get Your Seat →
      </a>
    </div>

    <!-- Event strip — Defense Workshop, after the event: replay fallback -->
    <div id="workshop-strip-after" class="hidden mt-6 bg-[var(--warm)] border border-[#0B0B0C]/8 px-8 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="inline-block w-2 h-2 rounded-full bg-[var(--terra)] shrink-0" aria-hidden="true"></span>
        <p class="text-[#0B0B0C]/60 text-[11px] font-bold tracking-widest uppercase">Defense Workshop &middot; Replay available</p>
      </div>
      <a href="/workshop-replay"
        class="text-[var(--terra)] text-[11px] font-bold tracking-widest uppercase hover:opacity-70 transition-opacity shrink-0">
        Watch the Replay →
      </a>
    </div>

    <!-- Masterclass, $79 -- last rung before Grades (GradePricing, next section) -->
    <div class="mt-6 max-w-[520px] mx-auto md:mx-0">
      <div class="flex flex-col sm:flex-row">
        <div class="relative overflow-hidden group shrink-0" style="width: 160px; aspect-ratio: 3/4;">
          <img
            src={masterclassCard.image}
            alt={masterclassCard.imageAlt}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover object-center grayscale transition-transform duration-700 group-hover:scale-[1.04]"
          />
        </div>
        <div class="bg-[var(--warm)] border border-[#0B0B0C]/8 sm:border-l-0 px-6 py-6 flex-1 flex flex-col justify-center">
          <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-2">{masterclassCard.kicker}</p>
          <h3 class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-tight mb-4" style="font-size: clamp(1.25rem, 2vw, 1.5rem);">
            {masterclassCard.title}
          </h3>
          <a href={masterclassCard.href} class="tr-btn" style="width:100%;justify-content:center;">
            {masterclassCard.cta}
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  import { WORKSHOP_END_MS } from '../../data/defense-workshop.ts';

  function toggleWorkshopStrip(): void {
    const before = document.getElementById('workshop-strip-before');
    const after = document.getElementById('workshop-strip-after');
    if (!before || !after) return;
    if (Date.now() > WORKSHOP_END_MS) {
      before.classList.add('hidden');
      after.classList.remove('hidden');
    }
  }

  toggleWorkshopStrip();
</script>
