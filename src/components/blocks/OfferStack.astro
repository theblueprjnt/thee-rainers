---
// OfferStack — three photo cards with overlay titles, Myron card rhythm, TRB terracotta.
// Event strip beneath driven by workshopState() — no manual prop needed.
import { workshopState, WORKSHOP_DATE_SHORT } from '../../data/workshop.ts';

const wState = workshopState();
const showStrip = wState !== 'between';
// /defense-workshop is unconditionally on sale (early-bird or standard price,
// never a real waitlist), so the strip always reads as a live seat.
const stripLabel = `Defense Workshop · Saturday ${WORKSHOP_DATE_SHORT} · Reserve your seat`;

const cards = [
  {
    image: '/images/footwork-cover-opt.jpg',
    imageWebp: '/images/footwork-cover-opt.webp',
    imageAlt: 'The Footwork Blueprint',
    kicker: 'Blueprints',
    title: 'The Blueprints.',
    href: '/shop',
    cta: 'Get the Blueprints',
  },
  {
    image: '/images/sparring_withnetherlands.jpg',
    imageAlt: 'Live training session',
    kicker: 'The Weekly Session',
    title: 'Weekly correction, live.',
    href: '/community',
    cta: 'Claim your spot',
  },
  {
    image: '/images/rainers-coaching-opt.jpg',
    imageWebp: '/images/rainers-coaching-opt.webp',
    imageAlt: 'One-on-one coaching session',
    kicker: '1-ON-1 Coaching',
    title: 'Built around one fighter.',
    href: '/command',
    cta: 'Apply to see if you qualify',
  },
];
---

<section class="bg-[var(--warm)] py-20 md:py-28" id="programs">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20">

    <div class="tr-section-head mb-16">
      <span class="kicker">The Work</span>
      <h2 style="font-size: clamp(2rem, 4vw, 3rem);">
        <!-- DRAFT: voice pass Rainers -->
        Choose where to start.
      </h2>
      <span class="divider"></span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {cards.map(card => (
        <div class="flex flex-col">
          <!-- Image with overlay -->
          <div class="relative overflow-hidden group" style="aspect-ratio: 3/4;">
            <picture>
              {card.imageWebp && <source srcset={card.imageWebp} type="image/webp" />}
              <img
                src={card.image}
                alt={card.imageAlt}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 w-full h-full object-cover object-center grayscale transition-transform duration-700 group-hover:scale-[1.04]"
              />
            </picture>
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(11,11,12,0.85) 0%, rgba(11,11,12,0.25) 55%, transparent 100%);"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
              <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-2">{card.kicker}</p>
              <h3 class="font-black text-white uppercase tracking-tighter leading-tight mb-3" style="font-size: clamp(1.5rem, 2.5vw, 2rem);">
                <!-- DRAFT: voice pass Rainers -->
                {card.title}
              </h3>
              <div class="h-px w-10 bg-[var(--terra)]"></div>
            </div>
          </div>
          <!-- Button below card -->
          <div class="bg-[#0B0B0C] px-8 py-6">
            <a href={card.href} class="tr-btn" style="width:100%;justify-content:center;">
              <!-- DRAFT: voice pass Rainers -->
              {card.cta}
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Event strip — shows when selling or waitlist, hidden when between -->
    {showStrip && (
      <div class="mt-6 bg-[#0B0B0C] px-8 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="inline-block w-2 h-2 rounded-full bg-[var(--terra)] shrink-0 animate-pulse" aria-hidden="true"></span>
          <p class="text-white/60 text-[11px] font-bold tracking-widest uppercase">{stripLabel}</p>
        </div>
        <a href="/defense-workshop"
          class="text-[var(--terra)] text-[11px] font-bold tracking-widest uppercase hover:opacity-70 transition-opacity shrink-0">
          Go to Workshop →
        </a>
      </div>
    )}

  </div>
</section>
