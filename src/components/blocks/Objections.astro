---
// Old way / our way comparison. Recreated from a reference the owner sent
// (a flowchart-style "old way vs new way" comparison), adapted to TRB's
// existing visual language instead of copying the reference's layout
// directly: the numbered-step pattern here is the same one already used in
// FourLayers.astro and the coaching pages' "How It Works" sections, not a
// new pattern. Old-way pain points are the ones the owner confirmed.
const OLD_WAY = [
  'Random YouTube tutorials',
  'Gym drills, no real feedback',
  'Training alone, no correction',
  'Plateaued and stuck',
];

const NEW_WAY = [
  { n: '01', label: 'Send your footage' },
  { n: '02', label: 'Get your diagnosis' },
  { n: '03', label: 'Fix one thing' },
  { n: '04', label: 'Train with structure' },
];
---

<section class="bg-white px-6 md:px-12 lg:px-20 py-20 md:py-28">
  <div class="max-w-[1100px] mx-auto">
    <div class="text-center mb-16">
      <span class="block text-[11px] font-bold tracking-widest uppercase text-[#0B0B0C]/60 mb-4">Before You Start</span>
      <h2 class="font-black uppercase tracking-tighter text-[#0B0B0C] mb-5" style="font-size: clamp(2rem, 4vw, 3rem); line-height: 0.95;">
        Correction beats more content.
      </h2>
      <p class="text-[#0B0B0C]/60 text-base leading-relaxed max-w-[560px] mx-auto">
        Every fix starts with your footage. We find the mistake you keep repeating, correct it, and build the next skill on top of it.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
      <div>
        <p class="text-[#0B0B0C]/40 text-[11px] tracking-widest uppercase font-bold mb-6">Training on your own</p>
        <ul class="flex flex-col gap-3">
          {OLD_WAY.map(item => (
            <li class="border border-[#0B0B0C]/10 px-5 py-4 text-[#0B0B0C]/60 text-sm">{item}</li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">Training with Thee Rainers</p>
        <ul class="flex flex-col gap-3">
          {NEW_WAY.map(step => (
            <li class="flex items-center gap-4 border border-[#0B0B0C]/10 px-5 py-4">
              <span class="text-[var(--terra)] text-[11px] font-bold tracking-widest shrink-0">{step.n}</span>
              <span class="text-[#0B0B0C] text-sm font-bold">{step.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
