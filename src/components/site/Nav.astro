---
import { workshopState, WORKSHOP_DATE_SHORT } from '../../data/workshop.ts';

const NAV_LINKS = [
  { label: 'Blueprints', href: '/shop' },
  { label: 'Workshop',   href: '/workshop' },
  { label: 'Community',  href: '/community' },
];

const wState = workshopState();
const showBar = wState !== 'between';
const barLabel = wState === 'selling'
  ? `Defense Workshop · ${WORKSHOP_DATE_SHORT} · Reserve your seat →`
  : `Defense Workshop · ${WORKSHOP_DATE_SHORT} · Join the waitlist →`;
---

<header id="site-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#0B0B0C] border-b border-white/8">

  {showBar && (
    <div id="tr-bar" class="bg-[#c84d3a] relative">
      <div class="max-w-[1140px] mx-auto px-6 py-2 flex items-center justify-center">
        <a href="/workshop"
          class="text-white text-[10px] md:text-[11px] font-bold tracking-widest uppercase hover:opacity-75 transition-opacity text-center">
          {barLabel}
        </a>
        <button id="tr-bar-close" aria-label="Dismiss announcement"
          class="absolute right-4 md:right-6 top-1/2 -translate-y-1/2 text-white/60 hover:text-white transition-colors cursor-pointer bg-transparent border-0 p-2 leading-none text-base">
          ×
        </button>
      </div>
    </div>
  )}

  <div class="max-w-[1140px] mx-auto px-6 h-16 flex items-center gap-4 md:gap-8">
    <a href="/" class="z-[60] flex items-center shrink-0" aria-label="Thee Rainers home">
      <img src="/images/trb-logo-nobg.png" alt="Thee Rainers" width="120" height="40" class="h-9 md:h-10 w-auto" />
    </a>

    <nav class="hidden md:flex items-center gap-8 ml-auto" aria-label="Primary">
      {NAV_LINKS.map((l) => (
        <a href={l.href} data-nav-path={l.href}
          class="text-white/50 text-[11px] tracking-widest uppercase hover:text-white transition-colors duration-200">
          {l.label}
        </a>
      ))}
      <a href="/command"
        class="text-white/50 text-[11px] tracking-widest uppercase hover:text-white transition-colors duration-200">
        1-ON-1
      </a>
      <a href="/community" data-nav-path="/community" class="tr-btn" style="padding: 0.6rem 1.25rem; font-size: 0.625rem;">
        Checkpoint →
      </a>
    </nav>

    <button id="menu-open" type="button"
      class="tr-menu-toggle md:hidden z-[60] ml-auto p-2 -mr-2 text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--terra)] focus-visible:ring-offset-2"
      aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<div id="mobile-menu"
  class="tr-mobile-menu"
  data-open="false"
  role="dialog" aria-modal="true" aria-label="Site navigation">

  <div id="menu-backdrop" class="tr-menu-backdrop" aria-hidden="true"></div>

  <div class="tr-menu-topbar">
    <a href="/" class="flex items-center" aria-label="Thee Rainers home">
      <img src="/images/trb-logo-nobg.png" alt="Thee Rainers" width="120" height="40" class="h-9 w-auto brightness-0 invert" />
    </a>
    <button id="menu-close" type="button" class="tr-menu-close" aria-label="Close menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav class="tr-menu-body" aria-label="Site navigation">
    <a href="/community" data-nav-path="/community" class="tr-btn" style="width:100%;margin-top:0.5rem;justify-content:center;">
      Checkpoint →
    </a>
    <ul class="flex flex-col mt-6">
      {NAV_LINKS.map((l) => (
        <li class="border-b border-white/10">
          <a href={l.href} data-nav-path={l.href}
            class="block py-5 text-3xl font-black uppercase tracking-tighter text-white hover:text-[var(--terra)] transition-colors">
            {l.label}
          </a>
        </li>
      ))}
      <li class="border-b border-white/10">
        <a href="/command"
          class="block py-5 text-3xl font-black uppercase tracking-tighter text-white hover:text-[var(--terra)] transition-colors">
          1-ON-1
        </a>
      </li>
    </ul>
  </nav>
</div>

<style>
  .tr-mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: #0B0B0C;
    overscroll-behavior: contain;
    flex-direction: column;
    display: none;
  }
  .tr-mobile-menu[data-open="true"] { display: flex; }
  .tr-menu-backdrop {
    position: absolute;
    inset: 0;
    background: transparent;
  }
  .tr-menu-topbar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    padding: 0 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    background-color: #0B0B0C;
  }
  .tr-menu-close {
    position: relative;
    z-index: 2;
    margin-right: -0.5rem;
    padding: 0.5rem;
    color: #FFFFFF;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .tr-menu-body {
    position: relative;
    z-index: 1;
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.5rem 3rem;
    background-color: #0B0B0C;
  }
  html[data-menu-open="true"], body[data-menu-open="true"] {
    overflow: hidden;
  }
</style>

<script>
  function initNav() {
    const openBtn  = document.getElementById('menu-open') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('menu-close') as HTMLButtonElement | null;
    const backdrop = document.getElementById('menu-backdrop');
    const menu     = document.getElementById('mobile-menu') as HTMLElement | null;
    if (!openBtn || !menu) return;
    if (openBtn.dataset.bound === 'true') return;
    openBtn.dataset.bound = 'true';

    const setOpen = (open: boolean) => {
      menu.setAttribute('data-open', String(open));
      openBtn.setAttribute('aria-expanded', String(open));
      document.documentElement.setAttribute('data-menu-open', String(open));
      document.body.setAttribute('data-menu-open', String(open));
    };

    openBtn.addEventListener('click', () => setOpen(menu.getAttribute('data-open') !== 'true'));
    closeBtn?.addEventListener('click', () => setOpen(false));
    backdrop?.addEventListener('click', () => setOpen(false));
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && menu.getAttribute('data-open') === 'true') setOpen(false);
    });

    const path = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-path]').forEach(link => {
      const t = link.dataset.navPath ?? '';
      if (path === t || (t.length > 1 && path.startsWith(t + '/'))) {
        link.setAttribute('aria-current', 'page');
      }
    });
  }

  function initNavGlass() {
    const nav = document.getElementById('site-nav');
    if (!nav || nav.dataset.glassBound === 'true') return;
    nav.dataset.glassBound = 'true';
    const update = () => {
      if (window.scrollY > 10) nav.classList.add('is-scrolled');
      else                     nav.classList.remove('is-scrolled');
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  function initBarDismiss() {
    const bar   = document.getElementById('tr-bar');
    const close = document.getElementById('tr-bar-close');
    if (!bar || !close) return;
    const KEY = 'tr_bar_v2';
    try { if (localStorage.getItem(KEY)) { bar.style.display = 'none'; return; } } catch (_) {}
    close.addEventListener('click', () => {
      try { localStorage.setItem(KEY, '1'); } catch (_) {}
      bar.style.display = 'none';
    });
  }

  initNav();
  initNavGlass();
  initBarDismiss();
</script>
