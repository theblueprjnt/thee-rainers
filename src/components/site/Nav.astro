---
// Task 9: HOME / TRAINING (dropdown) / ABOUT / CONTACT, plus a primary
// "Free Guide" button. TRAINING holds the four offer pages in order:
// Blueprints, Defense Workshop, Masterclass, Coaching -- the per-grade
// pages (/coaching/grade-1/2/3) still exist but are intentionally not
// surfaced in nav while the offer is still being built out.
interface Props {
  hidePromoBar?: boolean;
}
const { hidePromoBar = false } = Astro.props;

const trainingLinks = [
  { href: '/shop', label: 'Shop' },
  { href: '/defense-workshop', label: 'Workshop' },
  { href: '/masterclass', label: 'Step Into The Ring' },
  { href: '/coaching', label: 'Coaching' },
];
---

<header id="site-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white border-b border-[#0B0B0C]/8">

  <!-- Promo bar -->
  {!hidePromoBar && (
  <div class="bg-[#0A0A0A]">
    <div class="max-w-[1140px] mx-auto px-6 py-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 md:justify-start">
      <a href="/" class="hidden md:flex items-center shrink-0" aria-label="Thee Rainers home">
        <picture>
          <source srcset="/images/trb-logo-nobg-header.webp" type="image/webp" />
          <img src="/images/trb-logo-nobg-header.png" alt="Thee Rainers" width="64" height="80" class="h-5 w-auto" />
        </picture>
      </a>
      <div class="flex-1 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 text-center">
        <p class="text-white/85 text-[11px] md:text-xs font-medium">
          Get started with The Footwork Blueprint, our most popular product.
        </p>
        <a href="/foundation" class="tr-btn shrink-0" style="padding:0.35rem 0.9rem; font-size:0.625rem;">
          Get It
        </a>
      </div>
    </div>
  </div>
  )}

  <div class="max-w-[1140px] mx-auto px-6 h-20 flex items-center gap-4 md:gap-8">
    <a href="/" class="z-[60] flex items-center shrink-0" aria-label="Thee Rainers home">
      <picture>
        <source srcset="/images/trb-logo-nobg-header.webp" type="image/webp" />
        <img src="/images/trb-logo-nobg-header.png" alt="Thee Rainers" width="64" height="80" class="h-12 md:h-14 w-auto" />
      </picture>
    </a>

    <nav class="hidden md:flex items-center gap-9 ml-auto" aria-label="Primary">
      <a href="/" data-nav-path="/" class="tr-nav-btn">
        Home
      </a>

      <!-- PROGRAMS dropdown -->
      <div class="relative" id="nav-training">
        <button type="button" id="nav-training-trigger"
          aria-haspopup="true" aria-expanded="false" aria-controls="nav-training-menu"
          class="tr-nav-btn flex items-center gap-1.5">
          Programs
          <svg id="nav-training-chevron" class="w-3 h-3 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div id="nav-training-menu" role="menu" aria-label="Programs"
          class="hidden absolute left-0 top-full mt-2 min-w-[220px] bg-white border border-[#0B0B0C]/10 shadow-lg py-2">
          {trainingLinks.map(link => (
            <a href={link.href} role="menuitem" data-nav-path={link.href}
              class="block px-5 py-3 text-[#0B0B0C] text-[13px] font-semibold tracking-wide uppercase hover:text-[var(--terra)] hover:bg-[var(--warm)] transition-colors duration-150">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <a href="/about" data-nav-path="/about" class="tr-nav-btn">
        About
      </a>
      <a href="/contact" data-nav-path="/contact" class="tr-nav-btn">
        Contact
      </a>
    </nav>

    <button id="menu-open" type="button"
      class="tr-menu-toggle md:hidden z-[60] ml-auto p-2 -mr-2 text-[#0B0B0C] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--terra)] focus-visible:ring-offset-2"
      aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<div id="mobile-menu"
  class="tr-mobile-menu"
  data-open="false"
  role="dialog" aria-modal="true" aria-label="Site navigation">

  <div id="menu-backdrop" class="tr-menu-backdrop" aria-hidden="true"></div>

  <div class="tr-menu-topbar">
    <a href="/" class="flex items-center" aria-label="Thee Rainers home">
      <picture>
        <source srcset="/images/trb-logo-nobg-header.webp" type="image/webp" />
        <img src="/images/trb-logo-nobg-header.png" alt="Thee Rainers" width="64" height="80" class="h-11 w-auto" />
      </picture>
    </a>
    <button id="menu-close" type="button" class="tr-menu-close" aria-label="Close menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav class="tr-menu-body" aria-label="Site navigation">
    <a href="/first-training" class="tr-btn block text-center mb-6" style="width:100%;justify-content:center;">
      Free Guide
    </a>
    <ul class="flex flex-col">
      <li class="border-b border-[#0B0B0C]/10">
        <a href="/" data-nav-path="/"
          class="block py-5 text-3xl font-black uppercase tracking-tighter text-[#0B0B0C] hover:text-[var(--terra)] transition-colors">
          Home
        </a>
      </li>
      <li class="border-b border-[#0B0B0C]/10">
        <button type="button" id="mobile-training-trigger" aria-expanded="false" aria-controls="mobile-training-panel"
          class="w-full flex items-center justify-between py-5 text-3xl font-black uppercase tracking-tighter text-[#0B0B0C] hover:text-[var(--terra)] transition-colors">
          Programs
          <svg id="mobile-training-chevron" class="w-6 h-6 shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div id="mobile-training-panel" class="hidden pb-4 flex flex-col">
          {trainingLinks.map(link => (
            <a href={link.href} data-nav-path={link.href}
              class="block py-3 pl-4 text-lg font-bold uppercase tracking-tight text-[#0B0B0C]/70 hover:text-[var(--terra)] transition-colors">
              {link.label}
            </a>
          ))}
        </div>
      </li>
      <li class="border-b border-[#0B0B0C]/10">
        <a href="/about" data-nav-path="/about"
          class="block py-5 text-3xl font-black uppercase tracking-tighter text-[#0B0B0C] hover:text-[var(--terra)] transition-colors">
          About
        </a>
      </li>
      <li class="border-b border-[#0B0B0C]/10">
        <a href="/contact" data-nav-path="/contact"
          class="block py-5 text-3xl font-black uppercase tracking-tighter text-[#0B0B0C] hover:text-[var(--terra)] transition-colors">
          Contact
        </a>
      </li>
    </ul>
  </nav>
</div>

<style>
  .tr-nav-btn {
    display: inline-flex;
    align-items: center;
    color: #0B0B0C;
    font-family: "Poppins", ui-sans-serif, system-ui, sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    padding: 0.5rem 0;
    background: transparent;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .tr-nav-btn:hover {
    color: var(--terra);
  }
  .tr-mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: #FFFFFF;
    overscroll-behavior: contain;
    flex-direction: column;
    display: none;
  }
  .tr-mobile-menu[data-open="true"] { display: flex; }
  .tr-menu-backdrop {
    position: absolute;
    inset: 0;
    background: transparent;
  }
  .tr-menu-topbar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    padding: 0 1.5rem;
    border-bottom: 1px solid rgba(11,11,12,0.08);
    background-color: #FFFFFF;
  }
  .tr-menu-close {
    position: relative;
    z-index: 2;
    margin-right: -0.5rem;
    padding: 0.5rem;
    color: #0B0B0C;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .tr-menu-body {
    position: relative;
    z-index: 1;
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.5rem 3rem;
    background-color: #FFFFFF;
  }
  html[data-menu-open="true"], body[data-menu-open="true"] {
    overflow: hidden;
  }
</style>

<script>
  function initNav() {
    const openBtn  = document.getElementById('menu-open') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('menu-close') as HTMLButtonElement | null;
    const backdrop = document.getElementById('menu-backdrop');
    const menu     = document.getElementById('mobile-menu') as HTMLElement | null;
    if (!openBtn || !menu) return;
    if (openBtn.dataset.bound === 'true') return;
    openBtn.dataset.bound = 'true';

    const setOpen = (open: boolean) => {
      menu.setAttribute('data-open', String(open));
      openBtn.setAttribute('aria-expanded', String(open));
      document.documentElement.setAttribute('data-menu-open', String(open));
      document.body.setAttribute('data-menu-open', String(open));
    };

    openBtn.addEventListener('click', () => setOpen(menu.getAttribute('data-open') !== 'true'));
    closeBtn?.addEventListener('click', () => setOpen(false));
    backdrop?.addEventListener('click', () => setOpen(false));
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && menu.getAttribute('data-open') === 'true') setOpen(false);
    });

    const path = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-path]').forEach(link => {
      const t = link.dataset.navPath ?? '';
      if (path === t || (t.length > 1 && path.startsWith(t + '/'))) {
        link.setAttribute('aria-current', 'page');
      }
    });
  }

  // Desktop TRAINING dropdown -- click or keyboard (Enter/Space to toggle,
  // Escape to close, click-outside to close). role="menu" kept simple
  // (no roving tabindex) since there are only four links; each is a normal
  // tab stop and Escape/outside-click are the only extra keyboard paths
  // needed for this size of menu.
  function initTrainingDropdown() {
    const wrap     = document.getElementById('nav-training');
    const trigger  = document.getElementById('nav-training-trigger') as HTMLButtonElement | null;
    const menu     = document.getElementById('nav-training-menu');
    const chevron  = document.getElementById('nav-training-chevron');
    if (!wrap || !trigger || !menu) return;
    if (trigger.dataset.bound === 'true') return;
    trigger.dataset.bound = 'true';

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      trigger.setAttribute('aria-expanded', String(open));
      chevron?.classList.toggle('rotate-180', open);
    };

    trigger.addEventListener('click', () => {
      setOpen(trigger.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('click', (e) => {
      if (!wrap.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        trigger.focus();
      }
    });
    wrap.addEventListener('focusout', (e) => {
      if (!wrap.contains(e.relatedTarget as Node)) setOpen(false);
    });
  }

  // Mobile TRAINING accordion inside the full-screen menu
  function initMobileTrainingAccordion() {
    const trigger = document.getElementById('mobile-training-trigger') as HTMLButtonElement | null;
    const panel   = document.getElementById('mobile-training-panel');
    const chevron = document.getElementById('mobile-training-chevron');
    if (!trigger || !panel) return;
    if (trigger.dataset.bound === 'true') return;
    trigger.dataset.bound = 'true';

    trigger.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!open));
      panel.classList.toggle('hidden', open);
      chevron?.classList.toggle('rotate-180', !open);
    });
  }

  function initNavGlass() {
    const nav = document.getElementById('site-nav');
    if (!nav || nav.dataset.glassBound === 'true') return;
    nav.dataset.glassBound = 'true';
    const update = () => {
      if (window.scrollY > 10) nav.classList.add('is-scrolled');
      else                     nav.classList.remove('is-scrolled');
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  initNav();
  initTrainingDropdown();
  initMobileTrainingAccordion();
  initNavGlass();
</script>
