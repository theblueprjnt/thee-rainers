---
// 5 top-level items max. Everything else (Workshop) moved to the footer.
// Coaching is a single link to /coaching, not a dropdown -- the per-grade
// pages (/coaching/grade-1/2/3) still exist but are intentionally not
// surfaced in nav while the offer is still being built out.
---

<header id="site-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white border-b border-[#0B0B0C]/8">

  <div id="tr-bar" class="bg-[var(--terra)] relative">
    <div class="max-w-[1140px] mx-auto px-6 py-2 flex items-center justify-center">
      <a href="/coaching"
        class="text-white text-[10px] md:text-[11px] font-bold tracking-widest uppercase hover:opacity-75 transition-opacity text-center">
        Apply for 1-on-1 coaching →
      </a>
      <button id="tr-bar-close" aria-label="Dismiss announcement"
        class="absolute right-4 md:right-6 top-1/2 -translate-y-1/2 text-white/60 hover:text-white transition-colors cursor-pointer bg-transparent border-0 p-2 leading-none text-base">
        ×
      </button>
    </div>
  </div>

  <div class="max-w-[1140px] mx-auto px-6 h-16 flex items-center gap-4 md:gap-8">
    <a href="/" class="z-[60] flex items-center shrink-0" aria-label="Thee Rainers home">
      <picture>
        <source srcset="/images/trb-logo-nobg-header.webp" type="image/webp" />
        <img src="/images/trb-logo-nobg-header.png" alt="Thee Rainers" width="64" height="80" class="h-9 md:h-10 w-auto" />
      </picture>
    </a>

    <nav class="hidden md:flex items-center gap-8 ml-auto" aria-label="Primary">
      <a href="/" data-nav-path="/"
        class="text-[#0B0B0C]/50 text-[11px] tracking-widest uppercase hover:text-[#0B0B0C] transition-colors duration-200">
        Home
      </a>

      <a href="/coaching" data-nav-path="/coaching"
        class="text-[#0B0B0C]/50 text-[11px] tracking-widest uppercase hover:text-[#0B0B0C] transition-colors duration-200">
        Coaching
      </a>

      <a href="/shop" data-nav-path="/shop"
        class="text-[#0B0B0C]/50 text-[11px] tracking-widest uppercase hover:text-[#0B0B0C] transition-colors duration-200">
        Blueprints
      </a>
      <a href="/about" data-nav-path="/about"
        class="text-[#0B0B0C]/50 text-[11px] tracking-widest uppercase hover:text-[#0B0B0C] transition-colors duration-200">
        About
      </a>
      <a href="/contact" data-nav-path="/contact"
        class="text-[#0B0B0C]/50 text-[11px] tracking-widest uppercase hover:text-[#0B0B0C] transition-colors duration-200">
        Contact
      </a>

      <a href="/coaching" data-nav-path="/coaching" class="tr-btn" style="padding: 0.6rem 1.25rem; font-size: 0.625rem;">
        Apply 1-1
      </a>
    </nav>

    <button id="menu-open" type="button"
      class="tr-menu-toggle md:hidden z-[60] ml-auto p-2 -mr-2 text-[#0B0B0C] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--terra)] focus-visible:ring-offset-2"
      aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<div id="mobile-menu"
  class="tr-mobile-menu"
  data-open="false"
  role="dialog" aria-modal="true" aria-label="Site navigation">

  <div id="menu-backdrop" class="tr-menu-backdrop" aria-hidden="true"></div>

  <div class="tr-menu-topbar">
    <a href="/" class="flex items-center" aria-label="Thee Rainers home">
      <picture>
        <source srcset="/images/trb-logo-nobg-header.webp" type="image/webp" />
        <img src="/images/trb-logo-nobg-header.png" alt="Thee Rainers" width="64" height="80" class="h-9 w-auto" />
      </picture>
    </a>
    <button id="menu-close" type="button" class="tr-menu-close" aria-label="Close menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <nav class="tr-menu-body" aria-label="Site navigation">
    <a href="/coaching" data-nav-path="/coaching" class="tr-btn" style="width:100%;margin-top:0.5rem;justify-content:center;">
      Apply for 1-1 Coaching
    </a>
    <ul class="flex flex-col mt-6">
      <li class="border-b border-[#0B0B0C]/10">
        <a href="/" data-nav-path="/"
          class="block py-5 text-3xl font-black uppercase tracking-tighter text-[#0B0B0C] hover:text-[var(--terra)] transition-colors">
          Home
        </a>
      </li>
      <li class="border-b border-[#0B0B0C]/10">
        <a href="/coaching" data-nav-path="/coaching"
          class="block py-5 text-3xl font-black uppercase tracking-tighter text-[#0B0B0C] hover:text-[var(--terra)] transition-colors">
          Coaching
        </a>
      </li>
      <li class="border-b border-[#0B0B0C]/10">
        <a href="/shop" data-nav-path="/shop"
          class="block py-5 text-3xl font-black uppercase tracking-tighter text-[#0B0B0C] hover:text-[var(--terra)] transition-colors">
          Blueprints
        </a>
      </li>
      <li class="border-b border-[#0B0B0C]/10">
        <a href="/about" data-nav-path="/about"
          class="block py-5 text-3xl font-black uppercase tracking-tighter text-[#0B0B0C] hover:text-[var(--terra)] transition-colors">
          About
        </a>
      </li>
      <li class="border-b border-[#0B0B0C]/10">
        <a href="/contact" data-nav-path="/contact"
          class="block py-5 text-3xl font-black uppercase tracking-tighter text-[#0B0B0C] hover:text-[var(--terra)] transition-colors">
          Contact
        </a>
      </li>
    </ul>
  </nav>
</div>

<style>
  .tr-mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: #FFFFFF;
    overscroll-behavior: contain;
    flex-direction: column;
    display: none;
  }
  .tr-mobile-menu[data-open="true"] { display: flex; }
  .tr-menu-backdrop {
    position: absolute;
    inset: 0;
    background: transparent;
  }
  .tr-menu-topbar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    padding: 0 1.5rem;
    border-bottom: 1px solid rgba(11,11,12,0.08);
    background-color: #FFFFFF;
  }
  .tr-menu-close {
    position: relative;
    z-index: 2;
    margin-right: -0.5rem;
    padding: 0.5rem;
    color: #0B0B0C;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .tr-menu-body {
    position: relative;
    z-index: 1;
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.5rem 3rem;
    background-color: #FFFFFF;
  }
  html[data-menu-open="true"], body[data-menu-open="true"] {
    overflow: hidden;
  }
</style>

<script>
  function initNav() {
    const openBtn  = document.getElementById('menu-open') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('menu-close') as HTMLButtonElement | null;
    const backdrop = document.getElementById('menu-backdrop');
    const menu     = document.getElementById('mobile-menu') as HTMLElement | null;
    if (!openBtn || !menu) return;
    if (openBtn.dataset.bound === 'true') return;
    openBtn.dataset.bound = 'true';

    const setOpen = (open: boolean) => {
      menu.setAttribute('data-open', String(open));
      openBtn.setAttribute('aria-expanded', String(open));
      document.documentElement.setAttribute('data-menu-open', String(open));
      document.body.setAttribute('data-menu-open', String(open));
    };

    openBtn.addEventListener('click', () => setOpen(menu.getAttribute('data-open') !== 'true'));
    closeBtn?.addEventListener('click', () => setOpen(false));
    backdrop?.addEventListener('click', () => setOpen(false));
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && menu.getAttribute('data-open') === 'true') setOpen(false);
    });

    const path = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-path]').forEach(link => {
      const t = link.dataset.navPath ?? '';
      if (path === t || (t.length > 1 && path.startsWith(t + '/'))) {
        link.setAttribute('aria-current', 'page');
      }
    });
  }

  function initNavGlass() {
    const nav = document.getElementById('site-nav');
    if (!nav || nav.dataset.glassBound === 'true') return;
    nav.dataset.glassBound = 'true';
    const update = () => {
      if (window.scrollY > 10) nav.classList.add('is-scrolled');
      else                     nav.classList.remove('is-scrolled');
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  function initBarDismiss() {
    const bar   = document.getElementById('tr-bar');
    const close = document.getElementById('tr-bar-close');
    if (!bar || !close) return;
    const KEY = 'tr_bar_v2';
    try { if (localStorage.getItem(KEY)) { bar.style.display = 'none'; return; } } catch (_) {}
    close.addEventListener('click', () => {
      try { localStorage.setItem(KEY, '1'); } catch (_) {}
      bar.style.display = 'none';
    });
  }

  initNav();
  initNavGlass();
  initBarDismiss();
</script>
