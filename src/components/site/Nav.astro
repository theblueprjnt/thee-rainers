---
// Single source of truth for nav links. Desktop bar + mobile panel both
// iterate this array so they cannot drift.
const NAV_LINKS = [
  { label: 'Library', href: '/library' },
  { label: 'Shop',    href: '/shop' },
  { label: 'About',   href: '/about' },
];
---
<header id="site-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/95 backdrop-blur-md border-b border-[#0A0A0A]/8">
  <div class="max-w-[1140px] mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="z-[60] flex items-center" aria-label="Thee Rainers — home">
      <img src="/images/logo-trb.png" alt="Thee Rainers" class="h-10 md:h-12 w-auto" />
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
      {NAV_LINKS.map((l) => (
        <a href={l.href} data-nav-path={l.href} class="text-[#0A0A0A]/40 text-[11px] tracking-widest uppercase hover:text-[#0A0A0A] transition-colors duration-200">{l.label}</a>
      ))}
    </nav>

    <button id="menu-open" type="button" class="tr-menu-toggle md:hidden z-[60] p-2 -mr-2 text-[#0A0A0A] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4A373] focus-visible:ring-offset-2"
      aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile menu rendered OUTSIDE the <header>.
     CRITICAL: the header has `backdrop-blur-md` which creates a new containing
     block for fixed-positioned descendants. Putting the menu inside the header
     traps its `position: fixed; inset: 0` to the header's box, so it gets clipped
     to ~64px tall. Rendering it as a sibling of <header> escapes that trap and
     the menu correctly covers the full viewport. -->
<div id="mobile-menu"
  class="tr-mobile-menu"
  data-open="false"
  role="dialog" aria-modal="true" aria-label="Site navigation">

  <!-- Backdrop tap area for close -->
  <div id="menu-backdrop" class="tr-menu-backdrop" aria-hidden="true"></div>

  <!-- Top bar — same height as nav with logo + close -->
  <div class="tr-menu-topbar">
    <a href="/" class="flex items-center" aria-label="Thee Rainers — home">
      <img src="/images/logo-trb.png" alt="Thee Rainers" class="h-10 w-auto" />
    </a>
    <button id="menu-close" type="button" class="tr-menu-close" aria-label="Close menu">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Scrollable nav body -->
  <nav class="tr-menu-body" aria-label="Site navigation">
    <ul class="flex flex-col">
      {NAV_LINKS.map((l) => (
        <li class="border-b border-[#D4A373]/30">
          <a href={l.href} data-nav-path={l.href} class="block py-5 text-3xl font-black uppercase tracking-tighter text-[#0A0A0A] hover:opacity-70 transition-opacity">
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <a href="/community" class="tr-menu-cta tr-menu-cta-purple">Join the Community</a>
    <a href="/foundation-guide" class="tr-menu-cta tr-menu-cta-outline">Get the free foundation</a>

    <p class="mt-8 text-[10px] tracking-widest uppercase text-[#0A0A0A]/35">Private Architecture · Application Only</p>
    <a href="/command" class="block text-xs tracking-widest uppercase font-bold mt-2 text-[#6A0DAD] hover:opacity-70 transition-opacity duration-200">
      Apply →
    </a>
  </nav>
</div>

<style>
  /* Mobile menu — explicit CSS, not dependent on any Tailwind utility class
     being generated. Driven entirely by the [data-open] attribute. */
  .tr-mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: #FFFFFF;
    overscroll-behavior: contain;
    flex-direction: column;
    display: none;
  }
  .tr-mobile-menu[data-open="true"] {
    display: flex;
  }
  .tr-menu-backdrop {
    position: absolute;
    inset: 0;
    background: transparent;
  }
  .tr-menu-topbar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    padding: 0 1.5rem;
    border-bottom: 1px solid rgba(10,10,10,0.08);
    background-color: #FFFFFF;
  }
  .tr-menu-close {
    position: relative;
    z-index: 2;
    margin-right: -0.5rem;
    padding: 0.5rem;
    color: #0A0A0A;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .tr-menu-close:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px #D4A373;
  }
  .tr-menu-body {
    position: relative;
    z-index: 1;
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem 1.5rem 2rem;
    background-color: #FFFFFF;
  }
  .tr-menu-cta {
    display: inline-flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    border-radius: 0;
    transition: background-color 150ms, color 150ms;
  }
  .tr-menu-cta-purple {
    margin-top: 2rem;
    background-color: #6A0DAD;
    color: #FFFFFF;
  }
  .tr-menu-cta-purple:hover { background-color: #0A0A0A; }
  .tr-menu-cta-outline {
    margin-top: 0.75rem;
    border: 2px solid #0057FF;
    color: #0057FF;
    background-color: transparent;
  }
  .tr-menu-cta-outline:hover {
    background-color: #0A0A0A;
    color: #FFFFFF;
    border-color: #0A0A0A;
  }
  /* Lock body scroll while menu is open — toggled by JS via [data-menu-open] */
  html[data-menu-open="true"], body[data-menu-open="true"] {
    overflow: hidden;
  }
</style>

<script>
  // ────────────────────────────────────────────────────────────────────────
  // Mobile menu — bulletproof binding pattern:
  // 1. Idempotent: dataset.bound guard prevents double-attaching listeners.
  // 2. Synchronous: init() runs immediately when this script executes
  //    (Astro <script> tags defer until DOM is parsed, so elements exist).
  // 3. Forward-compatible: also re-runs on astro:page-load event in case
  //    ClientRouter (ViewTransitions) gets enabled later in astro.config.
  // 4. Declarative state: panel visibility driven by data-open attribute +
  //    explicit CSS rules, NOT class toggling. No Tailwind dependency for
  //    the open/close behavior.
  // ────────────────────────────────────────────────────────────────────────

  function initNav() {
    const openBtn   = document.getElementById('menu-open') as HTMLButtonElement | null;
    const closeBtn  = document.getElementById('menu-close') as HTMLButtonElement | null;
    const backdrop  = document.getElementById('menu-backdrop');
    const menu      = document.getElementById('mobile-menu') as HTMLElement | null;
    if (!openBtn || !menu) return;
    if (openBtn.dataset.bound === 'true') return;
    openBtn.dataset.bound = 'true';

    const setOpen = (open: boolean) => {
      menu.setAttribute('data-open', String(open));
      openBtn.setAttribute('aria-expanded', String(open));
      // Lock scroll on BOTH html and body for iOS Safari compatibility
      document.documentElement.setAttribute('data-menu-open', String(open));
      document.body.setAttribute('data-menu-open', String(open));
    };

    openBtn.addEventListener('click', () => {
      const isOpen = menu.getAttribute('data-open') === 'true';
      setOpen(!isOpen);
    });

    closeBtn?.addEventListener('click', () => setOpen(false));
    backdrop?.addEventListener('click', () => setOpen(false));

    // Close on link tap (delegated inside menu).
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    // Close on Escape.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.getAttribute('data-open') === 'true') setOpen(false);
    });

    // Active link styling for current page.
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-path]').forEach((link) => {
      const target = link.dataset.navPath ?? '';
      const isActive = currentPath === target || (target.length > 1 && currentPath.startsWith(target + '/'));
      if (!isActive) return;
      link.setAttribute('aria-current', 'page');
      link.classList.remove('text-[#0A0A0A]/40');
      link.classList.add('text-[#0057FF]');
    });
  }

  function initNavGlass() {
    const siteNav = document.getElementById('site-nav');
    if (!siteNav) return;
    if (siteNav.dataset.glassBound === 'true') return;
    siteNav.dataset.glassBound = 'true';
    const update = () => {
      if (window.scrollY > 10) siteNav.classList.add('is-scrolled');
      else                     siteNav.classList.remove('is-scrolled');
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Run synchronously now (works for every page load, with or without ClientRouter).
  initNav();
  initNavGlass();
  // Hook for ClientRouter view-transitions in case it's enabled later.
  document.addEventListener('astro:page-load', () => { initNav(); initNavGlass(); });
</script>
