---
// Cookie consent banner — Consent Mode v2 (Google).
// Shows on first paint. Choice stored in localStorage under key trb_consent_v1.
// Accept: upgrades all consent signals to 'granted'.
// Decline: keeps defaults (all denied). Banner hidden either way.
---

<div
  id="trb-consent"
  role="dialog"
  aria-labelledby="trb-consent-title"
  class="fixed bottom-0 left-0 right-0 z-[150] bg-white border-t border-[#0B0B0C]/10 hidden"
  style="box-shadow: 0 -4px 32px rgba(0,0,0,0.12);"
>
  <div class="max-w-[1280px] mx-auto px-6 md:px-10 py-4 flex flex-col sm:flex-row sm:items-center gap-4 justify-between">
    <p id="trb-consent-title" class="text-[#0B0B0C]/70 text-xs leading-relaxed max-w-[640px]">
      This site uses cookies for analytics and performance.
      <a href="/legal/cookie-policy" class="underline hover:text-[#0B0B0C] transition-colors">Cookie Policy</a>
      &middot;
      <a href="/legal/privacy-policy" class="underline hover:text-[#0B0B0C] transition-colors">Privacy Policy</a>
    </p>
    <div class="flex gap-3 shrink-0">
      <button id="trb-consent-decline"
        class="text-[#0B0B0C]/60 text-[11px] font-bold tracking-widest uppercase border border-[#0B0B0C]/15 px-5 py-2.5 hover:border-[#0B0B0C]/35 hover:text-[#0B0B0C] transition-colors duration-150 cursor-pointer bg-transparent">
        Decline non-essential
      </button>
      <button id="trb-consent-accept"
        class="tr-btn" style="padding: 0.625rem 1.25rem; font-size: 0.625rem;">
        Accept
      </button>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  var KEY = 'trb_consent_v1';
  var banner = document.getElementById('trb-consent');

  function stored() {
    try { return localStorage.getItem(KEY); } catch (_) { return null; }
  }

  function save(val) {
    try { localStorage.setItem(KEY, val); } catch (_) {}
  }

  function grant() {
    if (typeof window.gtag === 'function') {
      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
      });
    }
  }

  var choice = stored();

  if (choice === 'granted') {
    // Already accepted — grant is handled synchronously in Base.astro head.
    return;
  }
  if (choice === 'denied') {
    return;
  }

  // position:fixed means the banner floats above whatever is at that screen
  // position regardless of body padding — it cannot be pushed out of the way.
  // Instead: measure its footprint before showing it, and if that footprint
  // would cover any interactive element already visible in the initial
  // viewport (any page's hero CTA, not just one route), defer showing the
  // banner until the first scroll (or a short timeout, so it still always
  // appears even if the user never scrolls).
  function measureHeight() {
    if (!banner) return 0;
    banner.style.visibility = 'hidden';
    banner.classList.remove('hidden');
    var h = banner.offsetHeight;
    banner.classList.add('hidden');
    banner.style.visibility = '';
    return h;
  }

  function overlapsInteractive(bannerHeight) {
    var vh = window.innerHeight;
    var bannerTop = vh - bannerHeight;
    var interactive = document.querySelectorAll('a[href], button');
    for (var i = 0; i < interactive.length; i++) {
      var el = interactive[i];
      if (banner && banner.contains(el)) continue;
      var r = el.getBoundingClientRect();
      if (r.width === 0 || r.height === 0) continue;
      if (r.bottom > bannerTop && r.top < vh) return true;
    }
    return false;
  }

  function showBanner() {
    if (banner) banner.classList.remove('hidden');
  }

  // First visit — show banner, unless it would cover something tappable.
  // Deferred two animation frames: measuring offsetHeight/getBoundingClientRect
  // synchronously at parse time can race the stylesheet still applying,
  // returning a too-small banner height and a false "no overlap" reading.
  // Two rAFs guarantee at least one full style+layout pass has completed.
  if (banner) {
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        var bannerHeight = measureHeight();
        if (overlapsInteractive(bannerHeight)) {
          var reveal = function () {
            showBanner();
            window.removeEventListener('scroll', reveal);
            clearTimeout(fallback);
          };
          window.addEventListener('scroll', reveal, { once: true, passive: true });
          var fallback = setTimeout(reveal, 4000);
        } else {
          showBanner();
        }
      });
    });
  }

  var acceptBtn = document.getElementById('trb-consent-accept');
  var declineBtn = document.getElementById('trb-consent-decline');

  if (acceptBtn) {
    acceptBtn.addEventListener('click', function () {
      save('granted');
      grant();
      if (banner) banner.classList.add('hidden');
    });
  }

  if (declineBtn) {
    declineBtn.addEventListener('click', function () {
      save('denied');
      if (banner) banner.classList.add('hidden');
    });
  }
})();
</script>
