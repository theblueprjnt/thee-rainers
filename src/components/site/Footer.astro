        </div>
      </div>

      <!-- Centered logo + wordmark -->
      <div class="text-center">
        <a href="/" aria-label="Thee Rainers home">
          <img src="/images/trb-logo-nobg.png" alt="Thee Rainers"
            class="h-10 w-auto mx-auto mb-3 opacity-70 hover:opacity-100 transition-opacity duration-200" />
        </a>
        <p class="text-white/25 text-[10px] tracking-widest uppercase">theerainers.com</p>
      </div>

      <!-- Copyright -->
      <p class="text-white/25 text-[10px] tracking-widest uppercase text-center">
        &copy; {year} Thee Rainers
      </p>

      <!-- Six legal links in one row -->
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        <a href="/legal/privacy-policy"          class="text-white/35 text-[10px] tracking-wide hover:text-white/60 transition-colors">Privacy Policy</a>
        <a href="/legal/terms"                   class="text-white/35 text-[10px] tracking-wide hover:text-white/60 transition-colors">Terms</a>
        <a href="/legal/refund-policy"           class="text-white/35 text-[10px] tracking-wide hover:text-white/60 transition-colors">Refund Policy</a>
        <a href="/legal/cookie-policy"           class="text-white/35 text-[10px] tracking-wide hover:text-white/60 transition-colors">Cookie Policy</a>
        <a href="/legal/accessibility-statement" class="text-white/35 text-[10px] tracking-wide hover:text-white/60 transition-colors">Accessibility</a>
        <a href="/legal/disclaimer"              class="text-white/35 text-[10px] tracking-wide hover:text-white/60 transition-colors">Disclaimer</a>
      </div>

    </div>
  </div>

</footer>
