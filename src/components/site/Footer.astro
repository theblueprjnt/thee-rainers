---
const year = new Date().getFullYear();
---

<footer>

  <!-- ── HELP BLOCK (white) ────────────────────────────────────────────── -->
  <div class="bg-white border-t border-[#0B0B0C]/8 px-6 py-12 md:py-16">
    <div class="max-w-[1140px] mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
      <div>
        <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-3">Get in touch</p>
        <p class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-[0.88]"
          style="font-size: clamp(1.5rem, 3vw, 2rem);">
          <!-- DRAFT: voice pass Rainers -->
          Not sure where to start.
        </p>
      </div>
      <a href="/contact"
        class="tr-btn tr-btn--secondary shrink-0">
        <!-- DRAFT: voice pass Rainers -->
        Contact
      </a>
    </div>
  </div>

  <!-- ── DARK BLOCK ─────────────────────────────────────────────────────── -->
  <div class="bg-[#0B0B0C] px-6 py-12 md:py-16">
    <div class="max-w-[1140px] mx-auto flex flex-col items-center gap-10">

      <!-- FOLLOW US + social icons -->
      <div class="text-center">
        <p class="text-white/30 text-[10px] tracking-widest uppercase font-bold mb-5">Follow Us</p>
        <div class="flex items-center justify-center gap-6">

          <a href="https://www.instagram.com/theerainers" target="_blank" rel="noopener"
            class="text-white/50 hover:text-white transition-colors duration-200" aria-label="Instagram">
