---
// src/components/site/Testimonials.astro
//
// Proof section built for VERTICAL Shorts (9:16), facade-loaded for speed,
// with self-identification filters. One component, imported wherever proof is
// needed. Data: src/data/testimonials.ts.
//
// WHY IT IS BUILT THIS WAY (the reasoning behind every choice):
//
// 1. FACADE PATTERN. Five raw YouTube embeds would load ~1.3–2.6MB of script
//    EACH before anyone hits play, and tank mobile LCP (Google's "good" bar is
//    now 2.0s). So each video is a static thumbnail + play button; the real
//    iframe is injected only on click. ~800ms faster LCP, and nothing loads
//    that the visitor did not ask for.
//
// 2. EXPLICIT 9:16 SIZING. The aspect-[9/16] box reserves space before anything
//    loads, so the layout never jumps when a thumbnail or iframe appears (CLS = 0).
//    No letterboxing because the frame matches the Short.
//
// 3. SELF-IDENTIFICATION FILTERS. The whole reason 5 testimonials beats 1 is that
//    a visitor finds someone like themselves. The `filter` prop pre-selects which
//    set shows, so the page can match proof to the product/visitor:
//      <Testimonials filter="remote" />     -> trained-alone proof  (Blueprints)
//      <Testimonials filter="in_person" />  -> trained-live proof   (Workshop)
//      <Testimonials />                     -> all five (a /proof or homepage wall)
//
// 4. THUMBNAIL FALLBACK. Shorts do not always serve maxres/hq thumbnails, so the
//    <img> tries maxres -> hq -> mq and never shows a broken image.
//
// USAGE:
//   <Testimonials filter="remote" heading="Trained from the blueprint" kicker="Results · Remote" />
//   <Testimonials filter="in_person" heading="Trained live" kicker="Results · In Person" background="void" />
//   <Testimonials heading="Proof" /> (all)

import { testimonials, type Testimonial } from "../../data/testimonials";

interface Props {
  heading?: string;
  kicker?: string;
  filter?: "remote" | "in_person" | "all";
  ids?: string[];
  background?: "white" | "void";
}

const {
  heading = "Proof",
  kicker = "Results · In Their Words",
  filter = "all",
  ids,
  background = "white",
} = Astro.props;

const isPlaceholder = (s?: string) =>
  !s || s.startsWith("REPLACE") || s.includes("REPLACE_WITH");

// Renderable = real video ID present. (Quote may still be a placeholder caption;
// the video itself is the proof, so it renders either way.)
let pool: Testimonial[] = testimonials.filter(
  (t) => t.youtubeId && !isPlaceholder(t.youtubeId),
);
if (filter !== "all") pool = pool.filter((t) => t.setting === filter);
if (ids?.length) pool = pool.filter((t) => ids.includes(t.id));

const featured = pool.find((t) => t.featured) ?? pool[0];
const rest = pool.filter((t) => t.id !== featured?.id);

const cleanQuote = (t: Testimonial) =>
  isPlaceholder(t.quote) ? null : t.quote;

const dark = background === "void";
const muted = dark ? "text-white/55" : "text-[#0A0A0A]/55";
const cardBg = dark ? "bg-[#0A0A0A]" : "bg-white";
const hairColor = dark ? "rgba(255,255,255,.15)" : "rgba(10,10,10,.12)";
---

{
  pool.length > 0 && (
    <section class={dark ? "w-full bg-[#0A0A0A] text-white" : "w-full bg-white text-[#0A0A0A]"}>
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <div class="mb-12 md:mb-16">
          <p class="text-[10px] font-bold uppercase tracking-widest text-[var(--ink-soft)]">
            {kicker}
          </p>
          <h2 class="mt-3 text-4xl font-black uppercase leading-[0.9] tracking-tighter md:text-6xl">
            {heading}
          </h2>
        </div>

        {/* Spotlight — when a pulled quote exists, side-by-side video + quote.
            When no quote is pulled yet, center the video so the section never
            looks half-empty. Caption follows in either case. */}
        {featured && (
          cleanQuote(featured) ? (
            <div class="grid grid-cols-1 gap-8 sm:grid-cols-5 sm:items-center sm:gap-12">
              <div class="sm:col-span-2">
                <button
                  type="button"
                  class="group relative mx-auto block w-full max-w-[300px] overflow-hidden border sm:mx-0"
                  style={`border-color:${hairColor}`}
                  data-yt-facade
                  data-yt-id={featured.youtubeId}
                  aria-label={`Play testimonial from ${featured.name || "student"}`}
                >
                  <span class="relative block aspect-[9/16] bg-[#0A0A0A]">
                    <img
                      src={`https://i.ytimg.com/vi/${featured.youtubeId}/maxresdefault.jpg`}
                      data-fallback={featured.youtubeId}
                      data-step="0"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover opacity-90 transition duration-150 group-hover:opacity-100"
                    />
                    <span class="absolute inset-0 grid place-items-center">
                      <span class="grid h-16 w-16 place-items-center bg-[var(--blue)] text-white transition-colors duration-150 group-hover:bg-white group-hover:text-[#0A0A0A]">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </span>
                    </span>
                  </span>
                </button>
              </div>

              <figure class="sm:col-span-3">
                <blockquote class="text-2xl font-bold leading-tight tracking-tight md:text-4xl">
                  “{featured.quote}”
                </blockquote>
                <figcaption class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                  <span class="h-px w-8 bg-[var(--ink-soft)]" />
                  <span>
                    {featured.name && <span class="font-bold uppercase tracking-wide">{featured.name}</span>}
                    {featured.name && featured.persona && <span class={muted}> · {featured.persona}</span>}
                    {!featured.name && featured.persona && <span class={muted}>{featured.persona}</span>}
                  </span>
                </figcaption>
              </figure>
            </div>
          ) : (
            <figure class="mx-auto max-w-[340px]">
              <button
                type="button"
                class="group relative block w-full overflow-hidden border"
                style={`border-color:${hairColor}`}
                data-yt-facade
                data-yt-id={featured.youtubeId}
                aria-label={`Play testimonial from ${featured.name || "student"}`}
              >
                <span class="relative block aspect-[9/16] bg-[#0A0A0A]">
                  <img
                    src={`https://i.ytimg.com/vi/${featured.youtubeId}/maxresdefault.jpg`}
                    data-fallback={featured.youtubeId}
                    data-step="0"
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover opacity-90 transition duration-150 group-hover:opacity-100"
                  />
                  <span class="absolute inset-0 grid place-items-center">
                    <span class="grid h-16 w-16 place-items-center bg-[var(--blue)] text-white transition-colors duration-150 group-hover:bg-white group-hover:text-[#0A0A0A]">
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </span>
                  </span>
                </span>
              </button>
              <figcaption class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                <span class="h-px w-8 bg-[var(--ink-soft)]" />
                <span>
                  {featured.name && <span class="font-bold uppercase tracking-wide">{featured.name}</span>}
                  {featured.name && featured.persona && <span class={muted}> · {featured.persona}</span>}
                  {!featured.name && featured.persona && <span class={muted}>{featured.persona}</span>}
                </span>
              </figcaption>
            </figure>
          )
        )}

        {/* The rest — vertical thumbnails in a row, matched-persona grid */}
        {rest.length > 0 && (
          <div class="mt-12 grid grid-cols-2 gap-5 sm:gap-6 md:mt-16 lg:grid-cols-4">
            {rest.map((t) => (
              <figure class={`${cardBg}`}>
                <button
                  type="button"
                  class="group relative block w-full overflow-hidden border"
                  style={`border-color:${hairColor}`}
                  data-yt-facade
                  data-yt-id={t.youtubeId}
                  aria-label={`Play testimonial from ${t.name || "student"}`}
                >
                  <span class="relative block aspect-[9/16] bg-[#0A0A0A]">
                    <img
                      src={`https://i.ytimg.com/vi/${t.youtubeId}/maxresdefault.jpg`}
                      data-fallback={t.youtubeId}
                      data-step="0"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover opacity-90 transition duration-150 group-hover:opacity-100"
                    />
                    <span class="absolute inset-0 grid place-items-center">
                      <span class="grid h-12 w-12 place-items-center bg-[var(--blue)] text-white transition-colors duration-150 group-hover:bg-white group-hover:text-[#0A0A0A]">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </span>
                    </span>
                  </span>
                </button>
                <figcaption class="flex flex-wrap items-center gap-x-2 gap-y-0.5 pt-3 text-xs">
                  <span>
                    {t.name && <span class="font-bold uppercase tracking-wide">{t.name}</span>}
                    {t.name && t.persona && <span class={muted}> · {t.persona}</span>}
                    {!t.name && t.persona && <span class={muted}>{t.persona}</span>}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  // Idempotent init — sync first, then re-run on astro:page-load for ClientRouter.
  // Delegated click handler is attached to document, so we guard on document itself.
  function initTestimonials() {
    const order = ["maxresdefault", "hqdefault", "mqdefault"];
    document.querySelectorAll<HTMLImageElement>("img[data-fallback]").forEach((img) => {
      if (img.dataset.bound === 'true') return;
      img.dataset.bound = 'true';
      img.addEventListener("error", () => {
        const id = img.getAttribute("data-fallback");
        let step = Number(img.getAttribute("data-step") || "0") + 1;
        if (!id || step >= order.length) return;
        img.setAttribute("data-step", String(step));
        img.src = `https://i.ytimg.com/vi/${id}/${order[step]}.jpg`;
      });
    });

    // Document-level facade click delegation — bind once globally.
    if (document.documentElement.dataset.trYtFacadeBound !== 'true') {
      document.documentElement.dataset.trYtFacadeBound = 'true';
      document.addEventListener("click", onFacadeClick);
    }
  }

  // Facade: inject the real player only on click. Delegation = works for any count.
  function onFacadeClick(e: Event) {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-yt-facade]");
    if (!btn) return;
    const id = btn.getAttribute("data-yt-id");
    if (!id) return;

    const frame = document.createElement("div");
    frame.className = "relative aspect-[9/16] w-full";
    const iframe = document.createElement("iframe");
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`;
    iframe.title = "Video testimonial";
    iframe.loading = "lazy";
    iframe.setAttribute(
      "allow",
      "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",
    );
    iframe.setAttribute("allowfullscreen", "");
    iframe.className = "absolute inset-0 h-full w-full border-0";
    frame.appendChild(iframe);
    btn.replaceWith(frame);
  }

  initTestimonials();
  document.addEventListener('astro:page-load', initTestimonials);
</script>
