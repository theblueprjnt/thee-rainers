---
// PricingCard. Visual pattern lifted from community/index.astro's Annual/Monthly
// cards (the cleanest existing precedent in this codebase for this shape).
//
// Phase 3 layout fix: at the mobile clamp floor, a black-weight price the
// same size as the H1 was reading as the dominant element on the page and
// made the card look like a price tag, not a sales pitch. Fixed order is
// now name -> outcome (largest text on the card) -> price (small, regular
// weight) -> features -> CTA.
//
// Color law: terra is restricted to the CTA fill only. The featured
// treatment (border + name label) uses ink/60 instead of terra. Purple
// stays unassigned (Community retired) -- see global.css color-law comment.
interface Props {
  name: string;
  price: string;
  term?: string;
  outcome: string;
  features: string[];
  priceId: string;
  ctaLabel: string;
  note?: string;
  featured?: boolean;
  size?: 'default' | 'lg';
}

const { name, price, term, outcome, features, priceId, ctaLabel, note, featured = false, size = 'default' } = Astro.props;

const padding = size === 'lg' ? 'p-10 md:p-16' : 'p-10';
---

<div
  class:list={[
    'bg-white flex flex-col gap-8 relative',
    padding,
    featured ? 'border-2' : 'border border-[#0B0B0C]/8',
  ]}
  style={featured ? 'border-color: rgba(11,11,12,0.6);' : undefined}
>
  <div>
    <p
      class:list={[
        'text-[10px] tracking-widest uppercase font-bold mb-4',
        featured ? 'text-[#0B0B0C]/60' : 'text-[var(--navy)]',
      ]}
    >{name}</p>

    <p class="font-black text-[#0B0B0C] tracking-tight leading-[0.95] mb-5"
      style={`font-size: clamp(1.5rem, ${size === 'lg' ? '4.5vw' : '3.5vw'}, ${size === 'lg' ? '2.25rem' : '1.875rem'});`}>
      {outcome}
    </p>

    <div class="flex items-baseline gap-1">
      <span class="font-medium text-[#0B0B0C]" style="font-size: 1.5rem;">{price}</span>
      {term && <span class="text-[#0B0B0C]/60 text-sm">{term}</span>}
    </div>
  </div>

  <ul class="flex flex-col gap-3">
    {features.map(f => (
      <li class="text-[#0B0B0C]/65 text-sm">{f}</li>
    ))}
  </ul>

  {note && <p class="text-[#0B0B0C]/50 text-xs leading-relaxed">{note}</p>}

  <div>
    <button type="button" data-checkout={priceId}
      class="tr-btn" style="width:100%;justify-content:center;">
      {ctaLabel}
    </button>
    <p data-checkout-error class="hidden text-[var(--terra)] text-xs font-bold tracking-wide mt-2">
      Checkout unavailable. Email rainers@theerainers.com
    </p>
  </div>
</div>
