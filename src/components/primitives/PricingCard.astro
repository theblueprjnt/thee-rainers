---
// PricingCard. Checkmark/badge pricing-card style, recreated from a
// reference the owner sent (membership cards: name, price, description,
// divider, checkmark feature list, full-width CTA). Adapted to our color
// law: terra marks the featured tier (border + badge + checkmarks), never
// blue. Used on both /coaching and the homepage pricing section.
interface Props {
  name: string;
  price: string;
  term?: string;
  outcome: string;
  features: string[];
  priceId: string;
  ctaLabel: string;
  note?: string;
  featured?: boolean;
  badge?: string;
  size?: 'default' | 'lg';
}

const { name, price, term, outcome, features, priceId, ctaLabel, note, featured = false, badge, size = 'default' } = Astro.props;

const padding = size === 'lg' ? 'p-10 md:p-16' : 'p-10';
---

<div
  class:list={[
    'bg-white flex flex-col gap-6 relative',
    padding,
    featured ? 'border-2' : 'border border-[#0B0B0C]/8',
  ]}
  style={featured ? 'border-color: var(--terra);' : undefined}
>
  {badge && (
    <span class="absolute top-0 right-6 -translate-y-1/2 bg-[var(--terra)] text-white text-[10px] font-bold tracking-widest uppercase px-3 py-1.5">
      {badge}
    </span>
  )}

  <div>
    <h3 class="font-black text-[#0B0B0C] uppercase tracking-tight text-lg leading-tight mb-4">{name}</h3>

    <div class="flex items-baseline gap-1 mb-2">
      <span class="font-black text-[#0B0B0C] tracking-tight" style="font-size: clamp(2rem, 4vw, 2.5rem);">{price}</span>
      {term && <span class="text-[#0B0B0C]/50 text-sm">{term}</span>}
    </div>

    <p class="text-[#0B0B0C]/60 text-sm leading-relaxed">{outcome}</p>
  </div>

  <div class="h-px bg-[#0B0B0C]/8"></div>

  <ul class="flex flex-col gap-3">
    {features.map(f => (
      <li class="flex items-start gap-2.5 text-[#0B0B0C]/70 text-sm leading-snug">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0 mt-0.5" aria-hidden="true">
          <path d="M3 8.5L6.2 11.5L13 4.5" stroke="var(--terra)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {f}
      </li>
    ))}
  </ul>

  {note && <p class="text-[#0B0B0C]/50 text-xs leading-relaxed">{note}</p>}

  <div>
    <button type="button" data-checkout={priceId}
      class="tr-btn" style="width:100%;justify-content:center;">
      {ctaLabel}
    </button>
    <p data-checkout-error class="hidden text-[var(--terra)] text-xs font-bold tracking-wide mt-2">
      Checkout unavailable. Email rainers@theerainers.com
    </p>
  </div>
</div>
