---
import Layout from '../layouts/Base.astro';
import Testimonials from '../components/site/Testimonials.astro';

const productSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "The Footwork Blueprint",
  "description": "Win Fights with Footwork. A practical playbook to move with balance, control, and intent. 56 rounds of drills, Foundations Footwork video, 30-Day Base Training Structure.",
  "url": "https://theerainers.com/footwork-blueprint",
  "image": "https://theerainers.com/images/3d_thefootworkblueprint_cover.jpg",
  "brand": { "@type": "Brand", "name": "Thee Rainers" },
  "offers": {
    "@type": "Offer",
    "price": "47.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://buy.stripe.com/bJe14n8lt81ogyu3VW6J20k",
  },
});
---
<Layout
  title="The Footwork Blueprint: Full Bases Video Breakdown + 56 Rounds of Drills + 30-Day Structure"
  description="Win fights with footwork. 56 rounds of drills, Foundations Footwork video, 30-Day base training structure. Orthodox and southpaw. $47.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={productSchema} />
  </Fragment>

  <!-- HERO -->
  <section class="bg-white border-b border-[#0A0A0A]/8 pt-28 md:pt-36 pb-16 md:pb-20">
    <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 grid grid-cols-1 md:grid-cols-[58%_42%] gap-10 md:gap-16 items-center">

      <!-- Left: copy -->
      <div>
        <p class="text-[#D4A373] text-[11px] tracking-widest uppercase mb-4">Blueprint</p>
        <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.88] mb-6"
          style="font-size: clamp(2.5rem, 5.5vw, 4.25rem);">
          The Footwork<br/>Blueprint.
        </h1>
        <p class="text-[#0A0A0A]/60 text-base md:text-lg leading-relaxed mb-8 max-w-[520px]">
          Win fights with footwork. A practical playbook to help you move with balance, control, and intent. Not random bouncing. Not wasted steps.
        </p>

        <!-- Sales count — trust signal pulled from Gumroad history -->
        <div class="inline-flex items-center gap-2 mb-5 px-3 py-1.5 border border-[#0057FF]/30 bg-[#0057FF]/5">
          <span class="w-2 h-2 rounded-full bg-[#0057FF] animate-pulse"></span>
          <p class="text-[11px] tracking-widest uppercase font-bold text-[#0057FF]">114 fighters bought this</p>
        </div>

        <!-- Price + primary CTA -->
        <div class="flex flex-col gap-3 mb-6 max-w-[420px]">
          <div class="flex items-baseline gap-3">
            <span class="font-black text-[#0A0A0A] text-4xl">$47</span>
            <span class="text-[#0A0A0A]/40 text-xs uppercase tracking-widest">One time</span>
          </div>
          <a href="https://buy.stripe.com/bJe14n8lt81ogyu3VW6J20k"
            class="inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[#0057FF] text-white font-bold px-8 py-4 text-sm tracking-wide uppercase hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4A373] focus-visible:ring-offset-2">
            Get the Footwork Blueprint →
          </a>
        </div>

        <!-- Specs (Gumroad-style fact sheet) -->
        <div class="max-w-[420px] border-t border-[#0A0A0A]/10">
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold">Pages</span>
            <span class="text-[#0A0A0A] text-sm font-bold">21</span>
          </div>
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold">Delivery</span>
            <span class="text-[#0A0A0A] text-sm font-bold">Instant digital download</span>
          </div>
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold">Access perks</span>
            <span class="text-[#0A0A0A] text-sm font-bold">14-day Community trial</span>
          </div>
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold">Language</span>
            <span class="text-[#0A0A0A] text-sm font-bold">English &amp; Spanish</span>
          </div>
          <div class="flex justify-between items-baseline py-3">
            <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold">
              Video breakdown
              <span class="text-[#0057FF] text-[9px] ml-1">NEW</span>
            </span>
            <span class="text-[#0A0A0A] text-sm font-bold">11 min</span>
          </div>
        </div>
      </div>

      <!-- Right: 3D cover -->
      <div class="order-first md:order-last">
        <div class="relative bg-[#F6F6F6] border border-[#0A0A0A]/10 mx-auto max-w-[420px]">
          <img src="/images/3d_thefootworkblueprint_cover.jpg" alt="The Footwork Blueprint"
            width="1600" height="2000"
            class="w-full h-auto object-contain" />
        </div>
      </div>

    </div>
  </section>

  <!-- WHAT'S IN IT — Gumroad-style flat bullet list -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[720px] mx-auto">
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.95] mb-8">
        What's in it?
      </h2>

      <ul class="flex flex-col gap-7 text-[#0A0A0A]/80 text-base leading-relaxed">

        <li>
          <p class="flex gap-3 font-bold text-[#0A0A0A]">
            <span class="text-[#D4A373] shrink-0">◆</span>
            <span>Foundations Footwork Video <span class="text-[#0057FF] text-xs tracking-widest uppercase ml-1">New</span></span>
          </p>
          <p class="ml-7 mt-2 text-[#0A0A0A]/70">A clear explanation of footwork:</p>
          <ul class="ml-7 mt-2 flex flex-col gap-1.5 text-[#0A0A0A]/75 text-sm">
            <li class="flex gap-2"><span class="text-[#0A0A0A]/40 shrink-0">•</span>How to step and punch without breaking your stance</li>
            <li class="flex gap-2"><span class="text-[#0A0A0A]/40 shrink-0">•</span>How weight transfer affects power and recovery</li>
            <li class="flex gap-2"><span class="text-[#0A0A0A]/40 shrink-0">•</span>How elite fighters stay balanced while moving, striking, and resetting</li>
          </ul>
          <p class="ml-7 mt-3 text-[#0A0A0A]/65 text-sm italic">This video explains the <strong>logic</strong> behind the drills so you know why you're doing them.</p>
        </li>

        <li>
          <p class="flex gap-3 font-bold text-[#0A0A0A]"><span class="text-[#D4A373] shrink-0">◆</span><span>56 Rounds of Drills to build elite movement (Orthodox &amp; Southpaw)</span></p>
        </li>

        <li>
          <p class="flex gap-3 font-bold text-[#0A0A0A]"><span class="text-[#D4A373] shrink-0">◆</span><span>Used by boxers, kickboxers, MMA strikers &amp; coaches</span></p>
        </li>

        <li>
          <p class="flex gap-3 font-bold text-[#0A0A0A]"><span class="text-[#D4A373] shrink-0">◆</span><span>The full Blueprint in clean, easy-to-follow breakdown</span></p>
        </li>

        <li>
          <p class="flex gap-3 font-bold text-[#0A0A0A]">
            <span class="text-[#D4A373] shrink-0">◆</span>
            <span>30-Day Base Training Structure <span class="text-[#0057FF] text-xs tracking-widest uppercase ml-1">New</span></span>
          </p>
          <p class="ml-7 mt-2 text-[#0A0A0A]/70">A simple 30-Day way to apply the drills correctly instead of guessing. This structure shows you how to run the Blueprint inside your training.</p>
        </li>

        <li>
          <p class="flex gap-3 items-baseline font-bold text-[#0A0A0A]">
            <svg class="text-[#0057FF] shrink-0 w-4 h-4 self-center" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h11c.55 0 1-.45 1-1z"/>
            </svg>
            <span>14 days free inside the Greatness Community</span>
          </p>
          <p class="ml-7 mt-1 text-[#0A0A0A]/70 text-sm">Your first Proving Ground is on us. Bring your work, get a live correction.</p>
        </li>

      </ul>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="bg-[#F6F6F6] px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[920px] mx-auto">
      <p class="text-[#D4A373] text-[11px] tracking-widest uppercase mb-4">Who this is for</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl md:text-4xl leading-[0.9] mb-10">
        Three kinds of athletes.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-[#0A0A0A]/8">
        <div class="bg-white p-8">
          <p class="text-[#D4A373] text-[10px] tracking-widest uppercase mb-3">01</p>
          <p class="text-[#0A0A0A] text-sm leading-relaxed">Boxers and combat athletes who want better balance, angles, and movement.</p>
        </div>
        <div class="bg-white p-8">
          <p class="text-[#D4A373] text-[10px] tracking-widest uppercase mb-3">02</p>
          <p class="text-[#0A0A0A] text-sm leading-relaxed">Fighters who feel stiff, flat-footed, or inconsistent when moving.</p>
        </div>
        <div class="bg-white p-8">
          <p class="text-[#D4A373] text-[10px] tracking-widest uppercase mb-3">03</p>
          <p class="text-[#0A0A0A] text-sm leading-relaxed">Coaches who want a simple footwork structure they can reuse.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT CHANGES YOU -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[920px] mx-auto">
      <p class="text-[#D4A373] text-[11px] tracking-widest uppercase mb-4">How it changes you</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl md:text-4xl leading-[0.9] mb-12">
        Five gains that compound.
      </h2>
      <ul class="flex flex-col divide-y divide-[#0A0A0A]/8">
        <li class="py-6 flex gap-6 items-baseline">
          <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold shrink-0 w-12">01</span>
          <span class="text-[#0A0A0A] text-base leading-relaxed">You learn to keep balance while moving and throwing punches. Detailed stance plus mechanics foundation.</span>
        </li>
        <li class="py-6 flex gap-6 items-baseline">
          <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold shrink-0 w-12">02</span>
          <span class="text-[#0A0A0A] text-base leading-relaxed">You learn to transfer force from the feet.</span>
        </li>
        <li class="py-6 flex gap-6 items-baseline">
          <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold shrink-0 w-12">03</span>
          <span class="text-[#0A0A0A] text-base leading-relaxed">You learn to control the center of the ring.</span>
        </li>
        <li class="py-6 flex gap-6 items-baseline">
          <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold shrink-0 w-12">04</span>
          <span class="text-[#0A0A0A] text-base leading-relaxed">You learn to apply pressure and escape it.</span>
        </li>
        <li class="py-6 flex gap-6 items-baseline">
          <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold shrink-0 w-12">Bonus</span>
          <span class="text-[#0A0A0A] text-base leading-relaxed">You learn the formula for choosing the best drills for progress without wasting time.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- VALUE -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[720px] mx-auto">
      <p class="text-[#D4A373] text-[11px] tracking-widest uppercase mb-4">How can I make sure it has value?</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl md:text-4xl leading-[0.9] mb-6">
        Buy once. Train forever.
      </h2>
      <ul class="flex flex-col gap-3 text-[#0A0A0A]/70 text-base leading-relaxed">
        <li class="flex gap-3"><span class="text-[#D4A373] font-bold shrink-0">·</span>You can open the blueprint even 5 years later, pick drills and train.</li>
        <li class="flex gap-3"><span class="text-[#D4A373] font-bold shrink-0">·</span>You save time by learning the way top fighters train.</li>
      </ul>
    </div>
  </section>

  <!-- WHY ME -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[720px] mx-auto">
      <p class="text-[#D4A373] text-[11px] tracking-widest uppercase mb-4">Why me</p>
      <p class="text-[#0A0A0A] text-lg md:text-xl font-bold leading-snug mb-3">It's not about me.</p>
      <p class="text-[#0A0A0A]/70 text-base leading-relaxed mb-3">I gathered top fighters and coaches knowledge in one place to give you the skills needed to win.</p>
      <p class="text-[#0A0A0A]/70 text-base leading-relaxed">These drills are tested and proven.</p>
    </div>
  </section>

  <!-- WHO GETS THE MOST OUT OF IT -->
  <section class="bg-[#F6F6F6] px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[720px] mx-auto">
      <p class="text-[#D4A373] text-[11px] tracking-widest uppercase mb-4">Who gets the most out of it</p>
      <p class="text-[#0A0A0A] text-lg leading-relaxed">
        People who have wasted so much time watching YouTube instructions and want effective training that lasts.
      </p>
    </div>
  </section>

  <!-- PROOF (remote students who trained from the blueprint) -->
  <Testimonials filter="remote" heading="Trained from the blueprint" kicker="Results · On Their Own" />

  <!-- HESITATION -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-20 border-b border-t border-[#0A0A0A]/8">
    <div class="max-w-[720px] mx-auto">
      <p class="text-[#D4A373] text-[11px] tracking-widest uppercase mb-4">If you are hesitating</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.9] mb-6">
        "I do not have space for footwork drills in my plan."
      </h2>
      <p class="text-[#0A0A0A]/65 text-base leading-relaxed mb-3">
        Reduce other workouts by 20%. Do footwork in that 20%.
      </p>
      <p class="text-[#0A0A0A]/55 text-base leading-relaxed">
        Inside a week, you feel the difference in your movement, your attacks, and your defense.
      </p>
    </div>
  </section>

  <!-- BONUSES -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[920px] mx-auto">
      <p class="text-[#D4A373] text-[11px] tracking-widest uppercase mb-4">Bonuses</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl md:text-4xl leading-[0.9] mb-10">
        What ships with it.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-5">
        <div class="flex gap-3 items-baseline">
          <span class="text-[#0057FF] font-bold text-sm shrink-0">·</span>
          <p class="text-[#0A0A0A]/80 text-sm leading-relaxed">ENG + ESP versions.</p>
        </div>
        <div class="flex gap-3 items-baseline">
          <span class="text-[#0057FF] font-bold text-sm shrink-0">·</span>
          <p class="text-[#0A0A0A]/80 text-sm leading-relaxed">Loom Video Breakdown: 4 Bases Explained.</p>
        </div>
        <div class="flex gap-3 items-baseline">
          <span class="text-[#0057FF] font-bold text-sm shrink-0">·</span>
          <p class="text-[#0A0A0A]/80 text-sm leading-relaxed">Early-buyer discount.</p>
        </div>
        <div class="flex gap-3 items-baseline">
          <span class="text-[#0057FF] font-bold text-sm shrink-0">·</span>
          <p class="text-[#0A0A0A]/80 text-sm leading-relaxed">Solo training, gym warmups, and skill-gap work.</p>
        </div>
        <div class="flex gap-3 items-baseline">
          <span class="text-[#0057FF] font-bold text-sm shrink-0">·</span>
          <p class="text-[#0A0A0A]/80 text-sm leading-relaxed">Lifetime access plus future minor updates.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-[#F6F6F6] px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[680px] mx-auto text-center">
      <p class="text-[#D4A373] text-[11px] tracking-widest uppercase mb-4">Access the Blueprint</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl md:text-5xl leading-[0.9] mb-8">
        Start with the base.
      </h2>
      <div class="flex items-baseline justify-center gap-3 mb-6">
        <span class="font-black text-[#0A0A0A] text-4xl">$47</span>
        <span class="text-[#0A0A0A]/40 text-xs uppercase tracking-widest">One time</span>
      </div>
      <a href="https://buy.stripe.com/bJe14n8lt81ogyu3VW6J20k"
        class="inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[#0057FF] text-white font-bold px-10 py-4 text-sm tracking-wide uppercase hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4A373] focus-visible:ring-offset-2">
        Get the Footwork Blueprint →
      </a>
      <p class="text-[11px] text-[#0A0A0A]/55 mt-4">114 fighters bought this. Instant digital download.</p>

      <!-- Cross-sell -->
      <div class="mt-12 pt-10 border-t border-[#0A0A0A]/10 flex flex-col sm:flex-row items-center justify-center gap-4 text-xs">
        <span class="text-[#0A0A0A]/40 uppercase tracking-widest">Or</span>
        <a href="/bundle" class="text-[#0057FF] font-bold tracking-widest uppercase hover:text-[#0A0A0A] transition-colors">Get both with Shadowboxing — $87 →</a>
      </div>
    </div>
  </section>

  <!-- SCRIPTURE -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-20">
    <div class="max-w-[680px] mx-auto">
      <p class="font-black uppercase tracking-tighter leading-[0.88] text-white/50 text-2xl md:text-3xl mb-4">
        "I do not run aimlessly. I do not box as one beating the air."
      </p>
      <p class="text-[#D4A373] text-[10px] tracking-widest uppercase">1 Corinthians 9:26-27</p>
    </div>
  </section>

</Layout>
