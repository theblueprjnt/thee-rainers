---
import LinkPage from '../layouts/LinkPage.astro';
---
<LinkPage title="7-Lever Audit — Thee Rainers">

<div id="quiz">

  <!-- Progress bar -->
  <div id="progress-rail" class="hidden fixed top-0 left-0 right-0 h-[2px] bg-[#0A0A0A]/8 z-50">
    <div id="progress-fill" class="h-full bg-[#0057FF] transition-[width] duration-500 ease-out" style="width:0%"></div>
  </div>

  <!-- ── INTRO ── -->
  <div id="s-intro" class="screen active fixed inset-0 overflow-y-auto flex flex-col items-center justify-center px-6 py-16">
    <div class="w-full max-w-[440px]">
      <p class="text-[#D4A373] text-[10px] tracking-[0.2em] uppercase mb-10">Thee Rainers · For Competitors</p>
      <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.82] mb-8"
          style="font-size: clamp(3.5rem, 10vw, 5.5rem);">
        7-Lever<br/>Audit
      </h1>
      <p class="text-[#0A0A0A]/50 text-base leading-relaxed mb-4 max-w-[340px]">
        Seven questions. Find the lever that is capping your system before your next fight.
      </p>
      <p class="text-[#0A0A0A]/30 text-sm leading-relaxed mb-12 max-w-[340px]">
        Rate yourself as the sparring version — not the drilling version.
      </p>
      <button id="btn-start"
        class="group inline-flex items-center justify-center w-full font-bold bg-[#0A0A0A] text-white px-10 py-5 text-sm tracking-widest uppercase transition-colors duration-150 hover:bg-[#0057FF] active:bg-[#0057FF]/90 cursor-pointer border-none focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4A373] focus-visible:ring-offset-2">
        Begin Audit
        <span class="ml-3 transition-transform duration-150 group-hover:translate-x-1">→</span>
      </button>
    </div>
  </div>

  <!-- ── QUESTION ── -->
  <div id="s-levers" class="screen fixed inset-0 overflow-y-auto flex flex-col items-center justify-center px-6 py-20">
    <div class="w-full max-w-[480px]">

      <div class="flex items-center justify-between mb-10">
        <p id="lev-num" class="text-[#D4A373] text-[10px] tracking-[0.2em] uppercase">01</p>
        <p id="lev-progress" class="text-[#0A0A0A]/25 text-[10px] tracking-[0.15em] uppercase">1 of 7</p>
      </div>

      <p id="lev-name" class="text-[#0A0A0A]/30 text-xs tracking-widest uppercase mb-4">Cue Reading</p>
      <h2 id="lev-question"
        class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.88] mb-12"
        style="font-size: clamp(1.75rem, 4.5vw, 2.5rem);">
        Question text
      </h2>

      <div id="lev-ratings" class="flex gap-2 mb-4"></div>

      <div class="flex justify-between">
        <span class="text-[9px] text-[#0A0A0A]/25 tracking-wide uppercase">Breaks every time</span>
        <span class="text-[9px] text-[#0A0A0A]/25 tracking-wide uppercase">Completely automatic</span>
      </div>

    </div>
  </div>

  <!-- ── EMAIL GATE ── -->
  <div id="s-email" class="screen fixed inset-0 overflow-y-auto flex flex-col items-center justify-center px-6 py-16">
    <div class="w-full max-w-[400px]">
      <div class="w-8 h-[2px] bg-[#0057FF] mb-10"></div>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.85] mb-4"
          style="font-size: clamp(2rem, 6vw, 3rem);">
        Results<br/>are ready.
      </h2>
      <p class="text-[#0A0A0A]/40 text-sm leading-relaxed mb-10 max-w-[300px]">
        Enter your email to unlock your score and download the full PDF audit.
      </p>
      <form id="email-form" class="flex flex-col gap-3">
        <input type="email" id="gate-email" required placeholder="your@email.com"
          class="w-full border border-[#0A0A0A]/15 bg-transparent px-5 py-4 text-[#0A0A0A] text-sm focus:border-[#0A0A0A] focus:outline-none transition-colors duration-200 placeholder:text-[#0A0A0A]/20" />
        <button type="submit" id="btn-results"
          class="inline-flex items-center justify-center font-bold bg-[#0057FF] text-white px-8 py-4 text-sm tracking-widest uppercase transition-colors duration-150 hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 cursor-pointer border-none focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4A373] focus-visible:ring-offset-2">
          See My Results →
        </button>
      </form>
      <p class="text-[#0A0A0A]/20 text-[10px] tracking-wide mt-5 uppercase">PDF downloads automatically</p>
    </div>
  </div>

  <!-- ── RESULTS ── -->
  <div id="s-results" class="screen fixed inset-0 overflow-y-auto">
    <div class="flex flex-col items-center px-6 py-20">
      <div class="w-full max-w-[440px]">

        <!-- Score -->
        <p class="text-[#D4A373] text-[10px] tracking-[0.2em] uppercase mb-6">Your Results</p>
        <div class="flex items-baseline gap-2 mb-2">
          <span id="res-total" class="font-black text-[#0A0A0A] leading-none tracking-tighter"
            style="font-size: clamp(4rem, 16vw, 7rem);">—</span>
          <span class="text-[#0A0A0A]/20 font-black text-3xl">/35</span>
        </div>
        <p id="res-verdict" class="text-[#0A0A0A]/45 text-sm leading-relaxed mb-12 max-w-[340px]">—</p>

        <!-- Primary constraint -->
        <div class="border-l-[3px] border-[#D4A373] pl-5 mb-12">
          <p class="text-[#D4A373] text-[10px] tracking-[0.18em] uppercase mb-2">Primary Constraint</p>
          <p id="res-constraint" class="font-black text-[#0A0A0A] uppercase tracking-tight text-xl leading-tight">—</p>
          <p class="text-[#0A0A0A]/35 text-xs leading-relaxed mt-2 max-w-[300px]">Fix this first. Every improvement compounds on it.</p>
        </div>

        <!-- Lever bars -->
        <div id="res-bars" class="flex flex-col gap-3 mb-12"></div>

        <!-- Separator -->
        <div class="border-t border-[#0A0A0A]/8 mb-10"></div>

        <!-- CTA -->
        <p class="text-[#0A0A0A]/30 text-[10px] tracking-widest uppercase mb-5">Recommended next step</p>
        <a id="res-cta" href="/"
          class="w-full inline-flex items-center justify-center font-bold bg-[#0057FF] text-white px-8 py-5 text-sm tracking-widest uppercase transition-colors duration-150 hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 mb-4">
          —
        </a>
        <a href="/pdfs/lever-audit.pdf" download="7-Lever-Audit-Thee-Rainers.pdf"
          class="block text-center text-[10px] text-[#0A0A0A]/25 tracking-widest uppercase hover:text-[#0A0A0A]/50 transition-colors duration-200 py-2">
          Download PDF again →
        </a>

        <!-- Private Architecture -->
        <div class="border border-[#6A0DAD]/15 p-6 mt-8">
          <p class="text-[#6A0DAD] text-[10px] tracking-widest uppercase mb-2">Application Only</p>
          <p class="text-[#0A0A0A]/50 text-xs leading-relaxed mb-4">Private Architecture deploys all seven levers as one system — built around your specific structure and fight schedule.</p>
          <a href="/command" class="text-[#6A0DAD]/70 text-[10px] tracking-widest uppercase hover:text-[#6A0DAD] transition-colors duration-200">See Private Architecture →</a>
        </div>

        <!-- Scripture -->
        <p class="text-[#0A0A0A]/10 text-[10px] tracking-widest uppercase text-center mt-12">1 Corinthians 9:26–27</p>

      </div>
    </div>
  </div>

</div>

<style>
  html, body { height: 100%; overflow: hidden; }

  #quiz { position: fixed; inset: 0; background: #FFFFFF; }

  /* All screens hidden by default */
  .screen {
    display: none;
    opacity: 0;
  }

  /* Active screen fades + slides in */
  .screen.active {
    display: flex;
    animation: screenIn 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* Results screen scrolls, so allow body scroll when it's active */
  #s-results.active {
    display: block;
    overflow-y: auto;
  }

  @keyframes screenIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Rating buttons */
  .rating-btn {
    flex: 1;
    min-height: 60px;
    border: 1.5px solid rgba(10,10,10,0.12);
    background: transparent;
    font-family: inherit;
    font-weight: 800;
    font-size: 1.05rem;
    color: rgba(10,10,10,0.35);
    cursor: pointer;
    transition: border-color 0.12s ease, color 0.12s ease, background 0.12s ease, transform 0.1s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    -webkit-user-select: none;
  }

  .rating-btn:hover {
    border-color: rgba(10,10,10,0.5);
    color: rgba(10,10,10,0.8);
    transform: translateY(-1px);
  }

  .rating-btn.selected {
    background: #0A0A0A;
    border-color: #0A0A0A;
    color: #FFFFFF;
    transform: none;
  }

  /* Lever bars */
  .lever-bar {
    display: grid;
    grid-template-columns: 130px 1fr 28px;
    align-items: center;
    gap: 10px;
  }

  .lbr-label {
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(10,10,10,0.35);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 600;
  }

  .lever-bar.is-primary .lbr-label { color: #D4A373; font-weight: 800; }
  .lever-bar.is-primary .lbr-fill  { background: #D4A373; }

  .lbr-track {
    height: 2px;
    background: rgba(10,10,10,0.06);
    overflow: hidden;
  }

  .lbr-fill {
    height: 100%;
    background: #0A0A0A;
    transition: width 0.7s cubic-bezier(0.16,1,0.3,1);
  }

  .lbr-score {
    font-size: 11px;
    font-weight: 800;
    color: rgba(10,10,10,0.25);
    text-align: right;
  }

  .lever-bar.is-primary .lbr-score { color: #D4A373; }
</style>

<script>
  const LEVERS = [
    { num: '01', name: 'Cue Reading',             q: 'In sparring — do you see punches arriving, or feel them landing?' },
    { num: '02', name: 'Kinetic Chain',            q: 'Do your punches come from your legs and hip — or your shoulder and arm?' },
    { num: '03', name: 'Reactive Stiffness',       q: 'Does your footwork feel springy by round 4 — or flat and heavy?' },
    { num: '04', name: 'Range Fluency',            q: 'Can you generate offence at all three ranges — or do you have one home?' },
    { num: '05', name: 'Defensive Responsibility', q: 'When you throw combinations — does your guard hold, or does your chin get exposed?' },
    { num: '06', name: 'Transfer to Live',         q: 'Is your sparring the same standard as your pad work — or does pressure strip the technique?' },
    { num: '07', name: 'Identity & Presence',      q: 'When hurt and behind — do you fight your system, or contract and wait for the round to end?' },
  ];

  const ROUTES: Record<string, { verdict: string; url: string; cta: string }> = {
    foundation: { verdict: 'The base layer needs work before the system can compound.',        url: '/footwork-foundation', cta: 'Start the 30-Day Foundation Protocol →' },
    workshop:   { verdict: 'The mechanics are there. One session locks them into structure.',  url: '/workshop',            cta: 'Reserve Your Workshop Seat →' },
    command:    { verdict: 'Your system is close. One lever is capping everything above it.', url: '/command',             cta: 'Apply for Private Architecture →' },
  };

  const answers: number[] = new Array(7).fill(0);
  let current = 0;

  function show(id: string) {
    document.querySelectorAll<HTMLElement>('.screen').forEach(s => {
      s.classList.remove('active');
    });
    const el = document.getElementById(id);
    if (el) el.classList.add('active');
    // Allow scroll on results, lock on others
    if (id === 's-results') {
      document.documentElement.style.overflow = 'auto';
      document.body.style.overflow = 'auto';
      document.getElementById('quiz')!.style.position = 'relative';
      document.getElementById('quiz')!.style.height = 'auto';
    } else {
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      document.getElementById('quiz')!.style.position = 'fixed';
      document.getElementById('quiz')!.style.height = '';
    }
    window.scrollTo(0, 0);
  }

  function setProgress(done: number) {
    const rail = document.getElementById('progress-rail');
    const fill = document.getElementById('progress-fill');
    if (done > 0) rail?.classList.remove('hidden');
    if (fill) fill.style.width = `${(done / 7) * 100}%`;
  }

  function renderLever(i: number) {
    const l = LEVERS[i];
    const numEl    = document.getElementById('lev-num');
    const nameEl   = document.getElementById('lev-name');
    const qEl      = document.getElementById('lev-question');
    const progEl   = document.getElementById('lev-progress');
    const ratingsEl = document.getElementById('lev-ratings');

    if (numEl)   numEl.textContent   = l.num;
    if (nameEl)  nameEl.textContent  = l.name;
    if (qEl)     qEl.textContent     = l.q;
    if (progEl)  progEl.textContent  = `${i + 1} of 7`;

    if (ratingsEl) {
      ratingsEl.innerHTML = [1, 2, 3, 4, 5].map(v => `
        <button class="rating-btn${answers[i] === v ? ' selected' : ''}"
          data-lever="${i}" data-val="${v}" type="button" aria-label="Rate ${v} out of 5">
          ${v}
        </button>
      `).join('');

      ratingsEl.querySelectorAll<HTMLButtonElement>('.rating-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const lever = parseInt(btn.dataset.lever ?? '0');
          const val   = parseInt(btn.dataset.val   ?? '1');
          answers[lever] = val;
          ratingsEl.querySelectorAll('.rating-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          setTimeout(() => {
            if (lever < 6) {
              current = lever + 1;
              renderLever(current);
            } else {
              setProgress(7);
              show('s-email');
            }
          }, 240);
        });
      });
    }

    setProgress(i);
    show('s-levers');
  }

  function showResults() {
    const total  = answers.reduce((a, b) => a + b, 0);
    const minVal = Math.min(...answers);
    const minIdx = answers.indexOf(minVal);

    const route = total <= 16 ? ROUTES.foundation
                : total <= 27 ? ROUTES.workshop
                : ROUTES.command;

    const totalEl      = document.getElementById('res-total');
    const verdictEl    = document.getElementById('res-verdict');
    const constraintEl = document.getElementById('res-constraint');
    const ctaEl        = document.getElementById('res-cta') as HTMLAnchorElement | null;
    const barsEl       = document.getElementById('res-bars');

    if (totalEl)      totalEl.textContent      = String(total);
    if (verdictEl)    verdictEl.textContent    = route.verdict;
    if (constraintEl) constraintEl.textContent = LEVERS[minIdx].name;
    if (ctaEl)        { ctaEl.textContent = route.cta; ctaEl.href = route.url; }

    if (barsEl) {
      barsEl.innerHTML = LEVERS.map((l, i) => `
        <div class="lever-bar${i === minIdx ? ' is-primary' : ''}">
          <span class="lbr-label">${l.num} ${l.name}</span>
          <div class="lbr-track">
            <div class="lbr-fill" style="width:0%" data-target="${(answers[i] / 5) * 100}%"></div>
          </div>
          <span class="lbr-score">${answers[i]}</span>
        </div>
      `).join('');

      // Animate bars in after render
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          barsEl.querySelectorAll<HTMLElement>('.lbr-fill').forEach(el => {
            el.style.width = el.dataset.target ?? '0%';
          });
        });
      });
    }

    show('s-results');

    // PDF download
    const a = document.createElement('a');
    a.href = '/pdfs/lever-audit.pdf';
    a.download = '7-Lever-Audit-Thee-Rainers.pdf';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  function initLeverAuditQuiz() {
    const form = document.getElementById('email-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    show('s-intro');

    document.getElementById('btn-start')?.addEventListener('click', () => {
      current = 0;
      renderLever(0);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btn-results') as HTMLButtonElement | null;
      if (btn) { btn.disabled = true; btn.textContent = 'Loading...'; }
      const email = (document.getElementById('gate-email') as HTMLInputElement)?.value.trim();
      try {
        await fetch('/api/lead-capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'lever-audit-quiz', full_name: '' }),
        });
        (window as any).trackEvent?.('generate_lead', { lead_source: 'lever-audit-quiz', currency: 'USD', value: 0 });
      } catch {
        // Non-blocking — show results regardless
      }
      showResults();
    });
  }

  initLeverAuditQuiz();
  document.addEventListener('astro:page-load', initLeverAuditQuiz);
</script>

</LinkPage>
