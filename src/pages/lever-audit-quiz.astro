---
import LinkPage from '../layouts/LinkPage.astro';
---
<LinkPage title="7-Lever Audit — Thee Rainers">

<div id="quiz">

  <!-- Progress bar -->
  <div id="progress-rail" class="hidden fixed top-0 left-0 right-0 h-[2px] bg-[#0A0A0A]/8 z-50">
    <div id="progress-fill" class="h-full bg-[#0057FF] transition-[width] duration-500 ease-out" style="width:0%"></div>
  </div>

  <!-- ── INTRO ── -->
  <div id="s-intro" class="screen active fixed inset-0 overflow-y-auto flex flex-col items-center justify-center px-6 py-10">
    <div class="w-full max-w-[420px]">
      <p class="text-[#926624] text-[10px] tracking-[0.2em] uppercase mb-5">Thee Rainers · For Competitors</p>
      <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.82] mb-5"
          style="font-size: clamp(2.8rem, 8vw, 4.5rem);">
        7-Lever<br/>Audit
      </h1>
      <p class="text-[#0A0A0A]/50 text-sm leading-relaxed mb-2 max-w-[340px]">
        Seven questions. Find the lever capping your system before your next fight.
      </p>
      <p class="text-[#0A0A0A]/30 text-sm leading-relaxed mb-8 max-w-[340px]">
        Rate yourself as the sparring version, not the drilling version.
      </p>
      <button id="btn-start"
        class="group inline-flex items-center justify-center w-full font-bold bg-[#0A0A0A] text-white px-10 py-4 text-sm tracking-widest uppercase transition-colors duration-150 hover:bg-[#0057FF] active:bg-[#0057FF]/90 cursor-pointer border-none focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4A373] focus-visible:ring-offset-2">
        Begin Audit
        <span class="ml-3 transition-transform duration-150 group-hover:translate-x-1">→</span>
      </button>
    </div>
  </div>

  <!-- ── QUESTION ── -->
  <div id="s-levers" class="screen fixed inset-0 overflow-y-auto flex flex-col items-center justify-center px-6 py-10">
    <div class="w-full max-w-[480px]">

      <div class="flex items-center justify-between mb-6">
        <p id="lev-num" class="text-[#926624] text-[10px] tracking-[0.2em] uppercase">01</p>
        <p id="lev-progress" class="text-[#0A0A0A]/25 text-[10px] tracking-[0.15em] uppercase">1 of 7</p>
      </div>

      <p id="lev-name" class="text-[#0A0A0A]/30 text-[10px] tracking-widest uppercase mb-3">Cue Reading</p>
      <h2 id="lev-question"
        class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.9] mb-8"
        style="font-size: clamp(1.25rem, 3.5vw, 1.6rem);">
        Question text
      </h2>

      <div id="lev-ratings" class="flex gap-2 mb-3"></div>

      <div class="flex justify-between">
        <span id="lev-anchor-low"  class="text-[9px] text-[#0A0A0A]/25 tracking-wide uppercase">1 · Not there</span>
        <span id="lev-anchor-high" class="text-[9px] text-[#0A0A0A]/25 tracking-wide uppercase">5 · Automatic</span>
      </div>

    </div>
  </div>

  <!-- ── EMAIL GATE ── -->
  <div id="s-email" class="screen fixed inset-0 overflow-y-auto flex flex-col items-center justify-center px-6 py-10">
    <div class="w-full max-w-[400px]">
      <div class="w-8 h-[2px] bg-[#0057FF] mb-6"></div>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.85] mb-3"
          style="font-size: clamp(1.8rem, 5vw, 2.5rem);">
        Results<br/>are ready.
      </h2>
      <p class="text-[#0A0A0A]/40 text-sm leading-relaxed mb-6 max-w-[300px]">
        Enter your email to unlock your score and download the full PDF audit.
      </p>
      <form id="email-form" class="flex flex-col gap-3">
        <input type="email" id="gate-email" required placeholder="your@email.com"
          class="w-full border border-[#0A0A0A]/15 bg-transparent px-5 py-3 text-[#0A0A0A] text-sm focus:border-[#0A0A0A] focus:outline-none transition-colors duration-200 placeholder:text-[#0A0A0A]/20" />
        <button type="submit" id="btn-results"
          class="inline-flex items-center justify-center font-bold bg-[#0057FF] text-white px-8 py-4 text-sm tracking-widest uppercase transition-colors duration-150 hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 cursor-pointer border-none focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4A373] focus-visible:ring-offset-2">
          See My Results →
        </button>
      </form>
      <p class="text-[#0A0A0A]/20 text-[10px] tracking-wide mt-4 uppercase">PDF downloads automatically</p>
    </div>
  </div>

  <!-- ── RESULTS ── -->
  <div id="s-results" class="screen fixed inset-0 overflow-y-auto">
    <div class="flex flex-col items-center px-6 pt-12 pb-16">
      <div class="w-full max-w-[440px]">

        <!-- Score -->
        <p class="text-[#926624] text-[10px] tracking-[0.2em] uppercase mb-3">Your Results</p>
        <div class="flex items-baseline gap-2 mb-1">
          <span id="res-total" class="font-black text-[#0A0A0A] leading-none tracking-tighter"
            style="font-size: clamp(3.5rem, 14vw, 6rem);">—</span>
          <span class="text-[#0A0A0A]/20 font-black text-2xl">/35</span>
        </div>
        <p id="res-verdict" class="text-[#0A0A0A]/45 text-sm leading-relaxed mb-8 max-w-[340px]">—</p>

        <!-- Primary constraint -->
        <div class="border-l-[3px] border-[#D4A373] pl-5 mb-8">
          <p class="text-[#926624] text-[10px] tracking-[0.18em] uppercase mb-2">Primary Constraint</p>
          <p id="res-constraint" class="font-black text-[#0A0A0A] uppercase tracking-tight text-lg leading-tight mb-2">—</p>
          <p id="res-impact" class="text-[#0A0A0A]/45 text-sm leading-relaxed">—</p>
        </div>

        <!-- Lever bars -->
        <div id="res-bars" class="flex flex-col gap-[10px] mb-8"></div>

        <!-- Separator -->
        <div class="border-t border-[#0A0A0A]/8 mb-7"></div>

        <!-- CTA -->
        <p class="text-[#0A0A0A]/30 text-[10px] tracking-widest uppercase mb-4">Recommended next step</p>
        <a id="res-cta" href="/"
          class="w-full inline-flex items-center justify-center font-bold bg-[#0057FF] text-white px-8 py-4 text-sm tracking-widest uppercase transition-colors duration-150 hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 mb-4">
          ...
        </a>
        <a href="/pdfs/lever-audit.pdf" download="7-Lever-Audit-Thee-Rainers.pdf"
          class="block text-center text-[10px] text-[#0A0A0A]/25 tracking-widest uppercase hover:text-[#0A0A0A]/50 transition-colors duration-200 py-2">
          Download PDF again →
        </a>

        <!-- Private Architecture -->
        <div class="border border-[#6A0DAD]/15 p-6 mt-8">
          <p class="text-[#6A0DAD] text-[10px] tracking-widest uppercase mb-2">Application Only</p>
          <p class="text-[#0A0A0A]/50 text-xs leading-relaxed mb-4">Private Architecture deploys all seven levers as one system — built around your specific structure and fight schedule.</p>
          <a href="/command" class="text-[#6A0DAD]/70 text-[10px] tracking-widest uppercase hover:text-[#6A0DAD] transition-colors duration-200">See Private Architecture →</a>
        </div>

        <!-- Scripture -->
        <p class="text-[#0A0A0A]/10 text-[10px] tracking-widest uppercase text-center mt-12">1 Corinthians 9:26–27</p>

      </div>
    </div>
  </div>

</div>

<style>
  html, body { height: 100%; overflow: hidden; }

  #quiz { position: fixed; inset: 0; background: #FFFFFF; }

  /* All screens hidden by default */
  .screen {
    display: none;
    opacity: 0;
  }

  /* Active screen fades + slides in */
  .screen.active {
    display: flex;
    animation: screenIn 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* Results screen scrolls, so allow body scroll when it's active */
  #s-results.active {
    display: block;
    overflow-y: auto;
  }

  @keyframes screenIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Rating buttons */
  .rating-btn {
    flex: 1;
    min-height: 52px;
    border: 1.5px solid rgba(10,10,10,0.12);
    background: transparent;
    font-family: inherit;
    font-weight: 800;
    font-size: 1.05rem;
    color: rgba(10,10,10,0.35);
    cursor: pointer;
    transition: border-color 0.12s ease, color 0.12s ease, background 0.12s ease, transform 0.1s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    -webkit-user-select: none;
  }

  .rating-btn:hover {
    border-color: rgba(10,10,10,0.5);
    color: rgba(10,10,10,0.8);
    transform: translateY(-1px);
  }

  .rating-btn.selected {
    background: #0A0A0A;
    border-color: #0A0A0A;
    color: #FFFFFF;
    transform: none;
  }

  /* Lever bars */
  .lever-bar {
    display: grid;
    grid-template-columns: 130px 1fr 28px;
    align-items: center;
    gap: 10px;
  }

  .lbr-label {
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(10,10,10,0.35);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 600;
  }

  .lever-bar.is-primary .lbr-label { color: #D4A373; font-weight: 800; }
  .lever-bar.is-primary .lbr-fill  { background: #D4A373; }

  .lbr-track {
    height: 2px;
    background: rgba(10,10,10,0.06);
    overflow: hidden;
  }

  .lbr-fill {
    height: 100%;
    background: #0A0A0A;
    transition: width 0.7s cubic-bezier(0.16,1,0.3,1);
  }

  .lbr-score {
    font-size: 11px;
    font-weight: 800;
    color: rgba(10,10,10,0.25);
    text-align: right;
  }

  .lever-bar.is-primary .lbr-score { color: #D4A373; }
</style>

<script>
  const LEVERS = [
    {
      num: '01', name: 'Cue Reading',
      q: 'Last time you got hit clean in sparring, did you see it coming?',
      low: 'Blind to it', high: 'Read it early',
      impact: 'You are defending after contact. Every slip, roll, and block you practise is reactive. That has a ceiling. Until this is fixed, your defensive ceiling is lower than your opponent\'s offensive floor.',
    },
    {
      num: '02', name: 'Kinetic Chain',
      q: 'Where does your power start? Be honest about the last jab you threw with intent.',
      low: 'Arm and shoulder', high: 'Hip and ground',
      impact: 'Arm-punching caps your output at roughly half your potential force. Footwork improvements, angle work, and combination flow all hit a ceiling here. You can position well and still not hurt anyone.',
    },
    {
      num: '03', name: 'Reactive Stiffness',
      q: 'Round 4, under pressure. How much of your footwork is still loaded and springy versus survival stepping?',
      low: 'Flat and heavy', high: 'Still loaded',
      impact: 'When the legs go, the whole system collapses. Your output drops, your guard gets lazy, and you start absorbing instead of moving. If this is your constraint, conditioning alone will not fix it. The loading mechanism needs work.',
    },
    {
      num: '04', name: 'Range Fluency',
      q: 'How often do you choose your range in sparring versus ending up wherever your opponent puts you?',
      low: 'Wherever they put me', high: 'I dictate it',
      impact: 'If your opponent controls distance, they control the whole fight. You train at one range and fight at whatever they give you. Your offensive game only works at the range you have access to. It may not be the range you practised.',
    },
    {
      num: '05', name: 'Defensive Responsibility',
      q: 'After a combination, where is your guard? Check your sparring footage honestly before you answer.',
      low: 'Dropped and wide', high: 'Back and tight',
      impact: 'Every combination you throw is a trade offer your opponent did not have to accept. You are leaving the door open during the moment you commit most. This is where most stoppages begin.',
    },
    {
      num: '06', name: 'Transfer to Live',
      q: 'Pick one technical thing you have been drilling for at least two weeks. Is it showing up under pressure?',
      low: 'Disappears in sparring', high: 'Transfers cleanly',
      impact: 'You have the technique. You do not have it under pressure yet. The drill has not become a reflex. More repetitions alone will not close this gap. The training environment has to change.',
    },
    {
      num: '07', name: 'Identity & Presence',
      q: 'Hurt, behind on the round, opponent smelling blood. What does your system do?',
      low: 'Shuts down', high: 'Stays structured',
      impact: 'When it matters most, the system is not there. This is not a mental toughness problem in the motivational sense. It is a structural one. Fighters who fragment under adversity have not been trained to maintain their system while hurt. That is a specific skill.',
    },
  ];

  const ROUTES: Record<string, { verdict: string; url: string; cta: string }> = {
    foundation: { verdict: 'Multiple levers are underdeveloped. Stacking specific work on top of this will not compound. The base needs to come first.',        url: '/foundation-guide', cta: 'Get the Footwork Starter →' },
    workshop:   { verdict: 'Your base is there. One session focused on mechanical structure will lock in what the sparring environment keeps stripping.',        url: '/workshop',            cta: 'Reserve Your Workshop Seat →' },
    command:    { verdict: 'Your system is advanced. One lever is capping every improvement above it. This is the level where targeted, personalised work pays most.', url: '/command', cta: 'Apply for Private Architecture →' },
  };

  const answers: number[] = new Array(7).fill(0);
  let current = 0;

  function show(id: string) {
    document.querySelectorAll<HTMLElement>('.screen').forEach(s => {
      s.classList.remove('active');
    });
    const el = document.getElementById(id);
    if (el) el.classList.add('active');
    // Allow scroll on results, lock on others
    if (id === 's-results') {
      document.documentElement.style.overflow = 'auto';
      document.body.style.overflow = 'auto';
      document.getElementById('quiz')!.style.position = 'relative';
      document.getElementById('quiz')!.style.height = 'auto';
    } else {
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      document.getElementById('quiz')!.style.position = 'fixed';
      document.getElementById('quiz')!.style.height = '';
    }
    window.scrollTo(0, 0);
  }

  function setProgress(done: number) {
    const rail = document.getElementById('progress-rail');
    const fill = document.getElementById('progress-fill');
    if (done > 0) rail?.classList.remove('hidden');
    if (fill) fill.style.width = `${(done / 7) * 100}%`;
  }

  function renderLever(i: number) {
    const l = LEVERS[i];
    const numEl    = document.getElementById('lev-num');
    const nameEl   = document.getElementById('lev-name');
    const qEl      = document.getElementById('lev-question');
    const progEl   = document.getElementById('lev-progress');
    const ratingsEl = document.getElementById('lev-ratings');

    if (numEl)   numEl.textContent   = l.num;
    if (nameEl)  nameEl.textContent  = l.name;
    if (qEl)     qEl.textContent     = l.q;
    if (progEl)  progEl.textContent  = `${i + 1} of 7`;

    const anchorLow  = document.getElementById('lev-anchor-low');
    const anchorHigh = document.getElementById('lev-anchor-high');
    if (anchorLow)  anchorLow.textContent  = `1 · ${l.low}`;
    if (anchorHigh) anchorHigh.textContent = `5 · ${l.high}`;

    if (ratingsEl) {
      ratingsEl.innerHTML = [1, 2, 3, 4, 5].map(v => `
        <button class="rating-btn${answers[i] === v ? ' selected' : ''}"
          data-lever="${i}" data-val="${v}" type="button" aria-label="Rate ${v} out of 5">
          ${v}
        </button>
      `).join('');

      ratingsEl.querySelectorAll<HTMLButtonElement>('.rating-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const lever = parseInt(btn.dataset.lever ?? '0');
          const val   = parseInt(btn.dataset.val   ?? '1');
          answers[lever] = val;
          ratingsEl.querySelectorAll('.rating-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          setTimeout(() => {
            if (lever < 6) {
              current = lever + 1;
              renderLever(current);
            } else {
              setProgress(7);
              show('s-email');
            }
          }, 240);
        });
      });
    }

    setProgress(i);
    show('s-levers');
  }

  function showResults() {
    const total  = answers.reduce((a, b) => a + b, 0);
    const minVal = Math.min(...answers);
    const minIdx = answers.indexOf(minVal);

    const route = total <= 16 ? ROUTES.foundation
                : total <= 27 ? ROUTES.workshop
                : ROUTES.command;

    const totalEl      = document.getElementById('res-total');
    const verdictEl    = document.getElementById('res-verdict');
    const constraintEl = document.getElementById('res-constraint');
    const ctaEl        = document.getElementById('res-cta') as HTMLAnchorElement | null;
    const barsEl       = document.getElementById('res-bars');

    if (totalEl)      totalEl.textContent      = String(total);
    if (verdictEl)    verdictEl.textContent    = route.verdict;
    if (constraintEl) constraintEl.textContent = LEVERS[minIdx].name;
    if (ctaEl)        { ctaEl.textContent = route.cta; ctaEl.href = route.url; }

    const impactEl = document.getElementById('res-impact');
    if (impactEl) impactEl.textContent = LEVERS[minIdx].impact;

    if (barsEl) {
      barsEl.innerHTML = LEVERS.map((l, i) => `
        <div class="lever-bar${i === minIdx ? ' is-primary' : ''}">
          <span class="lbr-label">${l.num} ${l.name}</span>
          <div class="lbr-track">
            <div class="lbr-fill" style="width:0%" data-target="${(answers[i] / 5) * 100}%"></div>
          </div>
          <span class="lbr-score">${answers[i]}</span>
        </div>
      `).join('');

      // Animate bars in after render
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          barsEl.querySelectorAll<HTMLElement>('.lbr-fill').forEach(el => {
            el.style.width = el.dataset.target ?? '0%';
          });
        });
      });
    }

    show('s-results');

    // PDF download
    const a = document.createElement('a');
    a.href = '/pdfs/lever-audit.pdf';
    a.download = '7-Lever-Audit-Thee-Rainers.pdf';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  function initLeverAuditQuiz() {
    const form = document.getElementById('email-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    show('s-intro');

    document.getElementById('btn-start')?.addEventListener('click', () => {
      current = 0;
      renderLever(0);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btn-results') as HTMLButtonElement | null;
      if (btn) { btn.disabled = true; btn.textContent = 'Loading...'; }
      const email = (document.getElementById('gate-email') as HTMLInputElement)?.value.trim();
      try {
        await fetch('/api/lead-capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'lever-audit-quiz', full_name: '' }),
        });
        (window as any).trackEvent?.('generate_lead', { lead_source: 'lever-audit-quiz', currency: 'USD', value: 0 });
      } catch {
        // Non-blocking — show results regardless
      }
      showResults();
    });
  }

  initLeverAuditQuiz();
  document.addEventListener('astro:page-load', initLeverAuditQuiz);
</script>

</LinkPage>
