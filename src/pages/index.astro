---
import Layout from '../layouts/Base.astro';
import Testimonials from '../components/site/Testimonials.astro';
import OfferStack from '../components/blocks/OfferStack.astro';
import ProofSection from '../components/blocks/ProofSection.astro';
import Objections from '../components/blocks/Objections.astro';
import GradePricing from '../components/blocks/GradePricing.astro';
import { SOCIAL_STATS } from '../data/social-stats';
import { PRODUCTS } from '../data/products.ts';

const dollars = (cents: number) => `$${(cents / 100).toFixed(0)}`;

const blueprints = [
  { title: 'Footwork Blueprint', price: dollars(PRODUCTS.footwork.priceCents), href: '/foundation', checkoutKey: 'footwork' },
  { title: 'Shadowboxing Blueprint', price: dollars(PRODUCTS.shadowboxing.priceCents), href: '/shadowboxing-blueprint', checkoutKey: 'shadowboxing' },
  { title: 'Complete Bundle', price: dollars(PRODUCTS.bundle.priceCents), href: '/shop', checkoutKey: 'bundle' },
];
---
<Layout
  title="Thee Rainers · Boxing built on structure."
  description="Boxing built on structure, full defense, and safer progress. The foundation most gyms skip. Free Footwork Blueprint, live workshops, and coaching.">

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="relative bg-[#0B0B0C] overflow-hidden" style="min-height: 88svh;">

    <!-- Grayscale portrait — desktop right anchor -->
    <div class="absolute right-0 bottom-0 h-full hidden md:block pointer-events-none select-none" aria-hidden="true">
      <img src="/images/herocropped.webp" alt=""
        class="h-full w-auto object-contain object-bottom"
        style="max-height: 88svh;"
        loading="eager" decoding="async" fetchpriority="high" />
      <div class="absolute inset-y-0 left-0 w-64" style="background: linear-gradient(to right, #0B0B0C 0%, transparent 100%);"></div>
    </div>

    <!-- Mobile: fight photo at low opacity -->
    <div class="absolute inset-0 md:hidden" aria-hidden="true">
      <picture>
        <source srcset="/images/coldfightpic2-opt.webp" type="image/webp" />
        <img src="/images/coldfightpic2-opt.jpg" alt=""
          class="w-full h-full object-cover object-center opacity-25 grayscale"
          loading="eager" decoding="async" fetchpriority="high" />
      </picture>
      <div class="absolute inset-0" style="background: linear-gradient(to top, #0B0B0C 35%, transparent 100%);"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col justify-end md:justify-center px-6 md:px-12 lg:px-20 pb-16 pt-32 md:py-0"
      style="min-height: 88svh; max-width: 56%;">
      <div class="md:max-w-[560px]">
        <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">
          Thee Rainers · Structured Boxing
        </p>
        <h1 class="font-black uppercase tracking-tighter text-white mb-6"
          style="font-size: clamp(3.25rem, 7vw, 6rem); line-height: 0.82;">
          Boxing<br/>through<br/>structure.
        </h1>
        <div class="h-0.5 w-12 bg-[var(--terra)] mb-8"></div>
        <p class="text-white/50 text-base leading-relaxed mb-12 max-w-[400px]">
          Full offense. Full defense. Minimum unnecessary damage.
        </p>
        <a href="#programs" class="tr-btn">
          Find your foundation
        </a>
        <!-- COPY: trust line, owner supplies verified numbers only -->
      </div>
    </div>
  </section>

  <!-- ── SAFE BOXING (adults 30-65) — sits directly on the hero's black ── -->
  <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 py-16 md:py-20">
    <div class="max-w-[720px] mx-auto text-center">
      <h2 class="font-black uppercase tracking-tighter text-white mb-6"
        style="font-size: clamp(2rem, 4vw, 3rem); line-height: 0.95;">
        1:1 Safe Boxing for Adults.
      </h2>
      <p class="text-white/50 text-base leading-relaxed mb-10 max-w-[560px] mx-auto">
        Build a lifelong, no-damage boxing routine in 12 weeks that boosts fitness, protects your joints, and makes boxing your primary stress-management tool.
      </p>
      <a href="/safe-boxing" class="text-white/70 text-[11px] font-bold tracking-widest uppercase hover:text-white transition-colors inline-flex items-center gap-2">
        Learn More <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ── BLUEPRINTS + BUNDLE (compact strip, immediately below) ─────────── -->
  <section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 py-10 md:py-12 border-t border-[#0B0B0C]/8">
    <div class="max-w-[1100px] mx-auto grid grid-cols-1 sm:grid-cols-3 gap-5">
      {blueprints.map(b => (
        <button type="button" data-checkout={b.checkoutKey}
          class="bg-white border border-[#0B0B0C]/10 hover:border-[var(--terra)]/40 transition-colors px-6 py-5 flex items-center justify-between gap-4 text-left cursor-pointer">
          <div>
            <p class="font-black text-[#0B0B0C] uppercase tracking-tight text-sm leading-tight">{b.title}</p>
            <p class="text-[#0B0B0C]/40 text-xs mt-1">{b.price}</p>
          </div>
          <span class="shrink-0 w-8 h-8 rounded-full border border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-sm" aria-hidden="true">→</span>
        </button>
      ))}
    </div>
  </section>

  <!-- ── BEFORE YOU START (old way vs our way) ────────────────────────── -->
  <Objections />

  <!-- ── OFFER STACK ────────────────────────────────────────────────────── -->
  <OfferStack />

  <!-- ── GRADE PRICING ─────────────────────────────────────────────────── -->
  <GradePricing />

  <!-- ── GRADE COACHING PROOF (null on empty) ─────────────────────────── -->
  <ProofSection />

  <!-- ── PROOF ─────────────────────────────────────────────────────────── -->
  <div id="proof" class="scroll-mt-20">
    <Testimonials heading="What fighters say." kicker="Field Report" background="white" />
  </div>

  <!-- ── SCRIPTURE ──────────────────────────────────────────────────────── -->
  <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 py-16 md:py-24">
    <div class="max-w-[640px] mx-auto text-center">
      <p class="font-black uppercase tracking-tighter leading-[0.88] text-white/40 mb-5"
        style="font-size: clamp(1.5rem, 3.5vw, 2.25rem);">
        "I do not run aimlessly. I do not box as one beating the air. I discipline my body and keep it under control."
      </p>
      <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">1 Corinthians 9:26-27</p>
    </div>
  </section>

  <!-- ── FINAL CTA ─────────────────────────────────────────────────────── -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-20 md:py-28 text-center">
    <div class="max-w-[600px] mx-auto">
      <h2 class="font-black uppercase tracking-tighter text-[#0B0B0C] mb-8"
        style="font-size: clamp(2rem, 4vw, 3rem); line-height: 0.95;">
        The system is built. Bring your body.
      </h2>
      <a href="/coaching" class="tr-btn">
        Start Coaching
      </a>
      <p class="mt-6">
        <a href="/foundation" class="text-[var(--navy)] text-[11px] font-bold tracking-widest uppercase hover:opacity-70 transition-opacity">Or start free →</a>
      </p>
    </div>
  </section>

</Layout>
