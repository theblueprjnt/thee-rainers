---
import Layout from '../layouts/Base.astro';
import Testimonials from '../components/site/Testimonials.astro';
import OfferStack from '../components/blocks/OfferStack.astro';
import { SOCIAL_STATS } from '../data/social-stats';
---
<Layout
  title="Thee Rainers · Boxing built on structure."
  description="Boxing built on structure, full defense, and safer progress. The foundation most gyms skip. Free Footwork Blueprint, live workshops, and coaching.">

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="relative bg-[#0B0B0C] overflow-hidden" style="min-height: 100svh;">

    <!-- Grayscale portrait — desktop right anchor -->
    <div class="absolute right-0 bottom-0 h-full hidden md:block pointer-events-none select-none" aria-hidden="true">
      <img src="/images/herocropped.webp" alt=""
        class="h-full w-auto object-contain object-bottom"
        style="max-height: 100svh;"
        loading="eager" decoding="async" fetchpriority="high" />
      <div class="absolute inset-y-0 left-0 w-64" style="background: linear-gradient(to right, #0B0B0C 0%, transparent 100%);"></div>
    </div>

    <!-- Mobile: fight photo at low opacity -->
    <div class="absolute inset-0 md:hidden" aria-hidden="true">
      <img src="/images/coldfightpic2.jpg" alt=""
        class="w-full h-full object-cover object-center opacity-25 grayscale"
        loading="eager" decoding="async" fetchpriority="high" />
      <div class="absolute inset-0" style="background: linear-gradient(to top, #0B0B0C 35%, transparent 100%);"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col justify-end md:justify-center px-6 md:px-12 lg:px-20 pb-20 pt-32 md:py-0"
      style="min-height: 100svh; max-width: 56%;">
      <div class="md:max-w-[560px]">
        <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">
          Thee Rainers · Structured Boxing
        </p>
        <h1 class="font-black uppercase tracking-tighter text-white mb-6"
          style="font-size: clamp(3.25rem, 7vw, 6rem); line-height: 0.82;">
          <!-- DRAFT: voice pass Rainers -->
          Boxing<br/>built on<br/>structure.
        </h1>
        <div class="h-0.5 w-12 bg-[var(--terra)] mb-8"></div>
        <p class="text-white/50 text-base leading-relaxed mb-12 max-w-[400px]">
          <!-- DRAFT: voice pass Rainers -->
          Full offense. Full defense. Minimum unnecessary damage. The foundation most gyms skip.
        </p>
        <a href="#programs" class="tr-btn">
          Get to work
        </a>
      </div>
    </div>
  </section>

  <!-- ── OFFER STACK ────────────────────────────────────────────────────── -->
  <OfferStack />

  <!-- ── FREE SUPPORT BLOCK ────────────────────────────────────────────── -->
  <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 py-20 md:py-28">
    <div class="max-w-[680px] mx-auto text-center">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">Start here</p>
      <h2 class="font-black text-white uppercase tracking-tighter leading-[0.86] mb-6"
        style="font-size: clamp(2rem, 4vw, 3.25rem);">
        <!-- DRAFT: voice pass Rainers -->
        Not ready to buy.<br/>Start free.
      </h2>
      <div class="h-0.5 w-10 bg-[var(--terra)] mx-auto mb-8"></div>
      <p class="text-white/45 text-sm leading-relaxed mb-10 max-w-[420px] mx-auto">
        <!-- DRAFT: voice pass Rainers -->
        The Footwork Blueprint is free. 21 pages. 56 drills. The base the paid work builds on.
      </p>
      <a href="/foundation" class="tr-btn">
        Get the Free Blueprint
      </a>
    </div>
  </section>

  <!-- ── PROOF ─────────────────────────────────────────────────────────── -->
  <div id="proof" class="scroll-mt-20">
    <Testimonials heading="What fighters say." kicker="Field Report" background="white" />
  </div>

  <!-- ── SCRIPTURE ──────────────────────────────────────────────────────── -->
  <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 py-16 md:py-24">
    <div class="max-w-[640px] mx-auto text-center">
      <p class="font-black uppercase tracking-tighter leading-[0.88] text-white/40 mb-5"
        style="font-size: clamp(1.5rem, 3.5vw, 2.25rem);">
        "I do not run aimlessly. I do not box as one beating the air. I discipline my body and keep it under control."
      </p>
      <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">1 Corinthians 9:26-27</p>
    </div>
  </section>

</Layout>
