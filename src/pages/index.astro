---
import Layout from '../layouts/Base.astro';
import Testimonials from '../components/site/Testimonials.astro';
import { SOCIAL_STATS } from '../data/social-stats';
import { WORKSHOP_DATE_LONG, WORKSHOP_DATE_SHORT } from '../data/workshop.ts';
---
<Layout title="Thee Rainers · Better training. Better results.">

  <!-- HERO — mobile: clean photo on top, dark stage below. Desktop: 60/40. -->
  <section class="relative overflow-hidden border-b border-[#0A0A0A]/8 bg-[#0A0A0A] md:bg-white">

    <!-- ── MOBILE LAYOUT ──────────────────────────────────────────────── -->
    <div class="md:hidden flex flex-col">
      <!-- Photo strip — clean, no text overlay, anchored to boxer's face -->
      <div class="relative w-full bg-[#0A0A0A] mt-16" style="height: 56svh; min-height: 360px;">
        <img src="/images/coldfightpic2.jpg" alt="Thee Rainers · Boxer"
          width="2280" height="2203"
          class="absolute inset-0 w-full h-full object-cover"
          style="object-position: 60% 30%;"
          loading="eager" decoding="async" fetchpriority="high" />
        <!-- Subtle vignette so the gradient CTA below has visual continuity -->
        <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-24"
          style="background: linear-gradient(to top, #0A0A0A, transparent);"></div>
      </div>

      <!-- Content stage — solid black, generous padding, no overlap -->
      <div class="bg-[#0A0A0A] px-7 pt-8 pb-12">
        <p class="text-[var(--ink-soft)] text-[11px] tracking-widest uppercase mb-4">Boxing Tech · @theerainers</p>
        <h1 class="font-black uppercase tracking-tighter mb-5 text-white"
          style="font-size: clamp(2.5rem, 11vw, 3.5rem); line-height: 0.86;">
          Engineered<br/>for the ring.
        </h1>
        <p class="text-white/55 mb-8 max-w-[340px] text-sm leading-relaxed">
          The technical foundation most gyms skip. Step by step.
        </p>
        <div class="flex flex-col gap-3">
          <a href="/workshop"
            class="tr-gradient-cta inline-flex items-center justify-center rounded-none whitespace-nowrap text-white font-bold px-6 py-4 text-[13px] tracking-wide uppercase transition-transform duration-150 active:translate-y-px focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--blue)] focus-visible:ring-offset-2 focus-visible:ring-offset-[#0A0A0A]">
            Reserve Workshop · {WORKSHOP_DATE_SHORT} · $197 →
          </a>
          <a href="/foundation"
            class="inline-flex items-center justify-center font-bold border border-white/30 text-white bg-transparent px-6 py-4 text-[13px] tracking-wide uppercase hover:border-white active:translate-y-px transition-all duration-150">
            Get the Footwork Blueprint · Free →
          </a>
        </div>

        <a href="#students"
          class="mt-7 inline-flex items-center gap-3 text-[10px] font-bold tracking-widest uppercase text-white/55 hover:text-white transition-colors duration-200">
          <span class="h-px w-8 bg-[var(--ink-soft)]"></span>
          <span>Watch fighters run the system</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <!-- ── DESKTOP LAYOUT ─────────────────────────────────────────────── -->
    <div class="hidden md:grid md:grid-cols-[60%_40%] md:min-h-screen">
      <!-- Left: text + CTAs -->
      <div class="flex flex-col justify-center bg-white px-14 lg:px-20">
        <p class="text-[var(--ink-soft)] text-xs tracking-wide uppercase mb-5">Boxing Tech · @theerainers</p>
        <h1 class="font-black uppercase tracking-tighter mb-6 text-[#0A0A0A]"
          style="font-size: clamp(2.75rem, 5.5vw, 4.5rem); line-height: 0.85;">
          Engineered<br/>for the ring.
        </h1>
        <p class="text-[#0A0A0A]/55 mb-10 max-w-[380px] text-base leading-relaxed">
          The technical foundation most gyms skip. Step by step.
        </p>
        <div class="flex flex-col gap-3 max-w-[480px]">
          <a href="/workshop"
            class="tr-gradient-cta inline-flex items-center justify-center rounded-none whitespace-nowrap text-white font-bold px-8 py-4 text-sm tracking-wide uppercase transition-transform duration-150 hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--blue)] focus-visible:ring-offset-2">
            Reserve Workshop Seat · {WORKSHOP_DATE_SHORT} · $197 →
          </a>
          <a href="/foundation"
            class="inline-flex items-center justify-center font-bold border-2 border-[#0A0A0A]/15 text-[#0A0A0A] bg-transparent px-8 py-4 text-sm tracking-wide uppercase hover:border-[var(--blue)] hover:text-[var(--blue)] transition-all duration-200 whitespace-nowrap">
            Get the Footwork Blueprint · Free →
          </a>
        </div>

        <a href="#students"
          class="mt-10 inline-flex items-center gap-3 text-[10px] font-bold tracking-widest uppercase transition-colors duration-200 text-[#0A0A0A]/60 hover:text-[#0A0A0A] group">
          <span class="h-px w-10 bg-[var(--ink-soft)] transition-[width] duration-200 group-hover:w-14"></span>
          <span>Watch fighters run the system</span>
          <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-y-0.5">↓</span>
        </a>
      </div>

      <!-- Right: image panel -->
      <div class="relative overflow-hidden bg-[#0A0A0A]">
        <img src="/images/coldfightpic2.jpg" alt="Thee Rainers"
          width="2280" height="2203"
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="eager" decoding="async" fetchpriority="high" />
      </div>
    </div>

  </section>

  <!-- QUIZ — 3-step diagnosis -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-10 md:py-16 border-b border-[#0A0A0A]/8">
    <div class="max-w-[860px] mx-auto">

      <!-- Header + progress -->
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
        <div>
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-3">Quiz</p>
          <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl md:text-4xl leading-[0.88]">Find your<br/>starting point.</h2>
        </div>
        <div class="flex gap-1.5">
          <div id="qp-1" class="h-[3px] w-14 transition-all duration-300" style="background-color:var(--blue)"></div>
          <div id="qp-2" class="h-[3px] w-14 transition-all duration-300" style="background-color:rgba(10,10,10,0.12)"></div>
          <div id="qp-3" class="h-[3px] w-14 transition-all duration-300" style="background-color:rgba(10,10,10,0.12)"></div>
        </div>
      </div>

      <!-- Step 1 -->
      <div id="quiz-step-1">
        <p class="text-[#0A0A0A]/35 text-[10px] tracking-widest uppercase mb-6">What is your primary focus right now?</p>
        <div class="grid grid-cols-2 gap-3">
          <button data-quiz-option data-step="1" data-value="speed"
            class="border border-[#0A0A0A]/10 bg-[#F7F6F4] hover:border-[var(--blue)] hover:bg-white transition-colors duration-150 cursor-pointer p-6 text-left w-full">
            <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-sm">Speed</p>
          </button>
          <button data-quiz-option data-step="1" data-value="power"
            class="border border-[#0A0A0A]/10 bg-[#F7F6F4] hover:border-[var(--blue)] hover:bg-white transition-colors duration-150 cursor-pointer p-6 text-left w-full">
            <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-sm">Power</p>
          </button>
          <button data-quiz-option data-step="1" data-value="footwork"
            class="border border-[#0A0A0A]/10 bg-[#F7F6F4] hover:border-[var(--blue)] hover:bg-white transition-colors duration-150 cursor-pointer p-6 text-left w-full">
            <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-sm">Footwork</p>
          </button>
          <button data-quiz-option data-step="1" data-value="ringiq"
            class="border border-[#0A0A0A]/10 bg-[#F7F6F4] hover:border-[var(--blue)] hover:bg-white transition-colors duration-150 cursor-pointer p-6 text-left w-full">
            <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-sm">Ring IQ</p>
          </button>
        </div>
      </div>

      <!-- Step 2 -->
      <div id="quiz-step-2" class="hidden">
        <button id="quiz-back-2" class="text-[#0A0A0A]/30 text-[10px] tracking-widest uppercase mb-4 flex items-center gap-2 hover:text-[#0A0A0A]/60 transition-colors cursor-pointer bg-transparent border-0 py-3 px-1 font-bold min-h-[44px]">
          &larr; Back
        </button>
        <p class="text-[#0A0A0A]/35 text-[10px] tracking-widest uppercase mb-6">Where are you starting from?</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <button data-quiz-option data-step="2" data-value="beginner"
            class="border border-[#0A0A0A]/10 bg-[#F7F6F4] hover:border-[var(--blue)] hover:bg-white transition-colors duration-150 cursor-pointer p-6 text-left w-full">
            <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-sm mb-1.5">Just starting</p>
            <p class="text-[#0A0A0A]/40 text-xs leading-relaxed">Under 1 year or no formal training</p>
          </button>
          <button data-quiz-option data-step="2" data-value="amateur"
            class="border border-[#0A0A0A]/10 bg-[#F7F6F4] hover:border-[var(--blue)] hover:bg-white transition-colors duration-150 cursor-pointer p-6 text-left w-full">
            <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-sm mb-1.5">Amateur</p>
            <p class="text-[#0A0A0A]/40 text-xs leading-relaxed">Training consistently, have sparred</p>
          </button>
          <button data-quiz-option data-step="2" data-value="advanced"
            class="border border-[#0A0A0A]/10 bg-[#F7F6F4] hover:border-[var(--blue)] hover:bg-white transition-colors duration-150 cursor-pointer p-6 text-left w-full">
            <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-sm mb-1.5">Advanced</p>
            <p class="text-[#0A0A0A]/40 text-xs leading-relaxed">Competitive or serious fight record</p>
          </button>
        </div>
      </div>

      <!-- Step 3: Email (dynamic insight per path) -->
      <div id="quiz-step-3" class="hidden">
        <button id="quiz-back-3" class="text-[#0A0A0A]/30 text-[10px] tracking-widest uppercase mb-4 flex items-center gap-2 hover:text-[#0A0A0A]/60 transition-colors cursor-pointer bg-transparent border-0 py-3 px-1 font-bold min-h-[44px]">
          &larr; Back
        </button>
        <div id="quiz-insight" class="border-l-2 border-[#0A0A0A]/15 pl-4 mb-8 max-w-[480px]">
          <!-- Populated by JS -->
        </div>
        <h3 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-2xl leading-[0.88] mb-2">Your starting point.</h3>
        <p class="text-[#0A0A0A]/40 text-sm leading-relaxed mb-6 max-w-[420px]">Enter your email and I will send you the specific next step based on what you told me.</p>
        <form id="quiz-form" class="flex flex-col sm:flex-row gap-3 max-w-[520px]">
          <input type="email" id="quiz-email" placeholder="your@email.com" required
            class="flex-1 border border-[#0A0A0A]/15 bg-[#F7F6F4] px-5 py-4 text-sm text-[#0A0A0A] placeholder:text-[#0A0A0A]/25 focus:outline-none focus:border-[var(--blue)] transition-colors duration-200" />
          <button type="submit" id="quiz-submit"
            class="blue-btn inline-flex items-center justify-center font-bold border-2 border-[var(--blue)] text-[var(--blue)] bg-transparent px-8 py-4 text-xs tracking-widest uppercase hover:bg-[var(--blue)] hover:text-white transition-all duration-200 whitespace-nowrap cursor-pointer disabled:opacity-40">
            Send it →
          </button>
        </form>
        <p id="quiz-error" class="text-[#0A0A0A]/40 text-xs mt-3 hidden">Please enter a valid email address.</p>
      </div>

      <!-- Step 4: Done (dynamic product CTA per path) -->
      <div id="quiz-step-4" class="hidden">
        <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-4">Sent</p>
        <h3 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl leading-[0.88] mb-3">Check your inbox.</h3>
        <p class="text-[#0A0A0A]/40 text-sm leading-relaxed max-w-[400px] mb-8">Your plan is on the way. If you want to start now:</p>
        <div id="quiz-result-cta">
          <!-- Populated by JS -->
        </div>
      </div>

    </div>
  </section>

  <!-- WORKSHOP BAND — primary urgency, gradient edge -->
  <a href="/workshop" class="block bg-[#0A0A0A] hover:bg-[#141414] transition-colors duration-150 border-y border-white/5">
    <div class="max-w-[1100px] mx-auto px-6 md:px-12 lg:px-20 py-3 flex items-center justify-between gap-4">
      <p class="text-white text-[11px] font-bold tracking-widest uppercase">
        <span class="inline-block w-2 h-2 mr-2 rounded-full" style="background: linear-gradient(45deg, #f09433, #dc2743, #bc1888);"></span>
        Live Workshop · Don't Get Hit · {WORKSHOP_DATE_SHORT} · $197
      </p>
      <span class="text-white text-[11px] font-bold tracking-widest uppercase shrink-0">Reserve Seat →</span>
    </div>
  </a>

  <!-- PRODUCTS -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-10 md:py-16 border-b border-[#0A0A0A]/8">
    <div class="max-w-[1100px] mx-auto">

      <div class="mb-8">
        <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl md:text-4xl leading-[0.88]">The System.</h2>
        <p class="text-[#0A0A0A]/40 text-sm mt-3">One live workshop. Two blueprints.</p>
      </div>

      <!-- FLAGSHIP: Defense Workshop · Live (gradient frame) -->
      <div class="relative overflow-hidden mb-4 p-[2px] tr-gradient-cta">
        <div class="relative bg-[#0A0A0A] overflow-hidden">
          <img src="/images/workshop_bacgkround.png" alt="Defense Workshop live session"
            width="1920" height="1080"
            class="absolute inset-0 w-full h-full object-cover object-center opacity-15"
            loading="lazy" />
          <div class="relative z-10 p-6 md:p-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div class="max-w-[640px]">
              <p class="text-white/70 text-[10px] tracking-widest uppercase mb-2">Flagship · Live · {WORKSHOP_DATE_LONG} · 90 Min</p>
              <p class="font-black text-white uppercase tracking-tight text-2xl md:text-3xl leading-[0.9]">Defense Workshop · $197</p>
              <p class="text-white/80 text-xs md:text-sm mt-3 leading-relaxed">Camera on. Real-time correction on your defensive structure, movement, and mechanics. Limited seats. Full recording delivered within 24h.</p>
            </div>
            <a href="/workshop"
              class="shrink-0 inline-flex items-center justify-center rounded-none whitespace-nowrap bg-white text-[#0A0A0A] font-bold px-8 py-3 text-sm tracking-wide uppercase hover:bg-[var(--blue)] hover:text-white transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--blue)] focus-visible:ring-offset-2">
              Reserve Seat →
            </a>
          </div>
        </div>
      </div>

      <!-- 2-column blueprint cards — Footwork (free) + Shadowboxing ($47) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

        <div class="tr-card border-2 border-[var(--blue)]/30 flex flex-col group hover:border-[var(--blue)] transition-colors duration-200 relative">
          <div class="absolute top-3 left-3 z-10 bg-[var(--blue)] text-white text-[9px] font-bold tracking-widest uppercase px-2 py-1">Free · Start Here</div>
          <a href="/foundation" aria-label="Get the free Footwork Blueprint" class="bg-[#F6F6F6] overflow-hidden relative block">
            <img src="/images/3d_thefootworkblueprint_cover.jpg" alt="Footwork Blueprint"
              width="400" height="400"
              class="w-full object-cover aspect-[4/3] group-hover:scale-[1.02] transition-transform duration-300" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent pointer-events-none"></div>
          </a>
          <div class="p-5 flex flex-col flex-1">
            <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-2">Blueprint · 21 Pages · 56 Drills</p>
            <h3 class="font-black text-[#0A0A0A] uppercase tracking-tight text-xl leading-tight mb-3">
              <a href="/foundation" class="hover:text-[var(--blue)] transition-colors">Footwork Blueprint</a>
            </h3>
            <p class="text-[#0A0A0A]/40 text-xs leading-relaxed flex-1">Stance mechanics. Weight distribution. Kinetic chain from the floor up. The base layer. Full PDF. No payment.</p>
            <div class="mt-5 flex items-center justify-between gap-3">
              <span class="font-black text-[var(--blue)] text-2xl">FREE</span>
              <a href="/foundation"
                class="inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[var(--blue)] text-white font-bold px-6 py-3 text-sm tracking-wide uppercase hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--blue)] focus-visible:ring-offset-2">
                Get the PDF →
              </a>
            </div>
          </div>
        </div>

        <div class="tr-card border border-[#0A0A0A]/10 flex flex-col group hover:border-[var(--blue)]/40 transition-colors duration-200">
          <a href="/shadowboxing-blueprint" aria-label="Learn more about the Shadowboxing Blueprint" class="bg-[#F6F6F6] overflow-hidden relative block">
            <img src="/images/shadowboxingblueprint_covernew.png" alt="Shadowboxing Blueprint"
              width="1500" height="1150"
              class="w-full object-cover aspect-[4/3] group-hover:scale-[1.02] transition-transform duration-300" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent pointer-events-none"></div>
          </a>
          <div class="p-5 flex flex-col flex-1">
            <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-2">Blueprint · The Next Layer</p>
            <h3 class="font-black text-[#0A0A0A] uppercase tracking-tight text-xl leading-tight mb-3">
              <a href="/shadowboxing-blueprint" class="hover:text-[var(--blue)] transition-colors">Shadowboxing Blueprint</a>
            </h3>
            <p class="text-[#0A0A0A]/40 text-xs leading-relaxed flex-1">Shadowboxing rebuilt as live simulation. Cue reading. Range fluency. Technique under pressure. After the footwork foundation.</p>
            <div class="mt-5 flex items-center justify-between gap-3">
              <span class="font-black text-[#0A0A0A] text-2xl">$47</span>
              <a href="https://buy.stripe.com/5kQdR91X5dlIeqm8cc6J20l"
                class="inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[var(--blue)] text-white font-bold px-6 py-3 text-sm tracking-wide uppercase hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--blue)] focus-visible:ring-offset-2">
                Get the Blueprint →
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- Proof — full wall: every fighter, remote and in-person -->
      <div id="students" class="-mx-6 md:-mx-12 lg:-mx-20 mb-4 border-t border-[#0A0A0A]/8 scroll-mt-20">
        <Testimonials heading="Watch them work." kicker="Field Report" />
      </div>

      <!-- Workshop Replay — secondary attraction offer -->
      <div class="relative overflow-hidden bg-[#0A0A0A] mb-4">
        <img src="/images/workshop_bacgkround.png" alt="Defense Workshop replay"
          width="1920" height="1080"
          class="absolute inset-0 w-full h-full object-cover object-center opacity-15"
          loading="lazy" />
        <div class="relative z-10 p-6 md:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <p class="text-white/60 text-[10px] tracking-widest uppercase mb-2">On Demand · Full Recording</p>
            <p class="font-black text-white uppercase tracking-tight text-xl leading-tight">Workshop Replay · $79</p>
            <p class="text-white/75 text-xs mt-2 leading-relaxed">90 min. Watch the live corrections. Apply the framework. 7-day access from purchase.</p>
          </div>
          <a href="/workshop-replay"
            class="shrink-0 inline-flex items-center justify-center rounded-none whitespace-nowrap border-2 border-[var(--blue)] text-[var(--blue)] bg-transparent font-bold px-8 py-3 text-sm tracking-wide uppercase hover:bg-[var(--blue)] hover:text-white transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--blue)] focus-visible:ring-offset-2">
            Get Replay →
          </a>
        </div>
      </div>

      <!-- Greatness Community -->
      <div class="border border-[var(--blue)]/20 overflow-hidden">
        <div class="p-8 md:p-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div>
            <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-3">Greatness Community</p>
            <h3 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-2xl leading-tight mb-3">Live Reps With Rainers.</h3>
            <p class="text-[#0A0A0A]/50 text-sm leading-relaxed max-w-[520px]">Weekly live Proving Ground sessions with Rainers. Real-time correction on your movement. Private community chat. Drill library. $39/mo.</p>
          </div>
          <a href="/community"
            class="shrink-0 inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[var(--blue)] text-white font-bold px-8 py-3 text-sm tracking-wide uppercase hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--blue)] focus-visible:ring-offset-2">
            See the Community →
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- SOCIAL PROOF -->
  <section class="bg-white py-12 border-b border-[#0A0A0A]/8">
    <div class="max-w-[1100px] mx-auto px-6 md:px-12 lg:px-20">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-[1px] bg-[#0A0A0A]/8">
        <a href="https://www.instagram.com/theerainers" target="_blank" rel="noopener"
          class="bg-white flex flex-col items-center justify-center py-8 px-4 hover:bg-[#F6F6F6] transition-colors duration-200">
          <p class="font-black text-[#0A0A0A] text-2xl md:text-3xl leading-none mb-1" data-count={SOCIAL_STATS.instagram} data-suffix="K">{SOCIAL_STATS.instagram}K</p>
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase">Instagram</p>
        </a>
        <a href="https://www.facebook.com/theerainers" target="_blank" rel="noopener"
          class="bg-white flex flex-col items-center justify-center py-8 px-4 hover:bg-[#F6F6F6] transition-colors duration-200">
          <p class="font-black text-[#0A0A0A] text-2xl md:text-3xl leading-none mb-1" data-count={SOCIAL_STATS.facebook} data-suffix="K">{SOCIAL_STATS.facebook}K</p>
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase">Facebook</p>
        </a>
        <a href="https://www.tiktok.com/@theerainers" target="_blank" rel="noopener"
          class="bg-white flex flex-col items-center justify-center py-8 px-4 hover:bg-[#F6F6F6] transition-colors duration-200">
