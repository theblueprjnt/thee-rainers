<script>
  {
    // Social stats counter
    const els = document.querySelectorAll<HTMLElement>('[data-count]');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.count ?? '0', 10);
        const suffix = el.dataset.suffix ?? '';
        const duration = 1000;
        const start = performance.now();
        observer.unobserve(el);
        function step(now: number): void {
          const p = Math.min((now - start) / duration, 1);
          const ease = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(ease * target) + suffix;
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    }, { threshold: 0.3 });
    els.forEach(el => observer.observe(el));
  }
</script>

<script is:inline>
  (function() {
    // Quiz toggle
    var toggle = document.getElementById('quiz-toggle');
    var panel  = document.getElementById('quiz-panel');
    if (toggle && panel) {
      toggle.addEventListener('click', function() {
        var hidden = panel.classList.toggle('hidden');
        toggle.textContent = hidden ? 'Find my starting point →' : 'Close ↑';
        if (!hidden) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    // Step 0 — audience split
    var selfBtn = document.getElementById('quiz-self');
    if (selfBtn) selfBtn.addEventListener('click', function() {
      var s0 = document.getElementById('quiz-step-0');
      if (s0) s0.classList.add('hidden');
      showStep(1);
    });
    var youthBtn = document.getElementById('quiz-youth');
    if (youthBtn) youthBtn.addEventListener('click', function() {
      window.location.href = '/safe';
    });

    // Quiz logic
    var STEPS = ['quiz-step-1','quiz-step-2','quiz-step-3','quiz-step-4'];
    var BARS  = ['qp-1','qp-2','qp-3'];
    var quizState = { focus: '', level: '' };

    var PATHS = {
      speed: {
        insight: 'Speed comes from efficiency, not effort. Most fighters trying to move faster are fighting their own stance. When the base is unstable, every step burns more than it should.',
        cta: 'Get the Shadowboxing Blueprint · $47 →',
        url: '/shadowboxing-blueprint',
      },
      power: {
        insight: 'Power comes from the kinetic chain, not the shoulder. If punches feel like they need more muscle, the break is in how force transfers from your base. Fix the foundation and the power follows.',
        cta: 'Get the Footwork Blueprint · Free →',
        url: '/foundation',
      },
      footwork: {
        insight: 'Most footwork problems are stance problems in disguise. Where your weight sits determines every angle you can take or give. That is what the Blueprint addresses from the ground up.',
        cta: 'Get the Footwork Blueprint · Free →',
        url: '/foundation',
      },
      'ring-iq': {
        insight: 'Ring IQ builds through live correction. The Defense Workshop puts you on camera. Real-time feedback on the exact patterns where you get hit.',
        cta: 'Reserve Defense Workshop · $197 →',
        url: '/workshop',
      },
    };

    function getPath() {
      return PATHS[quizState.focus] || PATHS['footwork'];
    }

    function showStep(n) {
      STEPS.forEach(function(id, i) {
        var el = document.getElementById(id);
        if (el) el.classList.toggle('hidden', i !== n - 1);
      });
      BARS.forEach(function(id, i) {
        var el = document.getElementById(id);
        if (el) el.style.backgroundColor = i < n ? 'var(--blue)' : 'rgba(10,10,10,0.12)';
      });
      if (n === 3) {
        var insight = document.getElementById('quiz-insight');
        if (insight) insight.innerHTML = '<p class="text-[#0A0A0A]/70 text-sm leading-relaxed">' + getPath().insight + '</p>';
      }
      if (n === 4) {
        var path = getPath();
        var resultCta = document.getElementById('quiz-result-cta');
        if (resultCta) resultCta.innerHTML = '<a href="' + path.url + '" style="display:inline-flex;align-items:center;justify-content:center;font-weight:700;border:2px solid var(--blue);color:var(--blue);background:transparent;padding:12px 28px;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;" onmouseover="this.style.background=\'var(--blue)\';this.style.color=\'#fff\'" onmouseout="this.style.background=\'transparent\';this.style.color=\'var(--blue)\'">' + path.cta + '</a>';
      }
    }

    function initQuiz() {
      var quizForm = document.getElementById('quiz-form');
      if (!quizForm || quizForm.dataset.bound === 'true') return;
      quizForm.dataset.bound = 'true';

      document.querySelectorAll('[data-quiz-option][data-step="1"]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          quizState.focus = btn.dataset.value || '';
          showStep(2);
        });
      });
      document.querySelectorAll('[data-quiz-option][data-step="2"]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          quizState.level = btn.dataset.value || '';
          showStep(3);
        });
      });

      var back2 = document.getElementById('quiz-back-2');
      if (back2) back2.addEventListener('click', function() { showStep(1); });
      var back3 = document.getElementById('quiz-back-3');
      if (back3) back3.addEventListener('click', function() { showStep(2); });

      quizForm.addEventListener('submit', function(e) {
        e.preventDefault();
        var emailInput = document.getElementById('quiz-email');
        var submitBtn  = document.getElementById('quiz-submit');
        var errorEl    = document.getElementById('quiz-error');
        var email      = emailInput ? emailInput.value.trim() : '';
        if (!email) { if (errorEl) errorEl.classList.remove('hidden'); return; }
        if (errorEl) errorEl.classList.add('hidden');
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending...'; }
        var source = 'quiz-' + (quizState.focus || 'home');
        fetch('/api/lead-capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, full_name: '', source: source, quiz_focus: quizState.focus, quiz_level: quizState.level }),
        }).then(function() {
          if (window.trackEvent) window.trackEvent('generate_lead', { lead_source: source, quiz_focus: quizState.focus, quiz_level: quizState.level, currency: 'USD', value: 0 });
        }).catch(function() {}).finally(function() { showStep(4); });
      });
    }

    initQuiz();
  })();
</script>
