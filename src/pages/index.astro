---
import Layout from '../layouts/Base.astro';
import Testimonials from '../components/site/Testimonials.astro';
import OfferStack from '../components/blocks/OfferStack.astro';
import ProofSection from '../components/blocks/ProofSection.astro';
import Objections from '../components/blocks/Objections.astro';
import GradePricing from '../components/blocks/GradePricing.astro';
import { SOCIAL_STATS } from '../data/social-stats';
import { PRODUCTS } from '../data/products.ts';

const dollars = (cents: number) => `$${(cents / 100).toFixed(0)}`;

const stripProducts = [
  {
    title: 'Footwork Blueprint',
    price: dollars(PRODUCTS.footwork.priceCents),
    checkoutKey: 'footwork',
    image: '/images/footwork-cover-opt.jpg',
    imageWebp: '/images/footwork-cover-opt.webp',
  },
  {
    title: 'Shadowboxing Blueprint',
    price: dollars(PRODUCTS.shadowboxing.priceCents),
    checkoutKey: 'shadowboxing',
    image: '/images/shadowbox-cover-opt.png',
  },
];
---
<Layout
  title="Thee Rainers · Boxing built on structure."
  description="Boxing built on structure, full defense, and safer progress. The foundation most gyms skip. Free Footwork Blueprint, live workshops, and coaching.">

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="relative bg-white overflow-hidden" style="min-height: 88svh;">

    <!-- Grayscale portrait — desktop right anchor -->
    <div class="absolute right-0 bottom-0 h-full hidden md:block pointer-events-none select-none" aria-hidden="true">
      <img src="/images/herocropped.webp" alt=""
        class="h-full w-auto object-contain object-bottom"
        style="max-height: 88svh;"
        loading="eager" decoding="async" fetchpriority="high" />
      <div class="absolute inset-y-0 left-0 w-64" style="background: linear-gradient(to right, #FFFFFF 0%, transparent 100%);"></div>
    </div>

    <!-- Mobile: fight photo at low opacity -->
    <div class="absolute inset-0 md:hidden" aria-hidden="true">
      <picture>
        <source srcset="/images/coldfightpic2-opt.webp" type="image/webp" />
        <img src="/images/coldfightpic2-opt.jpg" alt=""
          class="w-full h-full object-cover object-center opacity-15 grayscale"
          loading="eager" decoding="async" fetchpriority="high" />
      </picture>
      <div class="absolute inset-0" style="background: linear-gradient(to top, #FFFFFF 35%, transparent 100%);"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 flex flex-col justify-end md:justify-center px-6 md:px-12 lg:px-20 pb-16 pt-32 md:py-0"
      style="min-height: 88svh; max-width: 56%;">
      <div class="md:max-w-[560px]">
        <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">
          Thee Rainers · Structured Boxing
        </p>
        <h1 class="font-black uppercase tracking-tighter text-[#0B0B0C] mb-6"
          style="font-size: clamp(3.25rem, 7vw, 6rem); line-height: 0.82;">
          Boxing<br/>through<br/>structure.
        </h1>
        <div class="h-0.5 w-12 bg-[var(--terra)] mb-8"></div>
        <p class="text-[#0B0B0C]/60 text-base leading-relaxed mb-12 max-w-[400px]">
          Full offense. Full defense. Minimum unnecessary damage.
        </p>
        <a href="#programs" class="tr-btn">
          Find your foundation
        </a>
        <!-- COPY: trust line, owner supplies verified numbers only -->
      </div>
    </div>
  </section>

  <!-- ── PRODUCT STRIP (image-forward, minimal — sits directly on the hero's black) ── -->
  <section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 py-10 md:py-12">
    <div class="max-w-[1100px] mx-auto grid grid-cols-2 md:grid-cols-[1fr_1fr_auto] gap-5 items-center">
      {stripProducts.map(p => (
        <button type="button" data-checkout={p.checkoutKey}
          class="relative overflow-hidden group text-left cursor-pointer" style="aspect-ratio: 1/1;">
          <picture>
            {p.imageWebp && <source srcset={p.imageWebp} type="image/webp" />}
            <img src={p.image} alt={p.title} loading="eager" decoding="async"
              class="absolute inset-0 w-full h-full object-cover object-center grayscale transition-transform duration-700 group-hover:scale-[1.04]" />
          </picture>
          <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(11,11,12,0.85) 0%, rgba(11,11,12,0.15) 55%, transparent 100%);"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 md:p-5">
            <p class="font-black text-white uppercase tracking-tight text-sm leading-tight">{p.title}</p>
            <p class="text-white/50 text-xs mt-1">{p.price}</p>
          </div>
        </button>
      ))}
      <a href="/shop" class="col-span-2 md:col-span-1 flex items-center justify-center md:justify-start gap-3 py-4 md:py-0 md:pl-2">
        <span class="text-[#0B0B0C]/70 text-[11px] font-bold tracking-widest uppercase hover:text-[#0B0B0C] transition-colors">See more products</span>
        <span class="shrink-0 w-8 h-8 rounded-full border border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-sm" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ── HOMEPAGE LEAD CAPTURE (name, email, background — 3 fields, minimum friction) ── -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-16 md:py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[560px] mx-auto text-center">
      <p class="text-[var(--ink-soft)] text-[11px] tracking-widest uppercase mb-5">Get in touch</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.88] mb-8"
        style="font-size: clamp(1.75rem, 3.5vw, 2.5rem);">
        Apply for Training.
      </h2>

      <div id="home-lead-wrap">
        <form id="home-lead-form" class="flex flex-col gap-3 text-left">
          <input
            type="text"
            id="home-lead-name"
            required
            placeholder="Your name"
            autocomplete="name"
            class="w-full border border-[#0A0A0A]/15 bg-[#F7F6F4] px-5 py-4 text-[#0A0A0A] text-sm focus:border-[var(--terra)] focus:bg-white focus:outline-none transition-colors duration-200 placeholder:text-[#0A0A0A]/30"
          />
          <input
            type="email"
            id="home-lead-email"
            required
            placeholder="your@email.com"
            autocomplete="email"
            class="w-full border border-[#0A0A0A]/15 bg-[#F7F6F4] px-5 py-4 text-[#0A0A0A] text-sm focus:border-[var(--terra)] focus:bg-white focus:outline-none transition-colors duration-200 placeholder:text-[#0A0A0A]/30"
          />
          <input
            type="text"
            id="home-lead-background"
            required
            placeholder="Your background"
            autocomplete="off"
            class="w-full border border-[#0A0A0A]/15 bg-[#F7F6F4] px-5 py-4 text-[#0A0A0A] text-sm focus:border-[var(--terra)] focus:bg-white focus:outline-none transition-colors duration-200 placeholder:text-[#0A0A0A]/30"
          />
          <button type="submit" id="home-lead-submit" class="tr-btn mt-2">
            Submit →
          </button>
        </form>
        <p id="home-lead-success" class="hidden text-[#0A0A0A] text-sm font-bold tracking-wide mt-5">Thanks. We will be in touch.</p>
        <p id="home-lead-error" class="hidden text-[var(--red)] text-sm mt-3">Something went wrong. Try again or email rainers@theerainers.com</p>
        <p class="text-[11px] text-[#0A0A0A]/30 mt-4">No spam. Unsubscribe any time.</p>
      </div>
    </div>
  </section>

  <!-- ── BEFORE YOU START (old way vs our way) ────────────────────────── -->
  <Objections />

  <!-- ── OFFER STACK ────────────────────────────────────────────────────── -->
  <OfferStack />

  <!-- ── GRADE PRICING ─────────────────────────────────────────────────── -->
  <GradePricing />

  <!-- ── GRADE COACHING PROOF (null on empty) ─────────────────────────── -->
  <ProofSection />

  <!-- ── PROOF ─────────────────────────────────────────────────────────── -->
  <div id="proof" class="scroll-mt-20">
    <Testimonials heading="What fighters say." kicker="Field Report" background="white" />
  </div>

  <!-- ── FINAL CTA ─────────────────────────────────────────────────────── -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-20 md:py-28 text-center">
    <div class="max-w-[600px] mx-auto">
      <h2 class="font-black uppercase tracking-tighter text-[#0B0B0C] mb-8"
        style="font-size: clamp(2rem, 4vw, 3rem); line-height: 0.95;">
        The system is built. Bring your body.
      </h2>
      <a href="/coaching" class="tr-btn">
        Start Coaching
      </a>
      <p class="mt-6">
        <a href="/foundation" class="text-[var(--navy)] text-[11px] font-bold tracking-widest uppercase hover:opacity-70 transition-opacity">Or start free →</a>
      </p>
    </div>
  </section>

</Layout>

<script>
  function wireHomeLeadForm(): void {
    const form = document.getElementById('home-lead-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const nameEl       = document.getElementById('home-lead-name')       as HTMLInputElement | null;
    const emailEl      = document.getElementById('home-lead-email')      as HTMLInputElement | null;
    const backgroundEl = document.getElementById('home-lead-background') as HTMLInputElement | null;
    const submit  = document.getElementById('home-lead-submit')  as HTMLButtonElement | null;
    const success = document.getElementById('home-lead-success') as HTMLElement;
    const error   = document.getElementById('home-lead-error')   as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email      = emailEl?.value.trim() ?? '';
      const full_name  = nameEl?.value.trim() ?? '';
      const background = backgroundEl?.value.trim() ?? '';
      if (!email || !full_name) return;

      if (submit) { submit.disabled = true; submit.textContent = 'One moment...'; }
      error.classList.add('hidden');

      try {
        await fetch('/api/lead-capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, full_name, background, source: 'homepage-lead' }),
        });
      } catch {
        // non-blocking — show success regardless
      }

      (window as Window & { trackEvent?: (n: string, d: Record<string, unknown>) => void }).trackEvent?.('generate_lead', {
        lead_source: 'homepage-lead',
        currency: 'USD',
        value: 0,
      });

      form.classList.add('hidden');
      success.classList.remove('hidden');
    });
  }

  wireHomeLeadForm();
</script>
