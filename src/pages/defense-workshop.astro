---
export const prerender = false;

import Layout from '../layouts/Base.astro';
import { WORKSHOP_DATE_LABEL } from '../data/defense-workshop.ts';
---
<Layout
  title="Defense Workshop, Nov 29 | Thee Rainers"
  description="A live workshop on the five layers of defense in boxing. Sunday, Nov 29, 12:00 PM ET. Replay included on every tier.">

  <!-- HERO -->
  <section class="relative overflow-hidden bg-white">
    <img src="/images/defense_workshop.webp" alt="" aria-hidden="true"
      width="1920" height="1080"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-20 pointer-events-none select-none"
      loading="eager" fetchpriority="high" />

    <div class="relative z-10 px-6 md:px-16 lg:px-24 pt-28 md:pt-44 pb-14 md:pb-20">
      <div class="max-w-[720px]">
        <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">
          Live Workshop
        </p>
        <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.85] mb-6"
          style="font-size: clamp(2.8rem, 8vw, 4.75rem);">
          Defense<br/>Workshop.
        </h1>

        <p class="text-[#0A0A0A]/65 text-base leading-relaxed mb-4 max-w-[520px]">
          A live session on the five layers of defense in boxing. Live Q&amp;A included. Every seat includes the replay.
        </p>

        <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-lg mb-1" id="workshop-date-label">{WORKSHOP_DATE_LABEL}</p>
        <p class="text-[#0A0A0A]/40 text-xs mb-10" id="workshop-local-time"></p>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-8">
          <a href="#tickets" class="tr-btn w-full sm:w-auto" id="workshop-hero-cta">
            Get Your Seat
          </a>
        </div>

        <div class="flex flex-wrap gap-x-6 gap-y-2 text-[#0A0A0A]/40 text-[10px] tracking-widest uppercase">
          <span>Live on Zoom</span>
          <span aria-hidden="true">·</span>
          <span class="text-[#0A0A0A]/55 font-bold">Replay Included</span>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="bg-[var(--warm)] px-6 md:px-16 lg:px-24 py-16 md:py-24 border-b border-[#0A0A0A]/8">
    <div class="max-w-[1100px] mx-auto">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-3">What's Inside</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl md:text-4xl leading-[0.88] mb-10">
        What this session gives you.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="border-t-2 border-[var(--terra)] pt-5">
          <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-sm mb-3">The 5-layer system.</p>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed">A complete defensive framework you can use in training, five layers in order.</p>
        </div>
        <div class="border-t-2 border-[var(--terra)] pt-5">
          <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-sm mb-3">Live Q&A.</p>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed">Bring your own questions and get a direct answer from Rainers in real time.</p>
        </div>
        <div class="border-t-2 border-[var(--terra)] pt-5">
          <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-sm mb-3">Replay included.</p>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed">The full session is yours after the live workshop, with exclusive access to watch it again.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="bg-white px-6 md:px-16 lg:px-24 py-16 md:py-24 border-b border-[#0A0A0A]/8">
    <div class="max-w-[860px] mx-auto">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-3">Who This Is For</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl leading-[0.88] mb-8">
        Fighters who want to stop getting hit.
      </h2>
      <p class="text-[#0A0A0A]/55 text-base leading-relaxed max-w-[640px]">
        You train consistently and know defense matters, but under pressure your guard breaks down and you can't pinpoint why. This workshop gives you the structure that's missing.
      </p>
    </div>
  </section>

  <!-- TICKETS (shown before the workshop ends) -->
  <section id="tickets" class="bg-white px-6 md:px-16 lg:px-24 py-16 md:py-24 scroll-mt-20">
    <div class="max-w-[1100px] mx-auto">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-4">
        Defense Workshop
      </p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl leading-[0.9] mb-3">
        Get your seat.
      </h2>
      <p class="text-[#0A0A0A]/55 text-sm leading-relaxed mb-10">{WORKSHOP_DATE_LABEL}. Live on Zoom. Every tier includes the replay.</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="border border-[#0A0A0A]/10 p-8 flex flex-col">
          <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-lg mb-2">Live</p>
          <p class="font-black text-[#0A0A0A] text-3xl mb-4">$49</p>
          <p class="text-[#0A0A0A]/55 text-sm leading-relaxed mb-8 flex-1">The live session, plus the replay.</p>
          <button type="button" data-checkout="defense_workshop_standard" class="tr-btn w-full justify-center">Get the $49 Seat</button>
        </div>
        <div class="border-2 border-[var(--terra)] p-8 flex flex-col relative">
          <span class="absolute -top-3 left-6 bg-[var(--terra)] text-white text-[10px] tracking-widest uppercase font-bold px-3 py-1">Most Popular</span>
          <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-lg mb-2">Live + Footage Review</p>
          <p class="font-black text-[#0A0A0A] text-3xl mb-4">$99</p>
          <p class="text-[#0A0A0A]/55 text-sm leading-relaxed mb-8 flex-1">Your seat, plus a recorded breakdown of one clip you send after the workshop. Clips accepted until Dec 6, breakdown delivered within 7 days.</p>
          <button type="button" data-checkout="defense_workshop_review" class="tr-btn w-full justify-center">Get the $99 Seat</button>
        </div>
        <div class="border border-[#0A0A0A]/10 p-8 flex flex-col">
          <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-lg mb-2">Live + 1:1 Call</p>
          <p class="font-black text-[#0A0A0A] text-3xl mb-4">$199</p>
          <p class="text-[#0A0A0A]/55 text-sm leading-relaxed mb-8 flex-1">Your seat, plus a 30-minute 1:1 call with Rainers after the workshop.</p>
          <button type="button" data-checkout="defense_workshop_call" class="tr-btn w-full justify-center">Get the $199 Seat</button>
        </div>
      </div>

      <p class="text-[#0A0A0A]/40 text-xs mt-8">
        Already have the replay? <a href="/workshop-replay" class="underline hover:text-[#0A0A0A]/60">Watch the Workshop Replay on demand →</a>
      </p>
    </div>
  </section>

  <!-- REPLAY FALLBACK (shown once the workshop has ended) -->
  <section id="workshop-ended" class="hidden bg-white px-6 md:px-16 lg:px-24 py-16 md:py-24 scroll-mt-20">
    <div class="max-w-[640px] mx-auto text-center">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-4">Defense Workshop</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl leading-[0.9] mb-6">
        The live session has ended.
      </h2>
      <p class="text-[#0A0A0A]/55 text-sm leading-relaxed mb-8">
        The full recording is available now. Same five-layer system, watch on your own time.
      </p>
      <a href="/workshop-replay" class="tr-btn">Watch the Workshop Replay</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[var(--warm)] px-6 md:px-16 lg:px-24 py-16 md:py-24 border-b border-[#0A0A0A]/8">
    <div class="max-w-[800px] mx-auto">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">Questions</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl leading-tight mb-10">Common Questions</h2>
      <div class="flex flex-col divide-y divide-[#0A0A0A]/10 border-t border-b border-[#0A0A0A]/10">
        <details class="group py-5">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-bold text-[#0A0A0A] text-sm">
            What if I can't make the live date?
            <span class="shrink-0 text-[#0A0A0A]/30 text-lg group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed mt-3">The replay is included with every seat, with permanent access after the live session.</p>
        </details>
        <details class="group py-5">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-bold text-[#0A0A0A] text-sm">
            Do I need a camera?
            <span class="shrink-0 text-[#0A0A0A]/30 text-lg group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed mt-3">A camera is recommended for the Q&A portion. If you can't be on camera, the replay is still yours after the live date.</p>
        </details>
        <details class="group py-5">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-bold text-[#0A0A0A] text-sm">
            What platform is this on?
            <span class="shrink-0 text-[#0A0A0A]/30 text-lg group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed mt-3">Zoom. The link is sent by email after you get your seat.</p>
        </details>
      </div>
    </div>
  </section>

</Layout>

<script>
  import { WORKSHOP_START_MS, WORKSHOP_END_MS } from '../data/defense-workshop.ts';

  function showLocalTime(): void {
    const el = document.getElementById('workshop-local-time');
    if (!el) return;
    try {
      const d = new Date(WORKSHOP_START_MS);
      const formatted = new Intl.DateTimeFormat(undefined, {
        weekday: 'long', month: 'short', day: 'numeric',
        hour: 'numeric', minute: '2-digit', timeZoneName: 'short',
      }).format(d);
      el.textContent = `That's ${formatted} in your local time.`;
    } catch {
      // Intl not available for some reason -- leave the line empty rather than guess.
    }
  }

  function toggleWorkshopEnded(): void {
    const ended = Date.now() > WORKSHOP_END_MS;
    const tickets = document.getElementById('tickets');
    const endedSection = document.getElementById('workshop-ended');
    const heroCta = document.getElementById('workshop-hero-cta') as HTMLAnchorElement | null;
    if (!tickets || !endedSection) return;
    if (ended) {
      tickets.classList.add('hidden');
      endedSection.classList.remove('hidden');
      if (heroCta) { heroCta.href = '/workshop-replay'; heroCta.textContent = 'Watch the Replay'; }
    }
  }

  showLocalTime();
  toggleWorkshopEnded();
</script>
