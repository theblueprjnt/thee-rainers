---
export const prerender = false;

import Layout from '../../layouts/Base.astro';
import { env as cfEnv } from 'cloudflare:workers';

// No expiry -- same pattern as /watch/workshop-replay. Unlisted YouTube
// videos, the signature just stops the URL from being guessable.
const secret = (cfEnv as unknown as Record<string, string>)['WATCH_TOKEN_SECRET'] ?? '';
const sig    = Astro.url.searchParams.get('sig') ?? '';

let valid = false;

if (secret && sig) {
  const key = await crypto.subtle.importKey(
    'raw',
    new TextEncoder().encode(secret),
    { name: 'HMAC', hash: 'SHA-256' },
    false,
    ['sign'],
  );
  const sigBuf = await crypto.subtle.sign(
    'HMAC',
    key,
    new TextEncoder().encode('course'),
  );
  const expected = Array.from(new Uint8Array(sigBuf))
    .map(b => b.toString(16).padStart(2, '0'))
    .join('');
  valid = sig === expected;
}

if (!valid) {
  return Astro.redirect('/course');
}

const LESSONS = [
  { n: '01', title: 'Intro & Safety Precautions', id: '7suEJkv2ei4' },
  { n: '02', title: 'How to Wrap Your Hands and Why', id: 'HoaH5wRoGNg' },
  { n: '03', title: 'Boxing Mindset', id: 'Id-KUeB1BmY' },
  { n: '04', title: 'Athletic Fight Stance', id: 'EgSk0fqNOuo' },
  { n: '05', title: 'Boxing Settings to Keep in Mind When Training', id: '8X1A2Rwr3Uw' },
  { n: '06', title: 'Defense', id: 'mojfFzkQ-w8' },
  { n: '07', title: 'Punches', id: '8KPlx2nv-Bk' },
  { n: '08', title: 'How to Hit the Heavy Bag', id: 'ENx1es_cs9Q' },
  { n: '09', title: 'Training Plans', id: '4eiPSoMX0aQ' },
  { n: '10', title: 'Footwork In-Depth (4 Bases)', id: 'srFcsWB0EOo' },
];
---
<Layout title="Step Into The Ring · Thee Rainers">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <section class="bg-white px-6 md:px-12 lg:px-20 pt-28 md:pt-36 pb-20">
    <div class="max-w-[820px] mx-auto w-full">

      <p class="text-[var(--ink-soft)] text-[11px] tracking-widest uppercase mb-4">Access confirmed</p>
      <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-4xl md:text-5xl leading-[0.9] mb-4">
        Step Into The Ring.
      </h1>
      <p class="text-[#0A0A0A]/50 text-sm leading-relaxed mb-12 max-w-[520px]">
        Ten lessons, in order. Start at the top and work down, each one stands on the one before it.
      </p>

      <!-- RESOURCES -->
      <div class="border border-[#0A0A0A]/8 p-6 md:p-8 mb-12 flex flex-col sm:flex-row gap-4">
        <a href="/pdfs/course-weekly-plan.pdf" target="_blank" rel="noopener"
          class="flex-1 inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[#0A0A0A] text-white font-bold px-6 py-4 text-sm tracking-widest uppercase transition-opacity duration-150 hover:opacity-85">
          6-Week Plan PDF →
        </a>
        <a href="/pdfs/footwork-blueprint.pdf" target="_blank" rel="noopener"
          class="flex-1 inline-flex items-center justify-center rounded-none whitespace-nowrap border-2 border-[#0A0A0A] text-[#0A0A0A] font-bold px-6 py-4 text-sm tracking-widest uppercase transition-opacity duration-150 hover:opacity-70">
          Footwork Blueprint PDF →
        </a>
      </div>

      <!-- LESSONS -->
      <div class="flex flex-col divide-y divide-[#0A0A0A]/8 mb-16">
        {LESSONS.map((lesson) => (
          <div class="py-10">
            <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-3">Lesson {lesson.n}</p>
            <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-lg mb-4">{lesson.title}</p>
            <div class="border border-[#0A0A0A]/8 overflow-hidden">
              <div class="relative w-full" style="padding-bottom: 56.25%;">
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${lesson.id}`}
                  title={lesson.title}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                  class="absolute inset-0 w-full h-full"
                ></iframe>
              </div>
            </div>
          </div>
        ))}

        <div class="py-10">
          <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-3">Bonus</p>
          <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-lg mb-4">6-Week Structure + Video Explanation</p>
          <div class="border border-[#0A0A0A]/8 overflow-hidden">
            <div class="relative w-full" style="padding-bottom: 56.25%;">
              <iframe
                src="https://www.youtube-nocookie.com/embed/iU1DX1JQ7mA"
                title="6-Week Structure + Video Explanation"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
                class="absolute inset-0 w-full h-full"
              ></iframe>
            </div>
          </div>
        </div>
      </div>

      <div class="border-t border-[#0A0A0A]/8 pt-8">
        <p class="text-[#0A0A0A]/40 text-sm leading-relaxed">Questions about any lesson? Email <a href="mailto:rainers@stepintoring.com" class="underline hover:text-[#0A0A0A]/70">rainers@stepintoring.com</a>.</p>
      </div>

    </div>
  </section>
</Layout>
