---
import LinkPage from '../layouts/LinkPage.astro';
---
<LinkPage title="The Boxing Foundations — Thee Rainers" noindex={true}>

  <div class="max-w-[480px] mx-auto px-6 py-16 flex flex-col gap-10">

    <!-- Identity -->
    <div class="flex flex-col items-center gap-2 text-center">
      <a href="/"><img src="/images/logo-trb.png" alt="Thee Rainers" class="h-9 w-auto" /></a>
      <p class="text-[#D4A373] text-[10px] tracking-widest uppercase">Free · Footwork Starter</p>
    </div>

    <!-- Headline -->
    <div class="text-center">
      <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-4xl leading-[0.88] mb-4">
        The Footwork<br/>Starter
      </h1>
      <p class="text-[#0A0A0A]/55 text-sm leading-relaxed">
        Technique only transfers if your base can hold it. This is thirty days of stance, weight, and balance work that most people skip and then wonder why their punches don't have snap in them.
      </p>
    </div>

    <!-- 3D cover — small visual signal of what they're about to get -->
    <div class="flex justify-center">
      <img src="/images/3d_theboxingfoundations_cover.png" alt="The Boxing Foundations PDF cover"
        width="220" height="280"
        class="w-full max-w-[200px] h-auto" loading="lazy" />
    </div>

    <!-- Why it matters — three points, written in Rainers's voice -->
    <div class="flex flex-col gap-4">
      <div class="border-l-2 border-[#D4A373] pl-4">
        <p class="text-[#D4A373] text-[10px] tracking-widest uppercase mb-1">Floor up</p>
        <p class="text-[#0A0A0A]/55 text-xs leading-relaxed">Your arms are only 24% of your punch. The other 76% is your legs and core. Train on a broken base and you lose most of the power and speed.</p>
      </div>
      <div class="border-l-2 border-[#D4A373] pl-4">
        <p class="text-[#D4A373] text-[10px] tracking-widest uppercase mb-1">Repeatable under pressure</p>
        <p class="text-[#0A0A0A]/55 text-xs leading-relaxed">Drilling installs patterns. Drill the wrong patterns and it shows in sparring. This installs the ones that you need.</p>
      </div>
      <div class="border-l-2 border-[#D4A373] pl-4">
        <p class="text-[#D4A373] text-[10px] tracking-widest uppercase mb-1">Run it anywhere</p>
        <p class="text-[#0A0A0A]/55 text-xs leading-relaxed">Without a gym, partner or gear. You need floor space and thirty days.</p>
      </div>
    </div>

    <!-- Email capture -->
    <div>
      <p class="text-[#0A0A0A]/45 text-xs tracking-widest uppercase mb-5 text-center">Enter your email. Downloads now.</p>
      <form id="fg-form" class="flex flex-col gap-3">
        <input type="email" id="fg-email" required placeholder="your@email.com"
          class="border border-[#0A0A0A]/15 bg-transparent px-5 py-4 text-[#0A0A0A] text-sm focus:border-[#0057FF] focus:outline-none transition-colors duration-200 placeholder:text-[#0A0A0A]/20 text-center" />
        <button type="submit" id="fg-submit"
          class="blue-btn inline-flex items-center justify-center font-bold border-2 border-[#0057FF] text-[#0057FF] bg-transparent px-8 py-4 text-sm tracking-widest uppercase hover:bg-[#0057FF] hover:text-white transition-all duration-200">
          Get the Free PDF →
        </button>
      </form>
      <p id="fg-success" class="hidden text-[#0057FF] text-sm tracking-wide mt-5 text-center">It downloaded. Open the PDF and start.</p>
      <p id="fg-error" class="hidden text-[#0A0A0A]/40 text-sm tracking-wide mt-5 text-center">Something went wrong. Try again.</p>
      <p class="text-[#0A0A0A]/45 text-[10px] tracking-wide mt-4 text-center">No spam. Just the PDF.</p>
    </div>

    <!-- Scripture -->
    <p class="text-[#0A0A0A]/12 text-[10px] tracking-widest uppercase text-center">
      1 Corinthians 9:26–27
    </p>

  </div>
</LinkPage>

<script>
  function triggerDownload(href: string, filename: string) {
    const a = document.createElement('a');
    a.href = href;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  function initFoundationGuideForm() {
    const form = document.getElementById('fg-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    const success = document.getElementById('fg-success')!;
    const error = document.getElementById('fg-error')!;
    const submit = document.getElementById('fg-submit') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submit.disabled = true;
      submit.textContent = 'Preparing...';
      error.classList.add('hidden');
      const email = (document.getElementById('fg-email') as HTMLInputElement).value.trim();
      try {
        const res = await fetch('/api/lead-capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'foundation-guide', full_name: '' }),
        });
        const body = await res.json() as { success: boolean };
        if (body.success) {
          (window as any).trackEvent?.('generate_lead', { lead_source: 'foundation-guide', currency: 'USD', value: 0 });
          form.classList.add('hidden');
          success.classList.remove('hidden');
          triggerDownload('/pdfs/foundations_guide.pdf', 'The-Boxing-Foundations-Thee-Rainers.pdf');
        } else { throw new Error(); }
      } catch {
        error.classList.remove('hidden');
        submit.disabled = false;
        submit.textContent = 'Get the Free PDF →';
      }
    });
  }

  initFoundationGuideForm();
  document.addEventListener('astro:page-load', initFoundationGuideForm);
</script>
