---
export const prerender = false;
import Layout from '../../layouts/Base.astro';
---
<Layout title="Member Area · The Weekly Session" description="">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <section class="bg-white min-h-screen px-6 md:px-12 lg:px-20 pt-28 md:pt-36 pb-20">
    <div class="max-w-[520px] mx-auto">

      <!-- Request state -->
      <div id="gate">
        <p class="text-[var(--purple)] text-[11px] tracking-widest uppercase mb-6">Member Area</p>
        <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.85] mb-6"
          style="font-size: clamp(2rem, 4.5vw, 3rem);">
          Access your<br/>recordings.
        </h1>
        <p class="text-[#0A0A0A]/50 text-sm leading-relaxed mb-10">
          Enter the email address you joined with. We'll send you a link to the session recordings.
        </p>

        <form id="gate-form" class="flex flex-col gap-4 max-w-[380px]">
          <input
            id="gate-email"
            type="email"
            placeholder="your@email.com"
            autocomplete="email"
            required
            class="w-full px-4 py-3 border border-[#0A0A0A]/20 bg-white text-[#0A0A0A] text-sm placeholder:text-[#0A0A0A]/30 focus:outline-none focus:border-[var(--purple)] transition-colors"
          />
          <button type="submit" id="gate-btn"
            class="inline-flex items-center justify-center rounded-none disabled:opacity-40 bg-[var(--purple)] text-white font-bold px-8 py-3 text-sm tracking-wide uppercase hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 transition-colors duration-150 cursor-pointer border-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--blue)] focus-visible:ring-offset-2">
            Send Access Link →
          </button>
          <p id="gate-error" class="text-[var(--red)] text-xs hidden">
            No active membership found for that email.
            <a href="/community" class="underline font-bold">Join the Community →</a>
          </p>
        </form>
      </div>

      <!-- Success state -->
      <div id="gate-success" class="hidden">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-2 h-2 rounded-full bg-[#22C55E]" aria-hidden="true"></div>
          <p class="text-[var(--purple)] text-[11px] tracking-widest uppercase">Link sent</p>
        </div>
        <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.85] mb-6"
          style="font-size: clamp(2rem, 4.5vw, 3rem);">
          Check your inbox.
        </h1>
        <p class="text-[#0A0A0A]/60 text-sm leading-relaxed">
          A link to the session recordings is on the way. Check spam if you don't see it in a few minutes.
        </p>
      </div>

      <div class="mt-16 pt-8 border-t border-[#0A0A0A]/8">
        <p class="text-[#0A0A0A]/30 text-xs leading-relaxed">
          Questions? <a href="mailto:rainers@stepintoring.com" class="text-[var(--blue)] hover:opacity-60 transition-opacity font-bold">rainers@stepintoring.com</a>
        </p>
      </div>

    </div>
  </section>

</Layout>

<script>
  function initGate() {
    const form    = document.getElementById('gate-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const btn      = document.getElementById('gate-btn') as HTMLButtonElement;
    const errorEl  = document.getElementById('gate-error') as HTMLElement;
    const gate     = document.getElementById('gate') as HTMLElement;
    const success  = document.getElementById('gate-success') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('gate-email') as HTMLInputElement).value.trim();
      if (!email) return;
      errorEl.classList.add('hidden');
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'Sending...';

      try {
        const res  = await fetch('/api/community-magic-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json() as { ok: boolean; reason?: string };

        if (data.ok) {
          gate.classList.add('hidden');
          success.classList.remove('hidden');
        } else {
          errorEl.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = original;
        }
      } catch {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  }

  initGate();
</script>
