---
export const prerender = false;
import Layout from '../../layouts/Base.astro';
import Testimonials from '../../components/site/Testimonials.astro';
import { env as cfEnv } from 'cloudflare:workers';

const e       = cfEnv as unknown as Record<string, string>;
const secret  = e['WATCH_TOKEN_SECRET'] ?? '';
const sig     = Astro.url.searchParams.get('sig') ?? '';
const expParam = Astro.url.searchParams.get('exp') ?? '';

let memberVerified = false;
if (secret && sig && expParam) {
  const expNum = parseInt(expParam, 10);
  if (!isNaN(expNum) && expNum > Math.floor(Date.now() / 1000)) {
    const key = await crypto.subtle.importKey(
      'raw', new TextEncoder().encode(secret),
      { name: 'HMAC', hash: 'SHA-256' }, false, ['sign'],
    );
    const sigBuf  = await crypto.subtle.sign('HMAC', key, new TextEncoder().encode(`community-access:${expParam}`));
    const expected = Array.from(new Uint8Array(sigBuf)).map(b => b.toString(16).padStart(2, '0')).join('');
    memberVerified = sig === expected;
  }
}

// ── Add new recordings here after each Tuesday session (most recent first, keep 3 max) ──
// { date: 'Jul 15, 2026', url: 'https://youtu.be/YOUR_UNLISTED_ID' },
const RECORDINGS: Array<{ date: string; url: string }> = [
];
const latestRecording = RECORDINGS[0] ?? null;
const recentRecordings = RECORDINGS.slice(0, 3);

// Set to empty string to hide the preview video slot
const PREVIEW_VIDEO_ID = 'vdUDuFRUqGo';
