---
import Layout from '../../layouts/Base.astro';
---
<Layout
  title="Greatness Community — Thee Rainers"
  description="Weekly live sessions with Rainers. Private community. Drill library. Building now. Get notified first."
>

  <!-- Hero -->
  <section class="bg-white overflow-hidden border-b border-[#0A0A0A]/8">
    <div class="md:hidden w-full overflow-hidden bg-[#0A0A0A]" style="height: 60vw; max-height: 340px;">
      <img
        src="/images/sparring_withnetherlands.png"
        alt="Rainers coaching"
        width="1200" height="1500"
        loading="eager"
        class="w-full h-full object-cover object-center grayscale contrast-[1.2] brightness-[0.85] blur-[1.5px]"
      />
    </div>

    <div class="max-w-[1140px] mx-auto px-6 md:px-12 lg:px-20">
      <div class="grid grid-cols-1 md:grid-cols-[60fr_40fr] min-h-[600px]">

        <div class="flex flex-col justify-center py-20 md:py-32 md:pr-16">
          <p class="text-[#6A0DAD] text-[11px] tracking-widest uppercase mb-6">Greatness Community</p>
          <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.85] mb-6"
            style="font-size: clamp(2.8rem, 5.5vw, 4.5rem);">
            Building now.<br/>Be first in.
          </h1>
          <p class="text-[#0A0A0A]/55 text-base leading-relaxed mb-8 max-w-[460px]">
            Weekly live sessions with Rainers. Private community. A drill library that compounds the longer you train. This is where the ongoing work lives. Leave your email and you hear first when doors open.
          </p>

          <form id="community-waitlist-form" class="flex flex-col gap-3 max-w-[420px]">
            <label for="community-email" class="sr-only">Email address</label>
            <input
              type="email"
              id="community-email"
              name="email"
              placeholder="your@email.com"
              autocomplete="email"
              required
              class="w-full border border-[#0A0A0A]/15 bg-[#F7F6F4] px-4 py-3.5 text-sm text-[#0A0A0A] placeholder:text-[#0A0A0A]/30 focus:outline-none focus:border-[#6A0DAD] transition-colors duration-200"
            />
            <button type="submit" id="community-submit"
              class="inline-flex items-center justify-center whitespace-nowrap rounded-none bg-[#6A0DAD] text-white font-bold px-8 py-4 text-sm uppercase tracking-wide hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 transition-colors duration-150 cursor-pointer border-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4A373] focus-visible:ring-offset-2">
              Notify Me When It Opens →
            </button>
          </form>

          <div id="community-success" class="hidden max-w-[420px]">
            <p class="font-black text-[#0A0A0A] text-base uppercase tracking-tight mb-1">You're on the list.</p>
            <p class="text-[#0A0A0A]/45 text-sm">We will reach out before doors open.</p>
          </div>

          <p class="text-[#0A0A0A]/20 text-xs mt-4">Your email. Nothing else.</p>
        </div>

        <div class="hidden md:block relative overflow-hidden bg-[#0A0A0A]" aria-hidden="true">
          <img
            src="/images/sparring_withnetherlands.png"
            alt=""
            width="1200" height="1500"
            loading="eager"
            class="absolute inset-0 w-full h-full object-cover object-center opacity-90 grayscale contrast-[1.2] brightness-[0.85] blur-[1.5px]"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- What's being built -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[1100px] mx-auto">
      <p class="text-[#926624] text-[11px] tracking-widest uppercase mb-6">What's Inside</p>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-px bg-[#0A0A0A]/8">

        <div class="bg-white p-8">
          <p class="text-[#6A0DAD] text-[10px] tracking-widest uppercase mb-4">Weekly</p>
          <h3 class="font-black text-[#0A0A0A] uppercase tracking-tight text-base leading-tight mb-3">The Proving Ground</h3>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed">Live every week. Camera on. Rainers watches and corrects your movement in real time. One live correction is worth ten pages of instruction.</p>
        </div>

        <div class="bg-white p-8">
          <p class="text-[#926624] text-[10px] tracking-widest uppercase mb-4">Private</p>
          <h3 class="font-black text-[#0A0A0A] uppercase tracking-tight text-base leading-tight mb-3">Community Chat</h3>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed">Ask between sessions. Post clips. Work through problems with fighters doing the same work.</p>
        </div>

        <div class="bg-white p-8">
          <p class="text-[#926624] text-[10px] tracking-widest uppercase mb-4">Growing</p>
          <h3 class="font-black text-[#0A0A0A] uppercase tracking-tight text-base leading-tight mb-3">Drill Library</h3>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed">Every drill, categorized by lever. Added every week. Work your weakest area. The library compounds the longer you stay.</p>
        </div>

        <div class="bg-white p-8">
          <p class="text-[#926624] text-[10px] tracking-widest uppercase mb-4">Always</p>
          <h3 class="font-black text-[#0A0A0A] uppercase tracking-tight text-base leading-tight mb-3">Brotherhood</h3>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed">People doing the work and walking the path toward greatness together. A community with standards.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Bottom capture -->
  <section class="bg-[#F6F6F6] px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[600px] mx-auto text-center">
      <p class="text-[#926624] text-[11px] tracking-widest uppercase mb-4">Get notified</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl leading-tight mb-6">Be first when doors open.</h2>
      <form id="community-waitlist-form-2" class="flex flex-col sm:flex-row gap-3 max-w-[480px] mx-auto">
        <label for="community-email-2" class="sr-only">Email address</label>
        <input
          type="email"
          id="community-email-2"
          name="email"
          placeholder="your@email.com"
          autocomplete="email"
          required
          class="flex-1 border border-[#0A0A0A]/15 bg-white px-4 py-3.5 text-sm text-[#0A0A0A] placeholder:text-[#0A0A0A]/30 focus:outline-none focus:border-[#6A0DAD] transition-colors duration-200"
        />
        <button type="submit"
          class="whitespace-nowrap inline-flex items-center justify-center rounded-none bg-[#6A0DAD] text-white font-bold px-6 py-3.5 text-sm uppercase tracking-wide hover:bg-[#0A0A0A] transition-colors duration-150 cursor-pointer border-0 focus:outline-none">
          Notify Me →
        </button>
      </form>
      <div id="community-success-2" class="hidden mt-4">
        <p class="font-black text-[#0A0A0A] text-base uppercase tracking-tight">You're on the list.</p>
      </div>
      <div class="mt-10 pt-8 border-t border-[#0A0A0A]/10">
        <p class="text-[#0A0A0A]/40 text-xs tracking-widest uppercase">
          Need 1:1 now? <a href="/command" class="text-[#6A0DAD] font-bold hover:text-[#0A0A0A] transition-colors">Private Architecture →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Scripture -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-20">
    <div class="max-w-[680px] mx-auto">
      <p class="font-black uppercase tracking-tighter leading-[0.88] text-white/50 text-2xl md:text-3xl mb-4">
        "As iron sharpens iron, so one person sharpens another."
      </p>
      <p class="text-[#926624] text-[10px] tracking-widest uppercase">Proverbs 27:17</p>
    </div>
  </section>

</Layout>

<script>
  function bindWaitlist(formId: string, emailId: string, successId: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const emailEl = document.getElementById(emailId) as HTMLInputElement | null;
      const email = emailEl?.value?.trim();
      if (!email) return;

      const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submit.textContent || '';
      submit.disabled = true;
      submit.textContent = 'Sending...';

      try {
        await fetch('/api/lead-capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, full_name: '', source: 'community-waitlist' }),
        });
      } catch { /* silent — user still sees success */ }

      if (window.trackEvent) window.trackEvent('generate_lead', { lead_source: 'community-waitlist' });

      form.classList.add('hidden');
      const successEl = document.getElementById(successId);
      if (successEl) successEl.classList.remove('hidden');
    });
  }

  bindWaitlist('community-waitlist-form', 'community-email', 'community-success');
  bindWaitlist('community-waitlist-form-2', 'community-email-2', 'community-success-2');
</script>
