---
import Layout from '../../layouts/Base.astro';
import { NEXT_PROVING_GROUND } from '../../data/proving-ground.ts';
---
<Layout
  title="Greatness Community · Thee Rainers"
  description="Weekly live Proving Ground with Rainers. Drill library built on the 7-Lever Framework. Fighters doing the work from every corner of the world. $39/month."
>

  <!-- HERO -->
  <section class="bg-white overflow-hidden border-b border-[#0A0A0A]/8">

    <div class="md:hidden w-full overflow-hidden bg-[#0A0A0A]" style="height: 60vw; max-height: 340px;">
      <img
        src="/images/sparring_withnetherlands.png"
        alt="Training session"
        width="1200" height="1500"
        loading="eager"
        class="w-full h-full object-cover object-center opacity-90 grayscale contrast-[1.2] brightness-[0.85]"
      />
    </div>

    <div class="max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-[60%_40%] md:min-h-[88vh]">

      <div class="px-8 md:px-16 lg:px-24 pt-14 md:pt-40 pb-12 md:pb-16 flex flex-col justify-center">
        <p class="text-[var(--ink-soft)] text-[11px] tracking-widest uppercase mb-6">Greatness Community · Founding Members</p>
        <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.85] mb-8"
          style="font-size: clamp(2.8rem, 6vw, 4.5rem);">
          Live with me.<br/>Every week.
        </h1>{/* // NEEDS RAINERS */}
        <p class="text-[#0A0A0A]/60 text-base max-w-[480px] leading-relaxed mb-6">
          Live correction every week. A drill library, added to daily. People who take the craft seriously, from anywhere.
        </p>{/* // NEEDS RAINERS */}
        <p class="text-[#0A0A0A]/35 text-sm max-w-[480px] leading-relaxed mb-10">
          Founding cohort. First workshop July 4. The library grows with us, starting now.
        </p>{/* // NEEDS RAINERS */}

        <div class="flex flex-col gap-3 max-w-[380px]">
          <button
            data-checkout="greatness_monthly"
            class="inline-flex items-center justify-center font-bold text-white px-10 py-4 text-sm tracking-widest uppercase whitespace-nowrap cursor-pointer border-0 transition-opacity duration-150 hover:opacity-85"
            style="background: #6A0DAD;">
            Join the Community · $39/mo →
          </button>
          <p data-checkout-error class="hidden text-[var(--red)] text-xs font-bold tracking-wide">Checkout unavailable — email rainers@theerainers.com</p>
          <a href="#pricing" class="text-center text-[#0A0A0A]/35 text-xs font-bold tracking-widest uppercase hover:text-[#0A0A0A]/60 transition-colors">
            Pay yearly · save $78
          </a>
        </div>

        <p class="text-[11px] text-[#0A0A0A]/25 mt-4">Cancel anytime · Secure checkout via Stripe</p>
      </div>

      <div class="hidden md:block relative overflow-hidden bg-[#0A0A0A]" aria-hidden="true">
        <img
          src="/images/sparring_withnetherlands.png"
          alt=""
          width="1200" height="1500"
          loading="eager"
          class="absolute inset-0 w-full h-full object-cover object-center opacity-90 grayscale contrast-[1.2] brightness-[0.85]"
        />
      </div>

    </div>
  </section>

  <!-- NEXT WORKSHOP -->
  <section class="bg-[#0A0A0A] px-8 md:px-16 lg:px-24 py-6 border-b border-white/5">
    <div class="max-w-[1280px] mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="flex items-center gap-4">
        <span class="inline-block w-2 h-2 rounded-full bg-[#6A0DAD] shrink-0"></span>
        <p class="text-white/60 text-sm">Next workshop · <span class="text-white font-bold">{NEXT_PROVING_GROUND.date} · {NEXT_PROVING_GROUND.time}</span></p>
      </div>
      <button
        data-checkout="greatness_monthly"
        class="text-[#6A0DAD] text-xs font-bold tracking-widest uppercase hover:opacity-70 transition-opacity cursor-pointer bg-transparent border-0 shrink-0">
        Join before then →
      </button>
    </div>
  </section>

  <!-- WHAT'S INSIDE -->
  <section class="bg-white px-8 md:px-16 lg:px-24 py-16 md:py-24 border-b border-[#0A0A0A]/8">
    <div class="max-w-[1280px] mx-auto">
      <p class="text-[var(--ink-soft)] text-[11px] tracking-widest uppercase mb-10">What's Inside</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-px bg-[#0A0A0A]/8">

        <div class="bg-white p-8">
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-4">Weekly</p>
          <h3 class="font-black text-[#0A0A0A] uppercase tracking-tight text-base leading-tight mb-3">The Workshop</h3>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed">Live every week. Camera on. I watch your movement and call out what to fix.</p>
        </div>

        <div class="bg-white p-8">
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-4">Growing</p>
          <h3 class="font-black text-[#0A0A0A] uppercase tracking-tight text-base leading-tight mb-3">Drill Library</h3>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed">Drills filed by lever. New ones added every week. Work what is weakest first.</p>
        </div>

        <div class="bg-white p-8">
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-4">Private</p>
          <h3 class="font-black text-[#0A0A0A] uppercase tracking-tight text-base leading-tight mb-3">Community</h3>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed">Ask between sessions. Post your clips. Work through what is breaking down.</p>
        </div>

        <div class="bg-white p-8">
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-4">Always</p>
          <h3 class="font-black text-[#0A0A0A] uppercase tracking-tight text-base leading-tight mb-3">Session Recordings</h3>
          <p class="text-[#0A0A0A]/50 text-sm leading-relaxed">Every workshop recorded. Watch when you can. Different time zones, same work.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="bg-[#F6F6F6] px-8 md:px-16 lg:px-24 py-16 md:py-24 border-b border-[#0A0A0A]/8">
    <div class="max-w-[1280px] mx-auto">
      <p class="text-[var(--ink-soft)] text-[11px] tracking-widest uppercase mb-10">Membership</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-[2px] max-w-[720px]">

        <!-- Monthly -->
        <div class="bg-white border border-[#0A0A0A]/8 p-10 flex flex-col gap-8">
          <div>
            <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-4">Monthly</p>
            <div class="flex items-baseline gap-1 mb-1">
              <span class="font-black text-[#0A0A0A] tracking-tighter" style="font-size: clamp(2.5rem, 5vw, 3rem);">$39</span>
              <span class="text-[#0A0A0A]/40 text-sm">/month</span>
            </div>
            <p class="text-[#0A0A0A]/30 text-xs">Cancel anytime</p>
          </div>

          <ul class="flex flex-col gap-3">
            <li class="text-[#0A0A0A]/60 text-sm">Weekly workshop (live)</li>
            <li class="text-[#0A0A0A]/60 text-sm">Full drill library access</li>
            <li class="text-[#0A0A0A]/60 text-sm">Private community</li>
            <li class="text-[#0A0A0A]/60 text-sm">Session recordings</li>
          </ul>

          <div>
            <button
              data-checkout="greatness_monthly"
              class="w-full inline-flex items-center justify-center font-bold text-white px-8 py-4 text-sm tracking-widest uppercase cursor-pointer border-0 transition-opacity duration-150 hover:opacity-85"
              style="background: #6A0DAD;">
              Join Monthly →
            </button>
            <p data-checkout-error class="hidden text-[var(--red)] text-xs font-bold tracking-wide mt-2">Checkout unavailable — email rainers@theerainers.com</p>
          </div>
        </div>

        <!-- Annual -->
        <div class="bg-white border-2 p-10 flex flex-col gap-8 relative" style="border-color: #6A0DAD;">
          <div class="absolute -top-px right-6">
            <span class="inline-block text-white text-[9px] font-bold tracking-widest uppercase px-3 py-1.5" style="background: #6A0DAD;">Saves 2 Months</span>
          </div>
          <div>
            <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-4">Annual</p>
            <div class="flex items-baseline gap-1 mb-1">
              <span class="font-black text-[#0A0A0A] tracking-tighter" style="font-size: clamp(2.5rem, 5vw, 3rem);">$390</span>
              <span class="text-[#0A0A0A]/40 text-sm">/year</span>
            </div>
            <p class="text-[#0A0A0A]/30 text-xs">$32.50/month · billed once</p>
          </div>

          <ul class="flex flex-col gap-3">
            <li class="text-[#0A0A0A]/60 text-sm">Everything in Monthly</li>
            <li class="text-[#0A0A0A]/60 text-sm">Two months free</li>
            <li class="text-[#0A0A0A]/60 text-sm">Full year of workshops</li>
            <li class="text-[#0A0A0A]/60 text-sm">Full year of library growth</li>
          </ul>

          <div>
            <button
              data-checkout="greatness_annual"
              class="w-full inline-flex items-center justify-center font-bold text-white px-8 py-4 text-sm tracking-widest uppercase cursor-pointer border-0 transition-opacity duration-150 hover:opacity-85"
              style="background: #6A0DAD;">
              Join Annual →
            </button>
            <p data-checkout-error class="hidden text-[var(--red)] text-xs font-bold tracking-wide mt-2">Checkout unavailable — email rainers@theerainers.com</p>
          </div>
        </div>

      </div>

      <p class="text-[#0A0A0A]/25 text-xs mt-6 max-w-[480px]">Membership renews automatically. Cancel before your next billing date and you will not be charged again. <a href="/legal/refund-policy" class="underline hover:text-[#0A0A0A]/50">Refund Policy</a></p>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="bg-white px-8 md:px-16 lg:px-24 py-16 md:py-24 border-b border-[#0A0A0A]/8">
    <div class="max-w-[720px]">
      <p class="text-[var(--ink-soft)] text-[11px] tracking-widest uppercase mb-6">Who this is for</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.88] mb-8"
        style="font-size: clamp(2rem, 4vw, 3rem);">
        People who take<br/>the craft seriously.
      </h2>{/* // NEEDS RAINERS */}
      <p class="text-[#0A0A0A]/55 text-base leading-relaxed max-w-[560px] mb-10">
        Trains anywhere. Every income. We watch our own movement. We want to fix what is actually broken. The work is the only entry requirement.
      </p>{/* // NEEDS RAINERS */}
      <button
        data-checkout="greatness_monthly"
        class="inline-flex items-center justify-center font-bold text-white px-10 py-4 text-sm tracking-widest uppercase cursor-pointer border-0 transition-opacity duration-150 hover:opacity-85"
        style="background: #6A0DAD;">
        Join the Community · $39/mo →
      </button>
      <p data-checkout-error class="hidden text-[var(--red)] text-xs font-bold tracking-wide mt-2">Checkout unavailable — email rainers@theerainers.com</p>
    </div>
  </section>

  <!-- PRIVATE ARCHITECTURE FOOTNOTE -->
  <section class="bg-white px-8 md:px-16 lg:px-24 py-10 border-b border-[#0A0A0A]/8">
    <div class="max-w-[1280px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-[#0A0A0A]/30 text-sm">Need the full framework built around your specific structure?</p>
      <a href="/command" class="text-[#0A0A0A]/35 text-xs font-bold tracking-widest uppercase hover:text-[#0A0A0A]/60 transition-colors shrink-0">1-on-1 Coaching — Application Only →</a>
    </div>
  </section>

  <!-- SCRIPTURE -->
  <section class="bg-[#0A0A0A] px-8 md:px-16 lg:px-24 py-20">
    <div class="max-w-[680px] mx-auto">
      <p class="font-black uppercase tracking-tighter leading-[0.88] text-white/50 text-2xl md:text-3xl mb-4">
        "As iron sharpens iron, so one person sharpens another."
      </p>
      <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase">Proverbs 27:17</p>
    </div>
  </section>

</Layout>
