---
import Layout from '../layouts/Base.astro';
import Testimonials from '../components/site/Testimonials.astro';

// Aug 2 2026 00:00 Europe/Lisbon = Aug 1 2026 23:00:00 UTC
const FOOTWORK_FREE_UNTIL = new Date('2026-08-01T23:00:00Z');
const isFootworkFree = new Date() < FOOTWORK_FREE_UNTIL;

// Defense Workshop early bird until Aug 8 23:59 Lisbon = Aug 8 22:59 UTC
const EARLY_BIRD_UNTIL = new Date('2026-08-08T22:59:00Z');
const isEarlyBird = new Date() < EARLY_BIRD_UNTIL;
const workshopPrice = isEarlyBird ? '$39' : '$49';
const workshopCheckoutKey = isEarlyBird ? 'defense_workshop_early' : 'defense_workshop_standard';

const products = [
  {
    image: '/images/3d_thefootworkblueprint_cover.jpg',
    tag: isFootworkFree ? 'Free · Start Here' : 'Blueprint',
    title: 'Footwork Blueprint',
    sub: '56 Rounds · Orthodox + Southpaw',
    desc: 'The base layer. Full PDF. No payment.',
    price: isFootworkFree ? 'FREE' : '$9',
    price_note: null,
    href: isFootworkFree ? '/foundation' : null,
    checkoutKey: isFootworkFree ? null : 'footwork',
    page: '/foundation',
    cta: isFootworkFree ? 'Get the PDF' : 'Get the Blueprint',
    featured: true,
  },
  {
    image: '/images/shadowboxingblueprint_covernew.png',
    tag: 'Blueprint',
    title: 'Shadowboxing Blueprint',
    sub: '50+ Rounds · Orthodox + Southpaw',
    desc: 'The next layer after footwork. Full PDF.',
    price: '$19',
    price_note: null,
    href: null,
    checkoutKey: 'shadowboxing',
    page: '/shadowboxing-blueprint',
    cta: 'Get the Blueprint',
    featured: false,
  },
  {
    image: '/images/3d_thebundle_cover.png',
    tag: 'Bundle · Best Value',
    title: 'Complete Bundle',
    sub: 'Footwork + Shadowboxing · 100+ Rounds',
    desc: 'Both blueprints. The base and what builds on it.',
    price: '$39',
    price_note: null,
    href: null,
    checkoutKey: 'bundle',
    page: null,
    cta: 'Get the Bundle',
    featured: false,
  },
];

const productSchema = JSON.stringify(products.map(p => ({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": p.title,
  "description": p.desc,
  "url": "https://theerainers.com/shop",
  "brand": { "@type": "Brand", "name": "Thee Rainers" },
  "offers": {
    "@type": "Offer",
    "price": parseFloat(p.price.replace(/[^0-9.]/g, '')) || 0,
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://theerainers.com/shop",
  },
})));
---
<Layout title="Shop · Thee Rainers" description="Step-by-step systems built for boxing. One-time purchase. Download and own it.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={productSchema} />
  </Fragment>

  <section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 pt-28 md:pt-36 pb-20">
    <div class="max-w-[1100px] mx-auto">

      <div class="mb-12">
        <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-3">Training</p>
        <h1 class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-[0.88]"
          style="font-size: clamp(2.5rem, 5vw, 4rem);">
          Everything in order.
        </h1>
        <div class="h-0.5 w-12 bg-[var(--terra)] mt-5 mb-4"></div>
        <p class="text-[#0B0B0C]/45 text-sm">No gym required.</p>
      </div>

      <!-- Blueprint cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {products.map(p => (
          <div class={`tr-card flex flex-col group transition-colors duration-200 relative ${p.featured ? 'border-2 border-[var(--terra)]/40 hover:border-[var(--terra)]' : 'border border-[#0B0B0C]/10 hover:border-[var(--terra)]/40'}`}>
            {p.featured && (
              <div class="absolute top-3 left-3 z-10 bg-[var(--terra)] text-white text-[9px] font-bold tracking-widest uppercase px-2 py-1">
                {p.tag}
              </div>
            )}
            <a href={p.page ?? '/shop'} aria-label={`Learn more about ${p.title}`}
              class={`overflow-hidden relative block ${p.featured ? 'bg-[#0B0B0C]' : 'bg-[var(--warm)]'}`}>
              <img src={p.image} alt={p.title}
                loading="lazy"
                class="w-full object-cover aspect-[4/3] group-hover:scale-[1.02] transition-transform duration-300" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent pointer-events-none"></div>
            </a>
            <div class="bg-white p-5 flex flex-col flex-1">
              <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-2">{p.tag}</p>
              <h2 class="font-black text-[#0B0B0C] uppercase tracking-tight text-xl leading-tight mb-1">
                {p.page ? (
                  <a href={p.page} class="hover:text-[var(--terra)] transition-colors">{p.title}</a>
                ) : p.title}
              </h2>
              <p class="text-[#0B0B0C]/50 text-xs mb-3 font-bold">{p.sub}</p>
              <p class="text-[#0B0B0C]/60 text-xs leading-relaxed flex-1">{p.desc}</p>
              <div class="mt-4 flex items-center justify-between gap-3">
                <div>
                  <span class="font-black text-[#0B0B0C] text-2xl">{p.price}</span>
                  {p.price_note && <p class="text-[10px] text-[#0B0B0C]/50 mt-0.5">{p.price_note}</p>}
                </div>
                {p.checkoutKey ? (
                  <button type="button" data-checkout={p.checkoutKey} class="tr-btn" style="padding: 0.75rem 1.5rem; font-size: 0.625rem;">
                    {p.cta}
                  </button>
                ) : (
                  <a href={p.href ?? '/foundation'} class="tr-btn" style="padding: 0.75rem 1.5rem; font-size: 0.625rem;">
                    {p.cta}
                  </a>
                )}
              </div>
              {p.page && (
                <p class="mt-3 text-[11px]">
                  <a href={p.page} class="text-[var(--navy)] font-bold tracking-widest uppercase hover:opacity-70 transition-opacity">
                    Learn more
                  </a>
                </p>
              )}
              {p.checkoutKey && (
                <p class="mt-2 text-[10px] text-[#0B0B0C]/30">
                  Secure checkout via Stripe · <a href="/legal/refund-policy" class="underline hover:text-[#0B0B0C]/50">Refund Policy</a>
                </p>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Proof -->
      <div class="mt-12 -mx-6 md:-mx-12 lg:-mx-20 border-t border-b border-[#0B0B0C]/8">
        <Testimonials filter="remote" heading="Trained from the blueprint" kicker="Results · On Their Own" />
      </div>

      <!-- FAQ -->
      <div class="mt-10 pt-10 border-t border-[#0B0B0C]/8">
        <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter text-xl leading-tight mb-6">Common Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6 max-w-[900px]">
          <div>
            <p class="font-bold text-[#0B0B0C] text-sm mb-1">How do I get access after purchase?</p>
            <p class="text-[#0B0B0C]/50 text-xs leading-relaxed">A download link is sent to the email you use at checkout. It arrives within a few minutes and is valid for 7 days. Save the PDF once downloaded.</p>
          </div>
          <div>
            <p class="font-bold text-[#0B0B0C] text-sm mb-1">Is this a subscription?</p>
            <p class="text-[#0B0B0C]/50 text-xs leading-relaxed">No. Both Blueprints are one-time purchases. Pay once, own it.</p>
          </div>
          <div>
            <p class="font-bold text-[#0B0B0C] text-sm mb-1">Can I use this without a gym?</p>
            <p class="text-[#0B0B0C]/50 text-xs leading-relaxed">Yes. The Footwork Blueprint requires no equipment. The Shadowboxing Blueprint works anywhere you have space to move.</p>
          </div>
          <div>
            <p class="font-bold text-[#0B0B0C] text-sm mb-1">What if I want live coaching alongside it?</p>
            <p class="text-[#0B0B0C]/50 text-xs leading-relaxed">The Weekly Session is live every Tuesday with Rainers. <a href="/community" class="text-[var(--navy)] font-bold hover:opacity-70 transition-opacity">Learn more.</a></p>
          </div>
        </div>
      </div>

      <!-- Defense Workshop -->
      <div class="mt-10">
        <div class="bg-[#0B0B0C] flex flex-col md:flex-row group border border-white/5 hover:border-white/15 transition-colors duration-200">
          <div class="relative overflow-hidden md:w-[40%] shrink-0" style="min-height: 200px;">
            <img src="/images/defense_workshop.webp" alt="Defense Workshop"
              width="1920" height="1080"
              class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-[1.02] transition-transform duration-500" />
            <div class="absolute inset-0 bg-[#0B0B0C]/45"></div>
          </div>
          <div class="p-8 flex flex-col flex-1 justify-between">
            <div>
              <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-3">
                Live · Aug 29 · Replay Included{isEarlyBird ? ' · Early Bird' : ''}
              </p>
              <h2 class="font-black text-white uppercase tracking-tight text-2xl leading-tight mb-3">Defense Workshop</h2>
              <p class="text-white/40 text-xs leading-relaxed max-w-[480px]">Camera on. Real-time correction on your movement. The mechanical structure to hit, exit, and reset. Replay included.</p>
            </div>
            <div class="flex items-center justify-between mt-8 gap-4">
              <div>
                <span class="font-black text-white text-2xl">{workshopPrice}</span>
                {isEarlyBird && <p class="text-[10px] text-white/40 mt-0.5">Early bird until Aug 8. Goes to $49.</p>}
              </div>
              <div class="flex flex-col items-end gap-1">
                <a href="/defense-workshop" class="tr-btn" style="padding: 0.6rem 1.25rem; font-size: 0.625rem;">
                  Reserve Seat
                </a>
                <p class="text-[11px] text-white/45 leading-relaxed">
                  <a href="/legal/terms" class="underline hover:text-white">Terms</a> &amp; <a href="/legal/refund-policy" class="underline hover:text-white">Refund Policy</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Community teaser -->
      <div class="mt-4 border overflow-hidden border-[var(--purple)]/25">
        <div class="p-8 md:p-10 flex flex-col md:flex-row md:items-center justify-between gap-6 bg-white">
          <div>
            <p class="text-[var(--purple)] text-[10px] tracking-widest uppercase font-bold mb-3">The Weekly Session</p>
            <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter text-2xl leading-tight mb-3">
              Live Reps With Rainers.
            </h2>
            <p class="text-[#0B0B0C]/50 text-sm leading-relaxed max-w-[520px]">
              The Weekly Session with Rainers every Tuesday. Live correction on your movement. Private community. Drill library. $39/mo.
            </p>
          </div>
          <a href="/community"
            class="shrink-0 inline-flex items-center justify-center font-bold text-white px-8 py-4 text-[0.625rem] tracking-widest uppercase transition-opacity duration-150 hover:opacity-85"
            style="background: var(--purple);">
            See the Community
          </a>
        </div>
      </div>

      <!-- Start nudge -->
      <div class="mt-10 pt-10 border-t border-[#0B0B0C]/8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        {isFootworkFree ? (
          <>
            <p class="text-[#0B0B0C]/30 text-sm">Start free with the Footwork Blueprint. Build the base first.</p>
            <a href="/foundation" class="text-[var(--navy)] text-xs font-bold tracking-widest uppercase hover:opacity-60 transition-opacity whitespace-nowrap">
              Get the Free Blueprint
            </a>
          </>
        ) : (
          <>
            <p class="text-[#0B0B0C]/30 text-sm">Start with the Footwork Blueprint. The base carries everything.</p>
            <button type="button" data-checkout="footwork" class="text-[var(--navy)] text-xs font-bold tracking-widest uppercase hover:opacity-60 transition-opacity whitespace-nowrap bg-transparent border-0 p-0 cursor-pointer">
              Get the Blueprint · $9
            </button>
          </>
        )}
      </div>

    </div>
  </section>

  <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 py-20">
    <div class="max-w-[680px] mx-auto text-center">
      <p class="font-black uppercase tracking-tighter leading-[0.88] text-white/40 mb-5"
        style="font-size: clamp(1.5rem, 3.5vw, 2.25rem);">
        "I do not run aimlessly. I do not box as one beating the air."
      </p>
      <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">1 Corinthians 9:26-27</p>
    </div>
  </section>

  <!-- GA4 view_item_list -->
  <script is:inline>
    if (typeof window !== 'undefined' && window.trackEvent) {
      var now = Date.now();
      var footworkFreeUntil = new Date('2026-08-01T23:00:00Z').getTime();
      var earlyBirdUntil = new Date('2026-08-08T22:59:00Z').getTime();
      var footworkPrice = now < footworkFreeUntil ? 0 : 9;
      var workshopPrice = now < earlyBirdUntil ? 39 : 49;
      window.trackEvent('view_item_list', {
        item_list_id: 'shop',
        item_list_name: 'Shop: Blueprints + Workshops',
        ecommerce: {
          currency: 'USD',
          items: [
            { item_id: 'footwork_blueprint',     item_name: 'Footwork Blueprint',    price: footworkPrice, quantity: 1, item_category: footworkPrice === 0 ? 'lead_magnet' : 'one_time' },
            { item_id: 'shadowboxing_blueprint', item_name: 'Shadowboxing Blueprint', price: 19, quantity: 1, item_category: 'one_time' },
            { item_id: 'complete_bundle',        item_name: 'Complete Bundle',        price: 39, quantity: 1, item_category: 'one_time' },
            { item_id: 'defense_workshop',       item_name: 'Defense Workshop',       price: workshopPrice, quantity: 1, item_category: 'live_event' }
          ]
        }
      });
    }
  </script>

</Layout>
