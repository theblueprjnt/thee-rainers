---
import Layout from '../layouts/Base.astro';
---
<Layout
  title="Step Into The Ring · The Complete Boxing Fundamentals Masterclass | Thee Rainers"
  description="Ten step-by-step video lessons plus the Footwork Blueprint PDF (56+ rounds). Stance to sparring-ready, built in order so every rep stands on the one before it.">

  <!-- HERO -->
  <section id="buy-bar-sentinel" class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 pt-28 md:pt-40 pb-16 md:pb-24">
    <div class="max-w-[820px] mx-auto text-center">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase mb-4">Masterclass</p>
      <h1 class="font-black text-white uppercase tracking-tighter leading-[0.9] mb-6"
        style="font-size: clamp(2.5rem, 6vw, 4.5rem);">
        Step Into The Ring.
      </h1>
      <p class="text-white/60 text-base md:text-lg leading-relaxed mb-10 max-w-[560px] mx-auto">
        The complete boxing fundamentals masterclass in ten lessons.
      </p>

      <button type="button" class="vimeo-facade relative block w-full bg-white border border-white/10 mb-10 max-w-[720px] mx-auto overflow-hidden cursor-pointer" style="padding-top: 56.25%;" data-vimeo-id="1244251517" data-vimeo-title="vsl" aria-label="Play video">
        <img src="/images/course-vsl-thumb.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
        <span class="absolute inset-0 bg-[#0A0A0A]/25 flex items-center justify-center">
          <span class="w-16 h-16 md:w-20 md:h-20 rounded-full bg-white/90 flex items-center justify-center text-[#0A0A0A] text-2xl">▶</span>
        </span>
      </button>

      <a href="#curriculum" class="tr-btn inline-flex">
        See What's Inside ↓
      </a>

      <p class="text-white/40 text-[11px] tracking-widest uppercase mt-6">Join 100+ aspiring fighters and athletes worldwide</p>
    </div>
  </section>

  <!-- CURRICULUM -->
  <section id="curriculum" class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-16 md:py-24">
    <div class="max-w-[1000px] mx-auto">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase mb-4">What's inside</p>
      <h2 class="font-black text-white uppercase tracking-tighter text-3xl md:text-4xl leading-[0.9] mb-10">
        The structure.
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        <div class="bg-white p-4 md:p-5 flex flex-col items-center text-center gap-2">
          <span class="w-9 h-9 rounded-full border-2 border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-xs font-bold shrink-0">01</span>
          <p class="font-bold text-[#0A0A0A] text-sm leading-tight">Intro & Safety Precautions</p>
        </div>
        <div class="bg-white p-4 md:p-5 flex flex-col items-center text-center gap-2">
          <span class="w-9 h-9 rounded-full border-2 border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-xs font-bold shrink-0">02</span>
          <p class="font-bold text-[#0A0A0A] text-sm leading-tight">How to Wrap Your Hands</p>
        </div>
        <div class="bg-white p-4 md:p-5 flex flex-col items-center text-center gap-2">
          <span class="w-9 h-9 rounded-full border-2 border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-xs font-bold shrink-0">03</span>
          <p class="font-bold text-[#0A0A0A] text-sm leading-tight">Boxing Mindset</p>
        </div>
        <div class="bg-white p-4 md:p-5 flex flex-col items-center text-center gap-2">
          <span class="w-9 h-9 rounded-full border-2 border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-xs font-bold shrink-0">04</span>
          <p class="font-bold text-[#0A0A0A] text-sm leading-tight">Athletic Fight Stance</p>
        </div>
        <div class="bg-white p-4 md:p-5 flex flex-col items-center text-center gap-2">
          <span class="w-9 h-9 rounded-full border-2 border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-xs font-bold shrink-0">05</span>
          <p class="font-bold text-[#0A0A0A] text-sm leading-tight">Boxing Settings</p>
        </div>
        <div class="bg-white p-4 md:p-5 flex flex-col items-center text-center gap-2">
          <span class="w-9 h-9 rounded-full border-2 border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-xs font-bold shrink-0">06</span>
          <p class="font-bold text-[#0A0A0A] text-sm leading-tight">Defense</p>
        </div>
        <div class="bg-white p-4 md:p-5 flex flex-col items-center text-center gap-2">
          <span class="w-9 h-9 rounded-full border-2 border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-xs font-bold shrink-0">07</span>
          <p class="font-bold text-[#0A0A0A] text-sm leading-tight">Punches</p>
        </div>
        <div class="bg-white p-4 md:p-5 flex flex-col items-center text-center gap-2">
          <span class="w-9 h-9 rounded-full border-2 border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-xs font-bold shrink-0">08</span>
          <p class="font-bold text-[#0A0A0A] text-sm leading-tight">How to Hit the Heavy Bag</p>
        </div>
        <div class="bg-white p-4 md:p-5 flex flex-col items-center text-center gap-2">
          <span class="w-9 h-9 rounded-full border-2 border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-xs font-bold shrink-0">09</span>
          <p class="font-bold text-[#0A0A0A] text-sm leading-tight">Training Plans</p>
        </div>
        <div class="bg-white p-4 md:p-5 flex flex-col items-center text-center gap-2">
          <span class="w-9 h-9 rounded-full border-2 border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-xs font-bold shrink-0">10</span>
          <p class="font-bold text-[#0A0A0A] text-sm leading-tight">Footwork In-Depth (4 Bases)</p>
        </div>
        <div class="bg-white p-4 md:p-5 flex flex-col items-center text-center gap-2">
          <span class="w-9 h-9 rounded-full border-2 border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-[9px] font-bold shrink-0">BONUS</span>
          <p class="font-bold text-[#0A0A0A] text-sm leading-tight">6-Week Structure + Video</p>
        </div>
        <div class="bg-white p-4 md:p-5 flex flex-col items-center text-center gap-2">
          <span class="w-9 h-9 rounded-full border-2 border-[var(--terra)] text-[var(--terra)] flex items-center justify-center text-[8px] font-bold shrink-0 leading-none text-center">PDF</span>
          <p class="font-bold text-[#0A0A0A] text-sm leading-tight">Footwork Blueprint (56+ Rounds)</p>
        </div>
      </div>

      <!-- Photo strip — breaks up the grid, gives people something to visualize -->
      <div class="grid grid-cols-3 gap-3 mt-3">
        <div class="aspect-[4/3] overflow-hidden">
          <picture>
            <source srcset="/images/rainers-training-opt.webp" type="image/webp" />
            <img src="/images/rainers-training-opt.jpg" alt="" width="600" height="450" loading="lazy" class="w-full h-full object-cover" />
          </picture>
        </div>
        <div class="aspect-[4/3] overflow-hidden">
          <picture>
            <source srcset="/images/padwork-outdoor-opt.webp" type="image/webp" />
            <img src="/images/padwork-outdoor-opt.jpg" alt="" width="600" height="450" loading="lazy" class="w-full h-full object-cover object-top" />
          </picture>
        </div>
        <div class="aspect-[4/3] overflow-hidden">
          <picture>
            <source srcset="/images/corner-coach-opt.webp" type="image/webp" />
            <img src="/images/corner-coach-opt.jpg" alt="" width="600" height="450" loading="lazy" class="w-full h-full object-cover" />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- MID-PAGE CTA -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 pb-16 md:pb-20">
    <div class="max-w-[680px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 border-t border-white/10 pt-10">
      <div class="text-center sm:text-left">
        <p class="text-white/40 text-[11px] tracking-widest uppercase mb-1">Step Into The Ring · $57</p>
        <p class="font-black text-white uppercase tracking-tighter text-xl leading-tight">Ready to start?</p>
      </div>
      <button type="button" data-checkout="masterclass" class="tr-btn shrink-0">
        Get Access · $57 →
      </button>
    </div>
  </section>

  <!-- TESTIMONIALS ROW (video) -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-16 md:py-24">
    <div class="max-w-[1140px] mx-auto">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase mb-4 text-center">What others say</p>
      <h2 class="font-black text-white uppercase tracking-tighter text-2xl md:text-3xl leading-[0.95] mb-12 text-center">
        They did it. So can you.
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        <div>
          <button type="button" class="vimeo-facade relative block w-full bg-white border border-white/10 mb-3 overflow-hidden cursor-pointer" style="padding-top: 100%;" data-vimeo-id="1244252839" data-vimeo-title="Jacob's review" aria-label="Play Jacob's review">
            <img src="/images/course-jacob-thumb.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <span class="absolute inset-0 bg-[#0A0A0A]/25 flex items-center justify-center">
              <span class="w-10 h-10 rounded-full bg-white/90 flex items-center justify-center text-[#0A0A0A] text-sm">▶</span>
            </span>
          </button>
          <p class="text-white/70 text-xs leading-relaxed mb-2">"I lost 4.8kg in 6 weeks and felt more powerful than ever."</p>
          <p class="text-white/35 text-[10px] tracking-widest uppercase">Jacob</p>
        </div>
        <div>
          <button type="button" class="vimeo-facade relative block w-full bg-white border border-white/10 mb-3 overflow-hidden cursor-pointer" style="padding-top: 100%;" data-vimeo-id="1244253311" data-vimeo-title="Richard's review" aria-label="Play Richard's review">
            <img src="/images/course-richard-thumb.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <span class="absolute inset-0 bg-[#0A0A0A]/25 flex items-center justify-center">
              <span class="w-10 h-10 rounded-full bg-white/90 flex items-center justify-center text-[#0A0A0A] text-sm">▶</span>
            </span>
          </button>
          <p class="text-white/70 text-xs leading-relaxed mb-2">"Every session felt different. A good mix of techniques and drills that actually made me better."</p>
          <p class="text-white/35 text-[10px] tracking-widest uppercase">Richard</p>
        </div>
        <div>
          <button type="button" class="vimeo-facade relative block w-full bg-white border border-white/10 mb-3 overflow-hidden cursor-pointer" style="padding-top: 100%;" data-vimeo-id="1244253557" data-vimeo-title="Elizabeth's review" aria-label="Play Elizabeth's review">
            <img src="/images/course-elizabeth-thumb.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <span class="absolute inset-0 bg-[#0A0A0A]/25 flex items-center justify-center">
              <span class="w-10 h-10 rounded-full bg-white/90 flex items-center justify-center text-[#0A0A0A] text-sm">▶</span>
            </span>
          </button>
          <p class="text-white/70 text-xs leading-relaxed mb-2">"I gained strength and confidence I never thought possible."</p>
          <p class="text-white/35 text-[10px] tracking-widest uppercase">Elizabeth</p>
        </div>
        <div>
          <button type="button" class="vimeo-facade relative block w-full bg-white border border-white/10 mb-3 overflow-hidden cursor-pointer" style="padding-top: 100%;" data-vimeo-id="1244255475" data-vimeo-title="Kristaps's review" aria-label="Play Kristaps's review">
            <img src="/images/course-kristaps-thumb.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <span class="absolute inset-0 bg-[#0A0A0A]/25 flex items-center justify-center">
              <span class="w-10 h-10 rounded-full bg-white/90 flex items-center justify-center text-[#0A0A0A] text-sm">▶</span>
            </span>
          </button>
          <p class="text-white/70 text-xs leading-relaxed mb-2">"After the first month, I know sparring will be easier and more fun."</p>
          <p class="text-white/35 text-[10px] tracking-widest uppercase">Kristaps</p>
        </div>
        <div>
          <button type="button" class="vimeo-facade relative block w-full bg-white border border-white/10 mb-3 overflow-hidden cursor-pointer" style="padding-top: 100%;" data-vimeo-id="1244255737" data-vimeo-title="Giancarlo's review" aria-label="Play Giancarlo's review">
            <img src="/images/course-giancarlo-thumb.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <span class="absolute inset-0 bg-[#0A0A0A]/25 flex items-center justify-center">
              <span class="w-10 h-10 rounded-full bg-white/90 flex items-center justify-center text-[#0A0A0A] text-sm">▶</span>
            </span>
          </button>
          <p class="text-white/35 text-[10px] tracking-widest uppercase">Giancarlo</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.vimeo-facade');
      if (!btn) return;
      var id = btn.dataset.vimeoId;
      var title = btn.dataset.vimeoTitle || '';
      var wrap = document.createElement('div');
      wrap.className = btn.className.replace('vimeo-facade', '').replace('cursor-pointer', '').trim();
      wrap.setAttribute('style', btn.getAttribute('style') || '');
      var iframe = document.createElement('iframe');
      iframe.src = 'https://player.vimeo.com/video/' + id + '?badge=0&autopause=0&player_id=0&app_id=58479&autoplay=1';
      iframe.className = 'absolute inset-0 w-full h-full';
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share');
      iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      iframe.allowFullscreen = true;
      iframe.title = title;
      wrap.appendChild(iframe);
      btn.replaceWith(wrap);
    });
  </script>

  <!-- STAT CARDS -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-16 md:py-24">
    <div class="max-w-[1000px] mx-auto grid grid-cols-1 md:grid-cols-3 gap-3">
      <div class="bg-white p-8 text-center">
        <p class="font-black text-[#0A0A0A] uppercase tracking-tighter text-lg mb-3">Real Progress</p>
        <p class="text-[#0A0A0A]/65 text-sm leading-relaxed">Step-by-step structure. Every lesson builds on the one before.</p>
      </div>
      <div class="bg-white p-8 text-center">
        <p class="font-black text-[#0A0A0A] uppercase tracking-tighter text-lg mb-3">100+ Students, 500K+ Followers</p>
        <p class="text-[#0A0A0A]/65 text-sm leading-relaxed">Aspiring fighters and athletes training this system worldwide.</p>
      </div>
      <div class="bg-white p-8 text-center">
        <p class="font-black text-[#0A0A0A] uppercase tracking-tighter text-lg mb-3">Beginner to Advanced</p>
        <p class="text-[#0A0A0A]/65 text-sm leading-relaxed">Start from zero or sharpen what you already have. Every lesson moves you forward.</p>
      </div>
    </div>
  </section>

  <!-- 5-STAR REVIEWS -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-16 md:py-24">
    <div class="max-w-[920px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-10">
      <div class="text-center md:text-left">
        <p class="text-[var(--terra)] text-base tracking-widest mb-4">★★★★★</p>
        <p class="text-white text-base leading-relaxed mb-4">"After the first month of training I know going into sparrings will be a lot easier for me and more fun."</p>
        <p class="text-white/40 text-[11px] tracking-widest uppercase">Kristaps</p>
      </div>
      <div class="text-center md:text-left">
        <p class="text-[var(--terra)] text-base tracking-widest mb-4">★★★★★</p>
        <p class="text-white text-base leading-relaxed mb-4">"I've already got a lot of value out of it, going back to it for the second time because I know there's so much more that I didn't get the first time."</p>
        <p class="text-white/40 text-[11px] tracking-widest uppercase">Kevin</p>
      </div>
    </div>
  </section>

  <!-- MID-PAGE CTA -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 pb-16 md:pb-20">
    <div class="max-w-[680px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 border-t border-white/10 pt-10">
      <div class="text-center sm:text-left">
        <p class="text-white/40 text-[11px] tracking-widest uppercase mb-1">Step Into The Ring · $57</p>
        <p class="font-black text-white uppercase tracking-tighter text-xl leading-tight">Ready to start?</p>
      </div>
      <button type="button" data-checkout="masterclass" class="tr-btn shrink-0">
        Get Access · $57 →
      </button>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-16 md:py-24">
    <div class="max-w-[720px] mx-auto">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase mb-4">What's inside</p>
      <h2 class="font-black text-white uppercase tracking-tighter text-2xl md:text-3xl leading-[0.95] mb-8">
        What's in it?
      </h2>
      <ul class="flex flex-col gap-4">
        <li class="flex gap-3 items-baseline"><span class="text-[var(--terra)] font-bold shrink-0">◆</span><p class="text-white/75 text-base leading-relaxed">Step-by-step structure. Every lesson builds on the last.</p></li>
        <li class="flex gap-3 items-baseline"><span class="text-[var(--terra)] font-bold shrink-0">◆</span><p class="text-white/75 text-base leading-relaxed">Ten video lessons covering the complete boxing fundamentals.</p></li>
        <li class="flex gap-3 items-baseline"><span class="text-[var(--terra)] font-bold shrink-0">◆</span><p class="text-white/75 text-base leading-relaxed">Bonus: the 6-week structure, with a video walkthrough.</p></li>
        <li class="flex gap-3 items-baseline"><span class="text-[var(--terra)] font-bold shrink-0">◆</span><p class="text-white/75 text-base leading-relaxed">Bonus: the Footwork Blueprint PDF, 56+ rounds of drills.</p></li>
        <li class="flex gap-3 items-baseline"><span class="text-[var(--terra)] font-bold shrink-0">◆</span><p class="text-white/75 text-base leading-relaxed">Direct email access to ask Rainers questions.</p></li>
        <li class="flex gap-3 items-baseline"><span class="text-[var(--terra)] font-bold shrink-0">◆</span><p class="text-white/75 text-base leading-relaxed">Lifetime access. Revisit any lesson whenever you want.</p></li>
        <li class="flex gap-3 items-baseline"><span class="text-[var(--terra)] font-bold shrink-0">◆</span><p class="text-white/75 text-base leading-relaxed">One-time payment.</p></li>
      </ul>
    </div>
  </section>

  <!-- COMPARISON TABLE -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-16 md:py-24">
    <div class="max-w-[820px] mx-auto">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase mb-4">Why this and not free content</p>
      <h2 class="font-black text-white uppercase tracking-tighter text-2xl md:text-3xl leading-[0.95] mb-10">
        No more random videos.
      </h2>
      <div class="bg-white overflow-x-auto">
        <div class="grid grid-cols-[1fr_auto_auto] gap-4 px-5 py-3 border-b border-[#0A0A0A]/10 min-w-[480px]">
          <span class="text-[#0A0A0A]/40 text-[10px] tracking-widest uppercase">Feature</span>
          <span class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold w-32 text-center">Step Into The Ring</span>
          <span class="text-[#0A0A0A]/40 text-[10px] tracking-widest uppercase w-32 text-center">Free YouTube</span>
        </div>
        <div class="grid grid-cols-[1fr_auto_auto] gap-4 px-5 py-3 border-b border-[#0A0A0A]/10 items-center min-w-[480px]">
          <span class="text-[#0A0A0A] text-sm">Structured, step-by-step path</span>
          <span class="text-[#0A0A0A] text-sm font-bold w-32 text-center">Yes</span>
          <span class="text-[#0A0A0A]/40 text-sm w-32 text-center">No</span>
        </div>
        <div class="grid grid-cols-[1fr_auto_auto] gap-4 px-5 py-3 border-b border-[#0A0A0A]/10 items-center min-w-[480px]">
          <span class="text-[#0A0A0A] text-sm">Built for boxing fundamentals specifically</span>
          <span class="text-[#0A0A0A] text-sm font-bold w-32 text-center">100% Focused</span>
          <span class="text-[#0A0A0A]/40 text-sm w-32 text-center">Mixed, generic</span>
        </div>
        <div class="grid grid-cols-[1fr_auto_auto] gap-4 px-5 py-3 border-b border-[#0A0A0A]/10 items-center min-w-[480px]">
          <span class="text-[#0A0A0A] text-sm">Direct access to ask questions</span>
          <span class="text-[#0A0A0A] text-sm font-bold w-32 text-center">Yes</span>
          <span class="text-[#0A0A0A]/40 text-sm w-32 text-center">No</span>
        </div>
        <div class="grid grid-cols-[1fr_auto_auto] gap-4 px-5 py-3 items-center min-w-[480px]">
          <span class="text-[#0A0A0A] text-sm">One-time payment</span>
          <span class="text-[#0A0A0A] text-sm font-bold w-32 text-center">Yes</span>
          <span class="text-[#0A0A0A]/40 text-sm w-32 text-center">Ad-supported, endless search</span>
        </div>
      </div>
    </div>
  </section>

  <!-- BONUS STACK + PRICE -->
  <section id="offer" class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-16 md:py-24">
    <div class="max-w-[680px] mx-auto">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase mb-4 text-center">What you'll get</p>
      <h2 class="font-black text-white uppercase tracking-tighter text-2xl md:text-3xl leading-[0.95] mb-10 text-center">
        Step Into The Ring
      </h2>

      <p class="text-white/75 text-base leading-relaxed mb-8 text-center">Ten video lessons plus the Footwork Blueprint. Everything you need to go from first rep to sparring-ready.</p>

