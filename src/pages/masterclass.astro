<script>
  {
    const bar = document.getElementById('sticky-bar') as HTMLElement | null;
    const sentinel = document.getElementById('buy-bar-sentinel');
    const finalCta = document.getElementById('final-cta-section');
    if (bar && sentinel && finalCta) {
      let heroGone = false;
      let finalVisible = false;
      function sync() {
        const show = heroGone && !finalVisible;
        bar.classList.toggle('translate-y-full', !show);
        bar.setAttribute('aria-hidden', String(!show));
      }
      new IntersectionObserver(([e]) => { heroGone = !e.isIntersecting; sync(); }).observe(sentinel);
      new IntersectionObserver(([e]) => { finalVisible = e.isIntersecting; sync(); }).observe(finalCta);
    }
  }
</script>
