---
import Base from '../../layouts/Base.astro';
import PurchaseMoment from '../../components/site/PurchaseMoment.astro';
---
<Base title="Shadowboxing Blueprint · Purchase Confirmed | Thee Rainers">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <section class="bg-white px-8 md:px-16 lg:px-24 pt-32 pb-20">
    <div class="max-w-[720px] mx-auto w-full">

      <PurchaseMoment
        productName="The Shadowboxing Blueprint"
        firstActionCopy="Start with Session 1. Run it three times before moving to Session 2."
        primaryLabel="Take the 7-Lever Audit →"
        primaryHref="/lever-audit-quiz"
      />

      <div class="border border-[#0A0A0A]/8 p-8 mb-12">
        <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-6">What to expect</p>
        <div class="flex flex-col divide-y divide-[#0A0A0A]/8">
          <div class="flex justify-between py-3">
            <span class="text-[#0A0A0A]/35 text-sm">Delivery</span>
            <span class="text-[#0A0A0A]/70 text-sm font-bold">Email, arrives within minutes</span>
          </div>
          <div class="flex justify-between py-3">
            <span class="text-[#0A0A0A]/35 text-sm">Format</span>
            <span class="text-[#0A0A0A]/70 text-sm font-bold">PDF. The Shadowboxing Blueprint</span>
          </div>
          <div class="flex justify-between py-3">
            <span class="text-[#0A0A0A]/35 text-sm">Download window</span>
            <span class="text-[#0A0A0A]/70 text-sm font-bold">7 days from purchase</span>
          </div>
          <div class="flex justify-between py-3">
            <span class="text-[#0A0A0A]/35 text-sm">No email?</span>
            <span class="text-[#0A0A0A]/70 text-sm font-bold">Check spam · rainers@theerainers.com</span>
          </div>
        </div>
      </div>

      <!-- WELCOME VIDEO SLOT -->
      <div class="mb-12">
        <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-4">Watch while you wait</p>
        <div class="aspect-video w-full overflow-hidden bg-[#0A0A0A]">
          <iframe
            src="https://www.youtube.com/embed/vdUDuFRUqGo"
            title="Why You Can't Defend Yourself"
            class="w-full h-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <p class="text-[#0A0A0A]/30 text-[10px] tracking-wide mt-3">The structural problem the Blueprint is designed to solve. From the ground up.</p>
      </div>

      <div class="border-l-2 border-[var(--blue)] pl-6 mb-12">
        <p class="text-[#0A0A0A]/30 text-[10px] tracking-widest uppercase mb-2">Do this before your next session</p>
        <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-xl leading-tight mb-3">Know your primary constraint.</p>
        <p class="text-[#0A0A0A]/40 text-sm leading-relaxed mb-6 max-w-[400px]">
          The Blueprint works fastest when you know which lever is holding your system back. The 7-lever audit takes 3 minutes. It tells you exactly where to start.
        </p>
        <a href="/lever-audit-quiz"
          class="blue-btn inline-flex items-center justify-center font-bold border-2 border-[var(--blue)] text-[var(--blue)] bg-transparent px-8 py-4 text-sm tracking-widest uppercase transition-all duration-200 hover:bg-[var(--blue)] hover:text-white">
          Take the 7-Lever Audit →
        </a>
      </div>

      <div class="border border-[var(--blue)]/15 p-8 mb-[2px]">
        <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-3">Greatness Community</p>
        <p class="text-[#0A0A0A]/70 text-sm font-bold mb-2">Keep the momentum alive.</p>
        <p class="text-[#0A0A0A]/35 text-xs leading-relaxed mb-5">Weekly live Q&A with Rainers. Private community. Growing drill library. Where the Blueprint becomes a body of work, not just a document you read once.</p>
        <a href="/community"
          class="inline-flex items-center justify-center font-bold border border-[var(--blue)]/25 text-[var(--ink-soft)]/60 bg-transparent px-6 py-3 text-xs tracking-widest uppercase transition-all duration-200 hover:border-[var(--blue)] hover:text-[var(--ink-soft)]">
          Join the Community →
        </a>
      </div>

      <div class="border border-[#0A0A0A]/8 p-8">
        <p class="text-[#0A0A0A]/30 text-[10px] tracking-widest uppercase mb-3">Application Only</p>
        <p class="text-[#0A0A0A]/70 text-sm font-bold mb-2">Private Architecture</p>
        <p class="text-[#0A0A0A]/35 text-xs leading-relaxed mb-5">The full operating system built around your specific structure. Seven levers deployed together. For fighters who are ready to build. Not just train.</p>
        <a href="/command"
          class="inline-flex items-center justify-center font-bold border border-[#0A0A0A]/15 text-[#0A0A0A]/40 bg-transparent px-6 py-3 text-xs tracking-widest uppercase transition-all duration-200 hover:border-[#0A0A0A]/30 hover:text-[#0A0A0A]/60">
          See Private Architecture →
        </a>
      </div>

    </div>
  </section>

  <section class="bg-[#0A0A0A] px-8 md:px-16 lg:px-24 py-20">
    <div class="max-w-[680px] mx-auto">
      <p class="font-black uppercase tracking-tighter leading-[0.88] text-white/50 text-2xl md:text-3xl mb-4">
        "I do not run aimlessly; I do not box as one beating the air."
      </p>
      <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase">1 Corinthians 9:26</p>
    </div>
  </section>
</Base>
