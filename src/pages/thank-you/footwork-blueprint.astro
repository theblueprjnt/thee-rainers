---
import Base from '../../layouts/Base.astro';

const LOOM_URL = 'https://www.loom.com/share/5dcc29c1138645858c2a100cb2fd1350?sid=875dcfa4-96c0-411d-8548-0655d993cfb4';
---
<Base title="The Footwork Blueprint · Access | Thee Rainers">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <!-- DELIVERY HERO -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 pt-32 pb-16 md:pb-24 border-b border-white/5">
    <div class="max-w-[680px] mx-auto">
      <p class="text-[var(--ink-soft)] text-[11px] tracking-widest uppercase mb-6">Thee Rainers · Free Blueprint</p>
      <h1 class="font-black text-white uppercase tracking-tighter leading-[0.86] mb-6"
        style="font-size: clamp(2.25rem, 5vw, 3.75rem);">
        Check your<br/>email.
      </h1>
      <p class="text-white/45 text-base leading-relaxed mb-12 max-w-[480px]">
        The download link is in your inbox now. While you wait, watch the breakdown below. It covers the four bases the Blueprint is built on.
      </p>

      <a href={LOOM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 bg-[var(--blue)] text-white font-bold px-8 py-4 text-sm tracking-wide uppercase hover:bg-white hover:text-[#0A0A0A] transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--blue)] focus-visible:ring-offset-2 focus-visible:ring-offset-[#0A0A0A]">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <polygon points="6,4 13,8 6,12" fill="currentColor"/>
        </svg>
        Watch the Breakdown
      </a>
    </div>
  </section>

  <!-- WHAT THE BREAKDOWN IS -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-14 border-b border-[#0A0A0A]/8">
    <div class="max-w-[680px] mx-auto">
      <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-3">The Breakdown · Video</p>
      <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-lg mb-3">The four bases explained.</p>
      <p class="text-[#0A0A0A]/50 text-sm leading-relaxed max-w-[480px]">A short walkthrough on the mechanical foundation the blueprint runs on. Watch this before your first session so the drills make sense from the first rep.</p>
    </div>
  </section>

  <!-- NEXT STEP NUDGE -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-14 border-b border-[#0A0A0A]/8">
    <div class="max-w-[680px] mx-auto">
      <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-5">After the blueprint</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <a href="/shadowboxing-blueprint" class="group flex flex-col p-6 border border-[#0A0A0A]/10 hover:border-[var(--navy)]/40 transition-colors duration-200">
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-3">$19 · Shadowboxing Blueprint</p>
          <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-base leading-tight mb-3">Take your footwork into your hands.</p>
          <p class="text-[#0A0A0A]/45 text-xs leading-relaxed flex-1">A practical playbook to build boxing skill. With or without a partner. Every round has a focus, a constraint, and an intention.</p>
          <p class="mt-4 text-[var(--navy)] text-[11px] font-bold tracking-widest uppercase group-hover:opacity-60 transition-opacity">Get the Blueprint →</p>
        </a>

        <a href="/defense-workshop" class="group flex flex-col p-6 border border-[#0A0A0A]/10 hover:border-[var(--blue)]/40 transition-colors duration-200">
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-3">$39 · Defense Workshop</p>
          <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-base leading-tight mb-3">Live. Camera on. Real-time correction.</p>
          <p class="text-[#0A0A0A]/45 text-xs leading-relaxed flex-1">90 minutes. The full defensive structure applied to your movement in real time. Replay included.</p>
          <p class="mt-4 text-[var(--blue)] text-[11px] font-bold tracking-widest uppercase group-hover:opacity-60 transition-opacity">Reserve a Seat →</p>
        </a>

      </div>
    </div>
  </section>

  <!-- SCRIPTURE -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-16 md:py-20">
    <div class="max-w-[600px] mx-auto">
      <p class="font-black uppercase tracking-tighter leading-[0.88] mb-5 text-white/40"
        style="font-size: clamp(1.5rem, 3.5vw, 2.25rem);">
        "I do not run aimlessly. I do not box as one beating the air."
      </p>
      <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase">1 Corinthians 9:26</p>
    </div>
  </section>

</Base>

