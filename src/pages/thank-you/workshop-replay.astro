---
import Layout from '../../layouts/Base.astro';
import PurchaseMoment from '../../components/site/PurchaseMoment.astro';
---
<Layout title="Check Your Email · Thee Rainers">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <meta name="description" content="Your Workshop Replay access link is on its way." />
  </Fragment>

  <section class="bg-white px-8 md:px-16 lg:px-24 pt-32 pb-20">
    <div class="max-w-[720px] mx-auto w-full">

      <PurchaseMoment
        productName="Workshop Replay"
        firstActionCopy="Your link is in your email. Open it and watch from the beginning."
      />

      <div class="border-t border-[#0A0A0A]/6 pt-12 mb-12">
        <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-4">Watch while you wait</p>
        <div class="aspect-video w-full overflow-hidden bg-[#0A0A0A]">
          <iframe
            src="https://www.youtube.com/embed/vdUDuFRUqGo"
            title="Why You Can't Defend Yourself"
            class="w-full h-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <p class="text-[#0A0A0A]/25 text-[10px] tracking-wide mt-3">The structural problem the replay is designed to solve. From the ground up.</p>
      </div>

      <div class="border-t border-[#0A0A0A]/6 pt-8">
        <p class="text-[#0A0A0A]/20 text-[10px] tracking-widest uppercase mb-3">Also from Thee Rainers</p>
        <div class="flex flex-col gap-2">
          <a href="/coaching#grade-1" class="text-[#0A0A0A]/30 text-xs hover:text-[#0A0A0A]/55 transition-colors">Want a coach watching your form? Grade 1 Coaching · $347 →</a>
          <a href="/command" class="text-[#0A0A0A]/30 text-xs hover:text-[#0A0A0A]/55 transition-colors">1-on-1 Coaching · application only →</a>
        </div>
      </div>

    </div>
  </section>
</Layout>
