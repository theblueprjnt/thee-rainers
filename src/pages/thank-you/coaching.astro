---
import Base from '../../layouts/Base.astro';
---
<Base title="You're In · Thee Rainers Coaching">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <section class="bg-white px-8 md:px-16 lg:px-24 pt-32 pb-20">
    <div class="max-w-[760px] mx-auto w-full">

      <p class="text-[var(--ink-soft)] text-[11px] tracking-widest uppercase mb-6">Confirmed</p>
      <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.85] mb-6"
        style="font-size: clamp(2.25rem, 5vw, 3.75rem);">
        You're in.
      </h1>
      <p class="text-[#0A0A0A]/50 text-base leading-relaxed mb-12 max-w-[520px]">
        Book your first call below. It's the next step, and it takes two minutes.
      </p>

      <!-- Calendly inline widget begin -->
      <div
        class="calendly-inline-widget"
        data-url="https://calendly.com/theerainers/1-1"
        style="min-width:320px;height:700px;"
      ></div>
      <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
      <!-- Calendly inline widget end -->

      <p class="text-[#0A0A0A]/25 text-[10px] tracking-wide mt-6 text-center">
        A confirmation email is on its way with everything you need before your call.
      </p>

    </div>
  </section>

</Base>

<script>
  // Meta Pixel Purchase (task 12). This page is shared by all five Grade
  // lookupKeys (grade1/2/3, grade2_plan, grade3_plan) at five different
  // prices, so unlike the single-product thank-you pages there is no one
  // literal value to pass. /api/session-value does a narrow, read-only
  // Stripe lookup on the session_id already in this page's own URL
  // (create-checkout.ts appends it to every success_url) to get the real
  // amount paid.
  async function fireMetaPurchase(): Promise<void> {
    const sessionId = new URLSearchParams(window.location.search).get('session_id');
    if (!sessionId) return;
    try {
      const res = await fetch(`/api/session-value?session_id=${encodeURIComponent(sessionId)}`);
      if (!res.ok) return;
      const data = await res.json() as { value?: number };
      if (typeof data.value === 'number') {
        (window as Window & { __trbMetaPurchase?: (v: number) => void }).__trbMetaPurchase?.(data.value);
      }
    } catch {
      // Non-blocking -- a missed Purchase event here is not worth surfacing to the visitor.
    }
  }

  fireMetaPurchase();
</script>
