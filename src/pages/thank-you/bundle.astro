---
import Base from '../../layouts/Base.astro';
import PurchaseMoment from '../../components/site/PurchaseMoment.astro';
---
<Base title="Complete Bundle · Purchase Confirmed | Thee Rainers">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <section class="bg-white px-8 md:px-16 lg:px-24 pt-32 pb-20">
    <div class="max-w-[720px] mx-auto w-full">

      <PurchaseMoment
        productName="The Complete Bundle"
        firstActionCopy="Both download links are in your email. Start with the Footwork Blueprint. Once the base holds, move to Shadowboxing."
      />

      <div class="border-t border-[#0A0A0A]/6 pt-12 mb-12">
        <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-4">Watch while you wait</p>
        <div class="aspect-video w-full overflow-hidden bg-[#0A0A0A]">
          <iframe
            src="https://www.youtube.com/embed/vdUDuFRUqGo"
            title="Why You Can't Defend Yourself"
            class="w-full h-full"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <p class="text-[#0A0A0A]/25 text-[10px] tracking-wide mt-3">The structural problem both Blueprints are designed to solve. From the ground up.</p>
      </div>

      <div class="border-t border-[#0A0A0A]/6 pt-8">
        <p class="text-[#0A0A0A]/20 text-[10px] tracking-widest uppercase mb-3">Also from Thee Rainers</p>
        <div class="flex flex-col gap-2">
          <!-- COPY: Grade 1 cross-sell link text -->
          <a href="/coaching#grade-1" class="text-[#0A0A0A]/30 text-xs hover:text-[#0A0A0A]/55 transition-colors"></a>
          <a href="/command" class="text-[#0A0A0A]/30 text-xs hover:text-[#0A0A0A]/55 transition-colors">1-on-1 Coaching · application only →</a>
        </div>
      </div>

    </div>
  </section>

  <section class="bg-[#0A0A0A] px-8 md:px-16 lg:px-24 py-20">
    <div class="max-w-[680px] mx-auto">
      <p class="font-black uppercase tracking-tighter leading-[0.88] text-white/50 text-2xl md:text-3xl mb-4">
        "I do not run aimlessly; I do not box as one beating the air."
      </p>
      <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase">1 Corinthians 9:26</p>
    </div>
  </section>
</Base>
