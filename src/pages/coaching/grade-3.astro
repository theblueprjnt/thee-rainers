---
import Layout from '../../layouts/Base.astro';
import GradeSalesTemplate from '../../components/blocks/GradeSalesTemplate.astro';
import { GRADE3_SEATS_TAKEN, GRADE3_MAX_SEATS } from '../../data/grade3-seats.ts';
---
<Layout title="Grade 3 · Thee Rainers Coaching" description="Full access, 1-on-1 boxing coaching built entirely around you. Limited to 5 people at a time.">
  <GradeSalesTemplate
    gradeNumber={3}
    name="Grade 3"
    price="$12,000"
    term="one time · 12 months"
    priceId="grade3"
    seatsTaken={GRADE3_SEATS_TAKEN}
    seatsMax={GRADE3_MAX_SEATS}
    features={[
      'Two calls a week, plus a monthly review call on your measurables',
      'Direct access for footage and messages, fast feedback',
      'Fully customised training designed around their week',
      'In-person option',
      'Max 5 people',
    ]}
  />
</Layout>
