---
import Layout from '../../layouts/Base.astro';
import GradeSalesTemplate from '../../components/blocks/GradeSalesTemplate.astro';
---
<Layout title="Grade 1 Foundation · Thee Rainers Coaching" description="Footwork, punches, and defense, built in the right order. Grade 1 is the foundation for 1-on-1 boxing coaching with Thee Rainers.">
  <GradeSalesTemplate
    gradeNumber={1}
    name="Grade 1 Foundation"
    price="$347"
    term="one time · 90 days"
    priceId="grade1"
    features={[
      'Structured curriculum: footwork, 8 punches, basic defense, rules and etiquette',
      'Boxing psychology: fear, composure, controlled aggression',
      'Unlimited video feedback',
      'Simple metrics: land more, get hit less, stay calm',
    ]}
  />
</Layout>
