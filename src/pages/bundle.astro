---
import Layout from '../layouts/Base.astro';
import Testimonials from '../components/site/Testimonials.astro';

const productSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "The Boxing Basics Bundle",
  "description": "Footwork + Shadowboxing in order. Full video breakdowns, 100+ rounds, 30-day structure, private community access. The complete beginner boxing bundle.",
  "url": "https://theerainers.com/bundle",
  "image": "https://theerainers.com/images/3d_thebundle_cover.png",
  "brand": { "@type": "Brand", "name": "Thee Rainers" },
  "offers": {
    "@type": "Offer",
    "price": "87.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://buy.stripe.com/14A4gz59hgxUaa65006J20m",
  },
});
---
<Layout
  title="Footwork + Shadowboxing Bundle (Full Video Breakdowns, 100+ Rounds, Private Community Access)"
  description="Footwork Blueprint + Shadowboxing Blueprint in order. Full video breakdowns, 100+ rounds, 30-day structure, private community. $87 — save $7.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={productSchema} />
  </Fragment>

  <!-- HERO -->
  <section class="bg-white border-b border-[#0A0A0A]/8 pt-28 md:pt-36 pb-16 md:pb-20">
    <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 grid grid-cols-1 md:grid-cols-[58%_42%] gap-10 md:gap-16 items-center">

      <div>
        <div class="flex items-center gap-3 mb-4">
          <p class="text-[#D4A373] text-[11px] tracking-widest uppercase">Bundle</p>
          <span class="text-[10px] font-bold uppercase tracking-widest text-white bg-[#0057FF] px-2 py-1">Best Value</span>
        </div>
        <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.88] mb-6"
          style="font-size: clamp(2.5rem, 5.5vw, 4.25rem);">
          The Boxing<br/>Basics Bundle.
        </h1>
        <p class="text-[#0A0A0A]/60 text-base md:text-lg leading-relaxed mb-8 max-w-[520px]">
          A complete beginner boxing bundle. Move better. Train with structure. Understand what you are doing from the start.
        </p>

        <div class="flex flex-col gap-3 mb-6 max-w-[420px]">
          <div class="flex items-baseline gap-3">
            <span class="font-black text-[#0A0A0A] text-4xl">$87</span>
            <span class="text-[#0A0A0A]/55 text-xs uppercase tracking-widest">Save $7 vs buying separately</span>
          </div>
          <a href="https://buy.stripe.com/14A4gz59hgxUaa65006J20m"
            class="inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[#0057FF] text-white font-bold px-8 py-4 text-sm tracking-wide uppercase hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4A373] focus-visible:ring-offset-2">
            Get the Bundle →
          </a>
        </div>

        <!-- Specs (Gumroad-style fact sheet) -->
        <div class="max-w-[420px] border-t border-[#0A0A0A]/10">
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold">Includes</span>
            <span class="text-[#0A0A0A] text-sm font-bold text-right">Footwork + Shadowboxing</span>
          </div>
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold">Drills</span>
            <span class="text-[#0A0A0A] text-sm font-bold">100+ rounds</span>
          </div>
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold">Delivery</span>
            <span class="text-[#0A0A0A] text-sm font-bold">Instant digital download</span>
          </div>
          <div class="flex justify-between items-baseline py-3">
            <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold">Language</span>
            <span class="text-[#0A0A0A] text-sm font-bold">English &amp; Spanish</span>
          </div>
        </div>
      </div>

      <div class="order-first md:order-last">
        <div class="relative bg-[#F6F6F6] border border-[#0A0A0A]/10 mx-auto max-w-[420px]">
          <img src="/images/3d_thebundle_cover.png" alt="The Boxing Basics Bundle"
            width="1414" height="2000"
            class="w-full h-auto object-contain" />
        </div>
      </div>

    </div>
  </section>

  <!-- WHAT'S IN IT — Gumroad-style flat bullet list -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[720px] mx-auto">
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.95] mb-6">
        Inside, you'll get:
      </h2>

      <ul class="flex flex-col gap-3 text-[#0A0A0A]/80 text-base leading-relaxed mb-10">
        <li class="flex gap-3"><span class="text-[#D4A373] shrink-0 font-bold">◆</span><span>Full Bases Video Breakdown</span></li>
        <li class="flex gap-3"><span class="text-[#D4A373] shrink-0 font-bold">◆</span><span>56 Rounds of Footwork Drills</span></li>
        <li class="flex gap-3"><span class="text-[#D4A373] shrink-0 font-bold">◆</span><span>30-Day Structure</span></li>
        <li class="flex gap-3"><span class="text-[#D4A373] shrink-0 font-bold">◆</span><span>Common Shadowboxing Mistakes Breakdown</span></li>
        <li class="flex gap-3"><span class="text-[#D4A373] shrink-0 font-bold">◆</span><span>Done-With-Me Shadowboxing Session</span></li>
        <li class="flex gap-3"><span class="text-[#D4A373] shrink-0 font-bold">◆</span><span>Skill Test</span></li>
      </ul>

      <p class="text-[#0A0A0A]/75 text-base leading-relaxed mb-3">
        The Footwork Blueprint helps you build stance, balance, control, and movement with intention.
      </p>
      <p class="text-[#0A0A0A]/75 text-base leading-relaxed">
        The Shadowboxing Blueprint helps you apply that base in a more fluid way, so the training actually carries over into boxing.
      </p>
    </div>
  </section>

  <!-- RECOMMENDED ORDER -->
  <section class="bg-[#F6F6F6] px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[720px] mx-auto">
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.95] mb-6">
        Recommended order
      </h2>
      <p class="text-[#0A0A0A]/75 text-base leading-relaxed mb-3">
        Start with the Footwork Blueprint first, then move into Shadowboxing.
      </p>
      <p class="text-[#0A0A0A]/65 text-base leading-relaxed">
        That way, you first understand the base, then learn how to layer on it.
      </p>
    </div>
  </section>

  <!-- BEST FOR -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[720px] mx-auto">
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.95] mb-6">
        Best for:
      </h2>
      <ul class="flex flex-col gap-2 text-[#0A0A0A]/80 text-base leading-relaxed">
        <li class="flex gap-3"><span class="text-[#0A0A0A]/40 shrink-0">•</span><span>Beginners</span></li>
        <li class="flex gap-3"><span class="text-[#0A0A0A]/40 shrink-0">•</span><span>People training at home</span></li>
        <li class="flex gap-3"><span class="text-[#0A0A0A]/40 shrink-0">•</span><span>Parents getting their kid started</span></li>
        <li class="flex gap-3"><span class="text-[#0A0A0A]/40 shrink-0">•</span><span>Boxers who want more structure and clarity</span></li>
      </ul>
    </div>
  </section>

  <!-- PROOF -->
  <Testimonials filter="remote" heading="Trained from the blueprint" kicker="Results · On Their Own" />

  <!-- FINAL CTA -->
  <section class="bg-[#F6F6F6] px-6 md:px-12 lg:px-20 py-20 border-b border-t border-[#0A0A0A]/8">
    <div class="max-w-[680px] mx-auto text-center">
      <p class="text-[#D4A373] text-[11px] tracking-widest uppercase mb-4">Access the Bundle</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl md:text-5xl leading-[0.9] mb-8">
        Run them in order.
      </h2>
      <div class="flex items-baseline justify-center gap-3 mb-2">
        <span class="font-black text-[#0A0A0A] text-4xl">$87</span>
      </div>
      <p class="text-[#0A0A0A]/55 text-xs uppercase tracking-widest mb-6">Save $7 vs buying separately</p>
      <a href="https://buy.stripe.com/14A4gz59hgxUaa65006J20m"
        class="inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[#0057FF] text-white font-bold px-10 py-4 text-sm tracking-wide uppercase hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4A373] focus-visible:ring-offset-2">
        Get the Bundle →
      </a>
      <p class="text-[11px] text-[#0A0A0A]/55 mt-4">120+ fighters training the system.</p>

      <div class="mt-12 pt-10 border-t border-[#0A0A0A]/10 flex flex-col sm:flex-row items-center justify-center gap-4 text-xs">
        <span class="text-[#0A0A0A]/40 uppercase tracking-widest">Or buy one module</span>
        <a href="/footwork-blueprint" class="text-[#0057FF] font-bold tracking-widest uppercase hover:text-[#0A0A0A] transition-colors">Footwork only — $47 →</a>
        <a href="/shadowboxing-blueprint" class="text-[#0057FF] font-bold tracking-widest uppercase hover:text-[#0A0A0A] transition-colors">Shadowboxing only — $47 →</a>
      </div>
    </div>
  </section>

  <!-- SCRIPTURE -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-20">
    <div class="max-w-[680px] mx-auto">
      <p class="font-black uppercase tracking-tighter leading-[0.88] text-white/50 text-2xl md:text-3xl mb-4">
        "I do not run aimlessly. I do not box as one beating the air."
      </p>
      <p class="text-[#D4A373] text-[10px] tracking-widest uppercase">1 Corinthians 9:26-27</p>
    </div>
  </section>

</Layout>
