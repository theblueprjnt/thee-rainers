---
export const prerender = false;

import Layout from '../layouts/Base.astro';
import Testimonials from '../components/site/Testimonials.astro';

// Aug 2 2026 00:00 Europe/Lisbon = Aug 1 2026 23:00:00 UTC
const FOOTWORK_FREE_UNTIL = new Date('2026-08-01T23:00:00Z');
const isFootworkFree = new Date() < FOOTWORK_FREE_UNTIL;

const productSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Book",
  "name": "The Footwork Blueprint",
  "description": "Win Fights with Footwork. A practical playbook to move with balance, control, and intent. 56 rounds of drills, Foundations Footwork video, 30-Day Base Training Structure.",
  "url": "https://theerainers.com/foundation",
  "image": "https://theerainers.com/images/3d_thefootworkblueprint_cover.jpg",
  "inLanguage": ["en", "es"],
  "isAccessibleForFree": isFootworkFree,
  "author": { "@type": "Organization", "name": "Thee Rainers", "url": "https://theerainers.com" },
  "offers": {
    "@type": "Offer",
    "price": isFootworkFree ? "0" : "9.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://theerainers.com/foundation",
  },
});
---
<Layout
  title={isFootworkFree ? "The Footwork Blueprint · Free Download | Thee Rainers" : "The Footwork Blueprint · $9 | Thee Rainers"}
  description={isFootworkFree ? "The Footwork Blueprint. 56 rounds of drills, full video breakdown, 30-Day base training structure. Orthodox and Southpaw. Free download." : "The Footwork Blueprint. 56 rounds of drills, full video breakdown, 30-Day base training structure. Orthodox and Southpaw. $9."}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={productSchema} />
  </Fragment>

  <!-- Countdown banner — only visible while free -->
  {isFootworkFree && (
    <div class="bg-[var(--terra)] text-white text-center py-2 px-4 text-[11px] tracking-widest uppercase font-bold">
      Free until August 2. Goes to $9. &nbsp;<span id="tr-countdown" class="font-black"></span>
    </div>
  )}

  <!-- HERO -->
  <section class="relative overflow-hidden bg-[var(--warm)]">

    <div class="relative max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-20 md:pt-36 pb-16 md:pb-24
                grid grid-cols-1 md:grid-cols-[55%_45%] gap-10 md:gap-14 items-center">

      <!-- Left: copy + capture/checkout -->
      <div class="order-2 md:order-1">
        <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-4">
          {isFootworkFree ? 'Free · The Footwork Blueprint' : '$9 · The Footwork Blueprint'}
        </p>
        <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.88] mb-6"
          style="font-size: clamp(2.5rem, 5.5vw, 4.25rem);">
          The Footwork<br/>Blueprint.
        </h1>
        <p class="text-[#0A0A0A]/60 text-base md:text-lg leading-relaxed mb-2 max-w-[520px]">
          Win fights with footwork, and take fewer hits doing it. A practical playbook to move with balance, control, and intent. Every step has a job.{isFootworkFree ? ' Free.' : ' $9.'}
        </p>
        <p class="text-[#0A0A0A]/35 text-sm mb-8 max-w-[520px]">For fighters who train seriously and want to move with purpose. From Rainers, pro boxer and coach.</p>

        {isFootworkFree ? (
          <!-- Free: email capture form -->
          <div id="capture-wrap" class="max-w-[520px] mb-8">
            <form id="capture-form" class="flex flex-col gap-3">
              <input
                type="text"
                id="capture-name"
                required
                placeholder="Your name"
                autocomplete="name"
                class="w-full border border-[#0A0A0A]/15 bg-[#F7F6F4] px-5 py-4 text-[#0A0A0A] text-sm focus:border-[var(--blue)] focus:bg-white focus:outline-none transition-colors duration-200 placeholder:text-[#0A0A0A]/30"
              />
              <input
                type="email"
                id="capture-email"
                required
                placeholder="your@email.com"
                autocomplete="email"
                class="w-full border border-[#0A0A0A]/15 bg-[#F7F6F4] px-5 py-4 text-[#0A0A0A] text-sm focus:border-[var(--blue)] focus:bg-white focus:outline-none transition-colors duration-200 placeholder:text-[#0A0A0A]/30"
              />
              <button
                type="submit"
                id="capture-submit"
                class="inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[var(--red)] text-white font-bold px-8 py-4 text-sm tracking-widest uppercase transition-opacity duration-150 hover:opacity-85 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--red)] focus-visible:ring-offset-2"
              >
                Get the Blueprint · Free
              </button>
            </form>
            <p class="text-[11px] text-[#0A0A0A]/35 mt-4">You get the Blueprint plus training emails from Rainers. Unsubscribe any time. <a href="/legal/privacy-policy" class="underline hover:text-[#0A0A0A]/60 transition-colors">Privacy Policy</a>.</p>
          </div>
        ) : (
          <!-- Paid: Stripe checkout -->
          <div class="max-w-[520px] mb-8 flex flex-col gap-3">
            <button type="button" data-checkout="footwork"
              class="inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[var(--red)] text-white font-bold px-8 py-4 text-sm tracking-widest uppercase transition-opacity duration-150 hover:opacity-85 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--red)] focus-visible:ring-offset-2">
              Get the Blueprint · $9
            </button>
            <p class="text-[11px] text-[#0A0A0A]/35">One-time purchase. Instant PDF download. <a href="/legal/refund-policy" class="underline hover:text-[#0A0A0A]/60 transition-colors">Refund Policy</a>.</p>
          </div>
        )}

        <!-- Specs -->
        <div class="max-w-[520px] border-t border-[#0A0A0A]/10">
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">Drills</span>
            <span class="text-[#0A0A0A] text-sm font-bold">56 rounds · Orthodox and Southpaw</span>
          </div>
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">Video Breakdown</span>
            <span class="text-[#0A0A0A] text-sm font-bold">11 min</span>
          </div>
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">Format</span>
            <span class="text-[#0A0A0A] text-sm font-bold">21-page playbook, zero filler</span>
          </div>
          <div class="flex justify-between items-baseline py-3">
            <span class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">Delivery</span>
            <span class="text-[#0A0A0A] text-sm font-bold">Instant digital download</span>
          </div>
        </div>
      </div>

      <!-- Right: 3D cover floating on a soft IG-gradient halo -->
      <div class="order-1 md:order-2 flex justify-center md:justify-end">
        <div class="relative w-full max-w-[420px] md:max-w-[460px]">
          <!-- Cover -->
          <picture>
            <source srcset="/images/footwork-cover-opt.webp" type="image/webp" />
            <img
              src="/images/footwork-cover-opt.jpg"
              alt="The Footwork Blueprint, 3D book cover"
              width="920" height="848"
              loading="eager"
              fetchpriority="high"
              class="relative w-full h-auto object-contain tr-blueprint-float"
            />
          </picture>
        </div>
      </div>

    </div>
  </section>

  <!-- WHY IT MATTERS — 3 pillars -->
  <section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 py-14 md:py-20 border-t border-[#0B0B0C]/8">
    <div class="max-w-[1100px] mx-auto">
      <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-3">Why The Base</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl md:text-4xl leading-[0.88] mb-10">
        The base carries everything.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="border-l-2 border-[#0A0A0A]/15 pl-5 py-1">
          <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-2">Power From The Floor</p>
          <p class="text-[#0A0A0A]/55 text-sm leading-relaxed">Most of your punch power comes from the ground up. A broken base costs you before you throw a single punch.</p>
        </div>
        <div class="border-l-2 border-[#0A0A0A]/15 pl-5 py-1">
          <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-2">Holds Under Pressure</p>
          <p class="text-[#0A0A0A]/55 text-sm leading-relaxed">Drill the right movements now and they become automatic when it gets hard. That is what this builds.</p>
        </div>
        <div class="border-l-2 border-[#0A0A0A]/15 pl-5 py-1">
          <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-2">No Gym Required</p>
          <p class="text-[#0A0A0A]/55 text-sm leading-relaxed">21 pages. 56 rounds. Just you and the work. Your body is enough.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- 30-DAY OUTCOME -->
  <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 py-14 border-b border-white/5">
    <div class="max-w-[860px] mx-auto">
      <p class="text-white/50 text-[10px] tracking-widest uppercase mb-5">With consistent work, this is what changes.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[1px] bg-white/8">
        <div class="bg-[#0B0B0C] p-8">
          <p class="text-white font-black uppercase tracking-tight text-sm mb-3">You stop bouncing randomly.</p>
          <p class="text-white/40 text-sm leading-relaxed">Every step has a purpose. Your stance connects to the ground and the ground connects to your punch.</p>
        </div>
        <div class="bg-[#0B0B0C] p-8">
          <p class="text-white font-black uppercase tracking-tight text-sm mb-3">Your base holds under pressure.</p>
          <p class="text-white/40 text-sm leading-relaxed">The drills build it in repetition. When you step, punch, and recover, the base stays intact instead of collapsing.</p>
        </div>
        <div class="bg-[#0B0B0C] p-8">
          <p class="text-white font-black uppercase tracking-tight text-sm mb-3">You know exactly where you are.</p>
          <p class="text-white/40 text-sm leading-relaxed">Balance, weight transfer, and foot position become readable. You stop guessing and start seeing what needs fixing next.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <div class="border-t border-[#0A0A0A]/8">
    <Testimonials heading="What fighters say." kicker="Field Report" />
  </div>

  <!-- UPSELL: Defense Workshop -->
  <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 py-14 md:py-20 border-t border-white/5">
    <div class="max-w-[1100px] mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="max-w-[640px]">
        <p class="text-white/50 text-[10px] tracking-widest uppercase mb-3">When the base holds · Next step</p>
        <h2 class="font-black text-white uppercase tracking-tighter text-2xl md:text-3xl leading-[0.9] mb-4">
          The Defense Workshop.
        </h2>
        <p class="text-white/55 text-sm leading-relaxed">Live Aug 29. Real-time correction on your movement. Replay included. The mechanical structure to hit, exit, and reset.</p>
      </div>
      <a href="/defense-workshop"
        class="tr-btn shrink-0">
        Reserve Seat · $39
      </a>
    </div>
  </section>

  <!-- SCRIPTURE -->
  <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 py-20">
    <div class="max-w-[680px] mx-auto">
      <p class="font-black uppercase tracking-tighter leading-[0.88] text-white/50 text-2xl md:text-3xl mb-4">
        "I do not run aimlessly; I do not box as one beating the air."
      </p>
      <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">1 Corinthians 9:26</p>
    </div>
  </section>

</Layout>

<style>
  /* Subtle float to make the 3D cover feel weighted, not pasted. */
  @keyframes tr-cover-float {
    0%, 100% { transform: translateY(0) rotateZ(-1.5deg); }
    50%      { transform: translateY(-8px) rotateZ(-1deg); }
  }
  .tr-blueprint-float {
    animation: tr-cover-float 6s ease-in-out infinite;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .tr-blueprint-float { animation: none; transform: rotateZ(-1.5deg); }
  }
</style>

<script>
  // Countdown timer — only runs when the banner element is present (free state only)
  (function () {
    var deadline = new Date('2026-08-01T23:00:00Z').getTime();
    var el = document.getElementById('tr-countdown');
    if (!el) return;
    function update() {
      var remaining = deadline - Date.now();
      if (remaining <= 0) {
        window.location.reload();
        return;
      }
      var h = Math.floor(remaining / 3600000);
      var m = Math.floor((remaining % 3600000) / 60000);
      var s = Math.floor((remaining % 60000) / 1000);
      el.textContent = h + 'h ' + (m < 10 ? '0' : '') + m + 'm ' + (s < 10 ? '0' : '') + s + 's';
    }
    update();
    setInterval(update, 1000);
  })();
</script>

<script>
  function wireCapture(): void {
    const form = document.getElementById('capture-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const nameEl = document.getElementById('capture-name') as HTMLInputElement | null;
    const emailEl = document.getElementById('capture-email') as HTMLInputElement | null;
    const submit = document.getElementById('capture-submit') as HTMLButtonElement | null;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = emailEl?.value.trim() ?? '';
      const full_name = nameEl?.value.trim() ?? '';
      if (!email || !full_name) return;

      if (submit) { submit.disabled = true; submit.textContent = 'One moment...'; }

      // Fire lead-capture webhook in the background — delivery is on the next page.
      fetch('/api/lead-capture', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, full_name, source: 'footwork-blueprint' }),
      }).catch(err => console.warn('[capture] webhook failed:', err));

      (window as Window & { trackEvent?: (n: string, d: Record<string, unknown>) => void }).trackEvent?.('generate_lead', {
        lead_source: 'footwork-blueprint',
        currency: 'USD',
        value: 0,
      });

      // Redirect to delivery page — PDF auto-downloads there.
      setTimeout(() => { window.location.href = '/thank-you/footwork-blueprint'; }, 400);
    });
  }

  wireCapture();
</script>
