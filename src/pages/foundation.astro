---
export const prerender = false;

import Layout from '../layouts/Base.astro';
import Testimonials from '../components/site/Testimonials.astro';
import { PRODUCTS } from '../data/products.ts';

const priceDollars = `$${(PRODUCTS.footwork.priceCents / 100).toFixed(0)}`;

// Aug 2 2026 00:00 Europe/Lisbon = Aug 1 2026 23:00:00 UTC
const FOOTWORK_FREE_UNTIL = new Date('2026-08-01T23:00:00Z');
const isFootworkFree = new Date() < FOOTWORK_FREE_UNTIL;

const productSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Book",
  "name": "The Footwork Blueprint",
  "description": "Win Fights with Footwork. A practical playbook to move with balance, control, and intent. 56 rounds of drills, Foundations Footwork video, 30-Day Base Training Structure.",
  "url": "https://theerainers.com/foundation",
  "image": "https://theerainers.com/images/3d_thefootworkblueprint_cover.jpg",
  "inLanguage": ["en"],
  "isAccessibleForFree": isFootworkFree,
  "author": { "@type": "Organization", "name": "Thee Rainers", "url": "https://theerainers.com" },
  "offers": {
    "@type": "Offer",
    "price": isFootworkFree ? "0" : (PRODUCTS.footwork.priceCents / 100).toFixed(2),
    "priceCurrency": PRODUCTS.footwork.currency,
    "availability": "https://schema.org/InStock",
    "url": "https://theerainers.com/foundation",
  },
});
---
<Layout
  title={isFootworkFree ? "The Footwork Blueprint · Free Download | Thee Rainers" : "The Footwork Blueprint | Thee Rainers"}
  description={isFootworkFree ? "The Footwork Blueprint. 56 rounds of drills, full video breakdown, 30-Day base training structure. Orthodox and Southpaw. Free download." : "The Footwork Blueprint. 56 rounds of drills, full video breakdown, 30-Day base training structure. Orthodox and Southpaw."}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={productSchema} />
  </Fragment>

  <!-- Countdown banner — only visible while free -->
  {isFootworkFree && (
    <div class="bg-[var(--terra)] text-white text-center py-2 px-4 text-[11px] tracking-widest uppercase font-bold">
      Free until August 2. Goes to {priceDollars}. &nbsp;<span id="tr-countdown" class="font-black"></span>
    </div>
  )}

  <!-- HERO -->
  <section class="relative overflow-hidden bg-white">

    <div class="relative max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-20 md:pt-36 pb-16 md:pb-24
                grid grid-cols-1 md:grid-cols-[55%_45%] gap-10 md:gap-14 items-center">

      <!-- Left: copy + capture/checkout -->
      <div class="order-2 md:order-1">
        <h1 class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-[0.88] mb-6"
          style="font-size: clamp(2.5rem, 5.5vw, 4.25rem);">
          The Footwork<br/>Blueprint.
        </h1>
        <p class="text-[#0B0B0C]/60 text-base md:text-lg leading-relaxed mb-2 max-w-[520px]">
          Win fights with footwork, and take fewer hits doing it. A practical playbook to move with balance, control, and intent. Every step has a job.
        </p>
        <p class="text-[#0B0B0C]/35 text-sm mb-8 max-w-[520px]">For people who want to move with purpose.<br/>Rainers</p>

        {isFootworkFree ? (
          <!-- Free: email capture form -->
          <div id="capture-wrap" class="max-w-[520px] mb-8">
            <form id="capture-form" class="flex flex-col gap-3">
              <input
                type="text"
                id="capture-name"
                required
                placeholder="Your name"
                autocomplete="name"
                class="w-full border border-[#0B0B0C]/15 bg-[#F7F6F4] px-5 py-4 text-[#0B0B0C] text-sm focus:border-[var(--blue)] focus:bg-white focus:outline-none transition-colors duration-200 placeholder:text-[#0B0B0C]/30"
              />
              <input
                type="email"
                id="capture-email"
                required
                placeholder="your@email.com"
                autocomplete="email"
                class="w-full border border-[#0B0B0C]/15 bg-[#F7F6F4] px-5 py-4 text-[#0B0B0C] text-sm focus:border-[var(--blue)] focus:bg-white focus:outline-none transition-colors duration-200 placeholder:text-[#0B0B0C]/30"
              />
              <button
                type="submit"
                id="capture-submit"
                class="inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[var(--red)] text-white font-bold px-8 py-4 text-sm tracking-widest uppercase transition-opacity duration-150 hover:opacity-85 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--red)] focus-visible:ring-offset-2"
              >
                Get the Blueprint · Free
              </button>
            </form>
            <p class="text-[11px] text-[#0B0B0C]/35 mt-4">You get the Blueprint plus training emails from Rainers. Unsubscribe any time. <a href="/legal/privacy-policy" class="underline hover:text-[#0B0B0C]/60 transition-colors">Privacy Policy</a>.</p>
          </div>
        ) : (
          <!-- Paid: Stripe checkout -->
          <div class="max-w-[520px] mb-8 flex flex-col gap-3">
            <button type="button" data-checkout="footwork"
              class="inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[var(--red)] text-white font-bold px-8 py-4 text-sm tracking-widest uppercase transition-opacity duration-150 hover:opacity-85 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--red)] focus-visible:ring-offset-2">
              I want this
            </button>
            <p class="text-[11px] text-[#0B0B0C]/35">One-time purchase. Instant PDF download. <a href="/legal/refund-policy" class="underline hover:text-[#0B0B0C]/60 transition-colors">Refund Policy</a>.</p>
          </div>
        )}

        <!-- Specs -->
        <div class="max-w-[520px] border-t border-[#0B0B0C]/10">
          <div class="flex justify-between items-baseline py-3 border-b border-[#0B0B0C]/10">
            <span class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">Drills</span>
            <span class="text-[#0B0B0C] text-sm font-bold">56 rounds · Orthodox and Southpaw</span>
          </div>
          <div class="flex justify-between items-baseline py-3 border-b border-[#0B0B0C]/10">
            <span class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">Video Breakdown</span>
            <span class="text-[#0B0B0C] text-sm font-bold">11 min</span>
          </div>
          <div class="flex justify-between items-baseline py-3 border-b border-[#0B0B0C]/10">
            <span class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">Format</span>
            <span class="text-[#0B0B0C] text-sm font-bold">21-page playbook, zero filler</span>
          </div>
          <div class="flex justify-between items-baseline py-3">
            <span class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">Delivery</span>
            <span class="text-[#0B0B0C] text-sm font-bold">Instant digital download</span>
          </div>
        </div>
      </div>

      <!-- Right: 3D cover floating on a soft IG-gradient halo -->
      <div class="order-1 md:order-2 flex justify-center md:justify-end">
        <div class="relative w-full max-w-[420px] md:max-w-[460px]">
          <!-- Cover -->
          <picture>
            <source srcset="/images/footwork-cover-opt.webp" type="image/webp" />
            <img
              src="/images/footwork-cover-opt.jpg"
              alt="The Footwork Blueprint, 3D book cover"
              width="920" height="848"
              loading="eager"
              fetchpriority="high"
              class="relative w-full h-auto object-contain tr-blueprint-float"
            />
          </picture>
        </div>
      </div>

    </div>
  </section>

  <!-- PRODUCT DETAILS — Gumroad structure, proven to convert -->
  <section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 py-14 md:py-20 border-t border-[#0B0B0C]/8">
    <div class="max-w-[720px] mx-auto">

      <!-- What's in it? -->
      <div class="mb-14">
        <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.9] mb-6">
          What's in it?
        </h2>

        <p class="text-[#0B0B0C] text-sm font-bold mb-2">Foundations Footwork Video <span class="text-[var(--terra)]">(NEW)</span></p>
        <p class="text-[#0B0B0C]/55 text-sm leading-relaxed mb-3">A clear explanation of footwork:</p>
        <ul class="mb-4 space-y-2">
          <li class="text-[#0B0B0C]/55 text-sm leading-relaxed pl-4 border-l-2 border-[#0B0B0C]/15">How to step and punch without breaking your stance</li>
          <li class="text-[#0B0B0C]/55 text-sm leading-relaxed pl-4 border-l-2 border-[#0B0B0C]/15">How weight transfer affects power and recovery</li>
          <li class="text-[#0B0B0C]/55 text-sm leading-relaxed pl-4 border-l-2 border-[#0B0B0C]/15">How elite fighters stay balanced while moving, striking, and resetting</li>
        </ul>
        <p class="text-[#0B0B0C]/55 text-sm leading-relaxed mb-6">This video explains the logic behind the drills so you know why you're doing them.</p>

        <ul class="space-y-3">
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">56 Rounds of Drills to build elite movement (Orthodox & Southpaw)</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">Used by boxers, kickboxers, MMA strikers & coaches</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">The full Blueprint in a clean, easy-to-follow breakdown</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">30-Day Base Training Structure <span class="text-[var(--terra)]">(NEW)</span>. A simple way to apply the drills correctly instead of guessing, so you know how to run the Blueprint inside your own training</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">Early access to the private community chat. Connect with other fighters and get tips.</li>
        </ul>
      </div>

      <!-- Who this is for -->
      <div class="mb-14">
        <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.9] mb-6">
          Who this is for.
        </h2>
        <ul class="space-y-3">
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">Boxers and combat athletes who want better balance, angles, and movement</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">Fighters who feel stiff, flat-footed, or inconsistent when moving</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">Coaches who want a simple footwork structure they can reuse</li>
        </ul>
      </div>

      <!-- How it helps -->
      <div class="mb-14">
        <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.9] mb-6">
          Here's how it helps you become a better boxer.
        </h2>
        <ul class="space-y-3">
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">You learn to keep balance while moving and throwing punches (stance and mechanics foundation)</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">You learn to transfer force from your feet</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">You learn to control the center of the ring better</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">You learn to apply and escape pressure easier</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">Bonus: you learn how to choose the best drills for your progress without wasting time</li>
        </ul>
      </div>

      <!-- How can I make sure it has value? -->
      <div class="mb-14">
        <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.9] mb-6">
          How can I make sure it has value?
        </h2>
        <p class="text-[#0B0B0C] font-bold text-sm mb-4">Buy once. Train forever.</p>
        <ul class="space-y-3">
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">Open the Blueprint even five years from now, pick drills, and train.</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">Save time by learning the way top fighters train.</li>
        </ul>
      </div>

      <!-- Why me? -->
      <div class="mb-14">
        <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.9] mb-6">
          Why me?
        </h2>
        <p class="text-[#0B0B0C]/55 text-sm leading-relaxed mb-3">It's not about me.</p>
        <p class="text-[#0B0B0C]/55 text-sm leading-relaxed mb-3">I gathered top fighters' and coaches' knowledge in one place to give you the skills needed to win.</p>
        <p class="text-[#0B0B0C]/55 text-sm leading-relaxed">These drills are tested and proven.</p>
      </div>

      <!-- Who gets the most out of it? -->
      <div class="mb-14">
        <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.9] mb-6">
          Who gets the most out of it?
        </h2>
        <p class="text-[#0B0B0C]/70 text-sm leading-relaxed">People who have wasted time watching scattered YouTube tutorials and want effective training that lasts.</p>
      </div>

      <!-- Hesitation? -->
      <div class="mb-14">
        <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.9] mb-6">
          Hesitation?
        </h2>
        <p class="text-[#0B0B0C]/55 text-sm leading-relaxed mb-5">If you think you don't have space for footwork drills in your current training plan: reduce other workouts by 20 percent and do footwork in the remaining time. You will feel the improvement in your movement, attacks, and defense.</p>
        <a href="https://www.loom.com/share/5dcc29c1138645858c2a100cb2fd1350?sid=875dcfa4-96c0-411d-8548-0655d993cfb4"
          target="_blank" rel="noopener"
          class="text-[var(--terra)] text-[11px] font-bold tracking-widest uppercase hover:opacity-80 transition-opacity inline-flex items-center gap-2">
          Watch: Preview on Loom <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Bonuses -->
      <div class="border-t border-[#0B0B0C]/10 pt-10">
        <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-5">Bonuses</p>
        <ul class="space-y-3">
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">Loom video breakdown: 4 bases explained</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">Perfect for solo training, gym warmups, and skill gaps</li>
          <li class="text-[#0B0B0C]/70 text-sm leading-relaxed">Lifetime access, plus future minor updates</li>
        </ul>
      </div>

    </div>
  </section>

  <!-- TESTIMONIALS -->
  <div class="border-t border-[#0A0A0A]/8">
    <Testimonials heading="What fighters say." kicker="Field Report" />
  </div>

  <!-- UPSELL: Defense Workshop -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-14 md:py-20 border-t border-[#0B0B0C]/8">
    <div class="max-w-[1100px] mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="max-w-[640px]">
        <p class="text-[#0B0B0C]/50 text-[10px] tracking-widest uppercase mb-3">When the base holds · Next step</p>
        <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter text-2xl md:text-3xl leading-[0.9] mb-4">
          The Defense Workshop.
        </h2>
        <p class="text-[#0B0B0C]/55 text-sm leading-relaxed">A live session on the five layers of defense in boxing, Aug 29. Replay included.</p>
      </div>
      <a href="/defense-workshop"
        class="tr-btn shrink-0">
        Reserve Seat · $49
      </a>
    </div>
  </section>

</Layout>

<style>
  /* Subtle float to make the 3D cover feel weighted, not pasted. */
  @keyframes tr-cover-float {
    0%, 100% { transform: translateY(0) rotateZ(-1.5deg); }
    50%      { transform: translateY(-8px) rotateZ(-1deg); }
  }
  .tr-blueprint-float {
    animation: tr-cover-float 6s ease-in-out infinite;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .tr-blueprint-float { animation: none; transform: rotateZ(-1.5deg); }
  }
</style>

<script>
  // Countdown timer — only runs when the banner element is present (free state only)
  (function () {
    var deadline = new Date('2026-08-01T23:00:00Z').getTime();
    var el = document.getElementById('tr-countdown');
    if (!el) return;
    function update() {
      var remaining = deadline - Date.now();
      if (remaining <= 0) {
        window.location.reload();
        return;
      }
      var h = Math.floor(remaining / 3600000);
      var m = Math.floor((remaining % 3600000) / 60000);
      var s = Math.floor((remaining % 60000) / 1000);
      el.textContent = h + 'h ' + (m < 10 ? '0' : '') + m + 'm ' + (s < 10 ? '0' : '') + s + 's';
    }
    update();
    setInterval(update, 1000);
  })();
</script>

<script>
  function wireCapture(): void {
    const form = document.getElementById('capture-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const nameEl = document.getElementById('capture-name') as HTMLInputElement | null;
    const emailEl = document.getElementById('capture-email') as HTMLInputElement | null;
    const submit = document.getElementById('capture-submit') as HTMLButtonElement | null;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = emailEl?.value.trim() ?? '';
      const full_name = nameEl?.value.trim() ?? '';
      if (!email || !full_name) return;

      if (submit) { submit.disabled = true; submit.textContent = 'One moment...'; }

      // Fire lead-capture webhook in the background — delivery is on the next page.
      fetch('/api/lead-capture', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, full_name, source: 'footwork-blueprint' }),
      }).catch(err => console.warn('[capture] webhook failed:', err));

      (window as Window & { trackEvent?: (n: string, d: Record<string, unknown>) => void }).trackEvent?.('generate_lead', {
        lead_source: 'footwork-blueprint',
        currency: 'USD',
        value: 0,
      });

      // Redirect to delivery page — PDF auto-downloads there.
      setTimeout(() => { window.location.href = '/thank-you/footwork-blueprint'; }, 400);
    });
  }

  wireCapture();
</script>
