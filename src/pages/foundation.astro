---
import Layout from '../layouts/Base.astro';
import Testimonials from '../components/site/Testimonials.astro';

const productSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Book",
  "name": "The Footwork Blueprint",
  "description": "Win Fights with Footwork. A practical playbook to move with balance, control, and intent. 56 rounds of drills, Foundations Footwork video, 30-Day Base Training Structure.",
  "url": "https://theerainers.com/foundation",
  "image": "https://theerainers.com/images/3d_thefootworkblueprint_cover.jpg",
  "inLanguage": ["en", "es"],
  "isAccessibleForFree": true,
  "author": { "@type": "Organization", "name": "Thee Rainers", "url": "https://theerainers.com" },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://theerainers.com/foundation",
  },
});
---
<Layout
  title="The Footwork Blueprint · Free Download | Thee Rainers"
  description="The Footwork Blueprint. 56 rounds of drills, full video breakdown, 30-Day base training structure. Orthodox and Southpaw. Free download.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={productSchema} />
  </Fragment>

  <!-- HERO — light, with a soft IG gradient halo seated behind the 3D cover -->
  <section class="relative overflow-hidden bg-white border-b border-[#0A0A0A]/8">

    <div class="relative max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 pt-20 md:pt-36 pb-16 md:pb-24
                grid grid-cols-1 md:grid-cols-[55%_45%] gap-10 md:gap-14 items-center">

      <!-- Left: copy + capture -->
      <div class="order-2 md:order-1">
        <p class="text-[var(--ink-soft)] text-[11px] tracking-widest uppercase mb-4">Free · The Footwork Blueprint</p>
        <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.88] mb-6"
          style="font-size: clamp(2.5rem, 5.5vw, 4.25rem);">
          The Footwork<br/>Blueprint.
        </h1>
        <p class="text-[#0A0A0A]/60 text-base md:text-lg leading-relaxed mb-2 max-w-[520px]">
          Win fights with footwork. A practical playbook to move with balance, control, and intent. Every step has a job. Free. Instant download.
        </p>
        <p class="text-[#0A0A0A]/35 text-sm mb-8 max-w-[520px]">For fighters who train seriously and want to move with purpose. From Rainers — pro boxer, coach.</p>

        <!-- Capture form -->
        <div id="capture-wrap" class="max-w-[520px] mb-8">
          <form id="capture-form" class="flex flex-col gap-3">
            <input
              type="text"
              id="capture-name"
              required
              placeholder="Your name"
              autocomplete="name"
              class="w-full border border-[#0A0A0A]/15 bg-[#F7F6F4] px-5 py-4 text-[#0A0A0A] text-sm focus:border-[var(--blue)] focus:bg-white focus:outline-none transition-colors duration-200 placeholder:text-[#0A0A0A]/30"
            />
            <input
              type="email"
              id="capture-email"
              required
              placeholder="your@email.com"
              autocomplete="email"
              class="w-full border border-[#0A0A0A]/15 bg-[#F7F6F4] px-5 py-4 text-[#0A0A0A] text-sm focus:border-[var(--blue)] focus:bg-white focus:outline-none transition-colors duration-200 placeholder:text-[#0A0A0A]/30"
            />
            <button
              type="submit"
              id="capture-submit"
              class="inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[var(--blue)] text-white font-bold px-8 py-4 text-sm tracking-widest uppercase transition-colors duration-150 hover:bg-[#0A0A0A] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--blue)] focus-visible:ring-offset-2"
            >
              Get the Blueprint · Free →
            </button>
          </form>
          <p id="capture-success" class="hidden text-[var(--blue)] text-sm tracking-wide mt-4">Your blueprint is downloading. Save the PDF when prompted.</p>
          <p id="capture-error" class="hidden text-[var(--red)] text-sm mt-3">Something went wrong. Try again.</p>
          <p class="text-[11px] text-[#0A0A0A]/35 mt-4">No payment. No spam. Unsubscribe any time.</p>
        </div>

        <!-- Specs -->
        <div class="max-w-[520px] border-t border-[#0A0A0A]/10">
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase font-bold">Drills</span>
            <span class="text-[#0A0A0A] text-sm font-bold">56 rounds · Orthodox and Southpaw</span>
          </div>
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase font-bold">Video Breakdown</span>
            <span class="text-[#0A0A0A] text-sm font-bold">11 min</span>
          </div>
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase font-bold">Format</span>
            <span class="text-[#0A0A0A] text-sm font-bold">21-page playbook, zero filler</span>
          </div>
          <div class="flex justify-between items-baseline py-3">
            <span class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase font-bold">Delivery</span>
            <span class="text-[#0A0A0A] text-sm font-bold">Instant digital download</span>
          </div>
        </div>
      </div>

      <!-- Right: 3D cover floating on a soft IG-gradient halo -->
      <div class="order-1 md:order-2 flex justify-center md:justify-end">
        <div class="relative w-full max-w-[420px] md:max-w-[460px]">
          <!-- Wide gradient halo seated behind the cover -->
          <div aria-hidden="true"
            class="absolute -inset-10 md:-inset-16 blur-3xl opacity-90 pointer-events-none"
            style="background:
              radial-gradient(40% 35% at 28% 30%, rgba(240,148,51,0.55), transparent 70%),
              radial-gradient(45% 40% at 75% 45%, rgba(220,39,67,0.50), transparent 70%),
              radial-gradient(40% 40% at 50% 80%, rgba(106,13,173,0.45), transparent 75%);">
          </div>
          <!-- Cover -->
          <img
            src="/images/3d_thefootworkblueprint_cover.jpg"
            alt="The Footwork Blueprint — 3D book cover"
            width="1600" height="2000"
            loading="eager"
            fetchpriority="high"
            class="relative w-full h-auto object-contain drop-shadow-[0_40px_70px_rgba(0,0,0,0.30)] tr-blueprint-float"
          />
        </div>
      </div>

    </div>
  </section>

  <!-- WHY IT MATTERS — 3 pillars -->
  <section class="bg-white px-6 md:px-12 lg:px-20 py-14 md:py-20 border-b border-[#0A0A0A]/8">
    <div class="max-w-[1100px] mx-auto">
      <p class="text-[var(--ink-soft)] text-[11px] tracking-widest uppercase mb-3">Why The Base</p>
      <h2 class="font-black text-[#0A0A0A] uppercase tracking-tighter text-3xl md:text-4xl leading-[0.88] mb-10">
        The base carries everything.
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="border-l-2 border-[#0A0A0A]/15 pl-5 py-1">
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-2">Power From The Floor</p>
          <p class="text-[#0A0A0A]/55 text-sm leading-relaxed">Most of your punch power comes from the ground up. A broken base costs you before you throw a single punch.</p>
        </div>
        <div class="border-l-2 border-[#0A0A0A]/15 pl-5 py-1">
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-2">Holds Under Pressure</p>
          <p class="text-[#0A0A0A]/55 text-sm leading-relaxed">Drill the right movements now and they become automatic when it gets hard. That is what this builds.</p>
        </div>
        <div class="border-l-2 border-[#0A0A0A]/15 pl-5 py-1">
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-2">No Gym Required</p>
          <p class="text-[#0A0A0A]/55 text-sm leading-relaxed">21 pages. 56 rounds. Just you and the work. Your body is enough.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- TESTIMONIALS -->
  <div class="border-t border-[#0A0A0A]/8">
    <Testimonials heading="What fighters say." kicker="Field Report" />
  </div>

  <!-- UPSELL: Workshop Replay -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-14 md:py-20 border-t border-white/5">
    <div class="max-w-[1100px] mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="max-w-[640px]">
        <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-3">When the base holds · Next step</p>
        <h2 class="font-black text-white uppercase tracking-tighter text-2xl md:text-3xl leading-[0.9] mb-4">
          The Workshop Replay.
        </h2>
        <p class="text-white/55 text-sm leading-relaxed">90 minutes on demand. Defense mechanics from the ground up. The blueprint gives you the base. The replay shows it applied.</p>
      </div>
      <a href="/workshop-replay"
        class="shrink-0 inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[var(--blue)] text-white font-bold px-8 py-4 text-sm tracking-widest uppercase transition-opacity duration-150 hover:opacity-80 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--blue)] focus-visible:ring-offset-2">
        Watch the Replay · $79 →
      </a>
    </div>
  </section>

  <!-- SCRIPTURE -->
  <section class="bg-[#0A0A0A] px-6 md:px-12 lg:px-20 py-20">
    <div class="max-w-[680px] mx-auto">
      <p class="font-black uppercase tracking-tighter leading-[0.88] text-white/50 text-2xl md:text-3xl mb-4">
        "I do not run aimlessly; I do not box as one beating the air."
      </p>
      <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase">1 Corinthians 9:26</p>
    </div>
  </section>

</Layout>

<style>
  /* Subtle float to make the 3D cover feel weighted, not pasted. */
  @keyframes tr-cover-float {
    0%, 100% { transform: translateY(0) rotateZ(-1.5deg); }
    50%      { transform: translateY(-8px) rotateZ(-1deg); }
  }
  .tr-blueprint-float {
    animation: tr-cover-float 6s ease-in-out infinite;
    transform-origin: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .tr-blueprint-float { animation: none; transform: rotateZ(-1.5deg); }
  }
</style>

<script>
  function triggerDownload(url: string, filename: string): void {
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.rel = 'noopener';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  function wireCapture(): void {
    const form = document.getElementById('capture-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const nameEl = document.getElementById('capture-name') as HTMLInputElement | null;
    const emailEl = document.getElementById('capture-email') as HTMLInputElement | null;
    const submit = document.getElementById('capture-submit') as HTMLButtonElement | null;
    const success = document.getElementById('capture-success')!;
    const error = document.getElementById('capture-error')!;

    // PDF-first wiring. The user ALWAYS gets the file even if the lead-capture
    // backend fails (Make.com outage, env-var rotation, etc). We trigger the
    // download immediately, fire the webhook in the background, and only fall
    // back to the inline error if the PDF itself somehow can't be served.
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailEl?.value.trim() ?? '';
      const full_name = nameEl?.value.trim() ?? '';
      if (!email || !full_name) return;

      if (submit) { submit.disabled = true; submit.textContent = 'Preparing...'; }
      error.classList.add('hidden');

      // 1. Trigger the PDF download FIRST. This is the contract with the user.
      try {
        triggerDownload('/pdfs/foundation.pdf', 'The-Footwork-Blueprint-Thee-Rainers.pdf');
      } catch {
        error.classList.remove('hidden');
        if (submit) { submit.disabled = false; submit.textContent = 'Get the Blueprint · Free →'; }
        return;
      }

      // 2. Show success state immediately.
      form.classList.add('hidden');
      success.classList.remove('hidden');

      (window as Window & { trackEvent?: (n: string, d: Record<string, unknown>) => void }).trackEvent?.('generate_lead', {
        lead_source: 'footwork-blueprint',
        currency: 'USD',
        value: 0,
      });

      // 3. Fire the Make.com webhook in the background (fire-and-forget).
      // Backend failure does not block delivery. Errors are logged for diagnostics.
      fetch('/api/lead-capture', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, full_name, source: 'footwork-blueprint' }),
      }).catch(err => console.warn('[capture] background webhook failed:', err));
    });
  }

  wireCapture();
  document.addEventListener('astro:page-load', wireCapture);
</script>
