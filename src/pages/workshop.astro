---
import Layout from '../layouts/Base.astro';
import Testimonials from '../components/site/Testimonials.astro';
import {
  workshopState, nextDateDisplay,
  WORKSHOP_DATE_LONG, WORKSHOP_DATE_SHORT, WORKSHOP_TIME,
  WORKSHOP_PRICE, WORKSHOP_PAYMENT_LINK,
  WORKSHOP_QUOTE, WORKSHOP_QUOTE_ATTR, WORKSHOP_VIDEO_ID,
  NEXT_DATE_ISO,
} from '../data/workshop.ts';

const state       = workshopState();
const dateDisplay = nextDateDisplay();

// Schema only valid when a real event is scheduled
const eventSchema = (state === 'selling' && NEXT_DATE_ISO) ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "Defense Workshop",
  "description": "90 minutes. Camera on. Real-time correction on defensive structure, movement, and mechanics.",
  "startDate": NEXT_DATE_ISO,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
  "location": { "@type": "VirtualLocation", "url": "https://theerainers.com/workshop" },
  "organizer": { "@type": "Organization", "name": "Thee Rainers", "url": "https://theerainers.com" },
  "offers": {
    "@type": "Offer",
    "price": String(WORKSHOP_PRICE),
    "priceCurrency": "USD",
    "url": WORKSHOP_PAYMENT_LINK,
    "availability": "https://schema.org/InStock"
  }
}) : null;

// Headline: real attendee quote when set, otherwise fallback
const heroHeadline = WORKSHOP_QUOTE || null;
const heroFallback = 'The mechanics most gyms skip.';

const inclusions = [
  { label: '90 minutes live', detail: 'Camera on. You are in the session, not watching from the side.' },
  { label: '5 layers of defense', detail: 'Stance through full defensive structure, built in sequence.' },
  { label: 'Real-time correction', detail: 'Rainers watching your movement and correcting it during the session.' },
  { label: 'Sparring application block', detail: 'The framework applied to scenarios. You see where it holds.' },
  { label: 'Q and A block', detail: 'Direct questions on what showed up in your movement.' },
  { label: 'Full recording', detail: 'Delivered within 24 hours. Watch again whenever you need it.' },
];
---

<Layout
  title="Defense Workshop · Thee Rainers"
  description="90 minutes. Camera on. The 5 layers of defense in boxing. How to position to hit and not get hit.">
  <Fragment slot="head">
    {eventSchema && <script type="application/ld+json" set:html={eventSchema} />}
    <meta name="description" content="90 minutes. Camera on. The 5 layers of defense in boxing. How to position to hit and not get hit." />
  </Fragment>

  <!-- ================================================================ -->
  <!-- STATE: WAITLIST — date set, tickets closed (CURRENT STATE)       -->
  <!-- ================================================================ -->
  {state === 'waitlist' && (
    <>
      <!-- Hero -->
      <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 pt-32 pb-20 md:pt-44 md:pb-28 border-b border-white/5">
        <div class="max-w-[780px]">
          <p class="text-[var(--terra)] text-[11px] tracking-widest font-bold mb-6">anyone can throw a punch. only the best boxers learn defense.</p>
          <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">Defense Workshop</p>
          <h1 class="font-black text-white uppercase tracking-tighter leading-[0.84] mb-5"
            style="font-size: clamp(2.75rem, 6vw, 5rem);">
            <!-- DRAFT: voice pass Rainers -->
            The next cohort<br/>is being planned.
          </h1>
          <div class="h-0.5 w-12 bg-[var(--terra)] mb-8"></div>
          <p class="text-white/50 text-base leading-relaxed max-w-[480px] mb-10">
            <!-- DRAFT: voice pass Rainers -->
            The next Defense Workshop runs {WORKSHOP_DATE_LONG}. Add your name to the list and you will get the date and details before it opens publicly.
          </p>
          <p class="text-white/30 text-xs tracking-wide">Two options below.</p>
        </div>
      </section>

      <!-- Two doors -->
      <section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 py-20">
        <div class="max-w-[1100px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-px bg-[#0B0B0C]/10">

          <!-- Door 1: Replay -->
          <div class="bg-white p-10 md:p-12 flex flex-col">
            <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-4">Available Now · $49</p>
            <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-tight mb-4"
              style="font-size: clamp(1.75rem, 3vw, 2.25rem);">
              <!-- DRAFT: voice pass Rainers -->
              Train the system now.
            </h2>
            <p class="text-[#0B0B0C]/55 text-sm leading-relaxed flex-1 mb-8">
              <!-- DRAFT: voice pass Rainers -->
              The full Defense Workshop recording. 90 minutes on the 5 layers. Same material. Watch on your schedule.
            </p>
            <a href="/workshop-replay" class="tr-btn" style="justify-content:center;">
              Get the Replay · $49
            </a>
          </div>

          <!-- Door 2: Waitlist form -->
          <div class="bg-white p-10 md:p-12 flex flex-col">
            <p class="text-[var(--navy)] text-[10px] tracking-widest uppercase font-bold mb-4">Defense Workshop · Waitlist</p>
            <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-tight mb-4"
              style="font-size: clamp(1.75rem, 3vw, 2.25rem);">
              <!-- DRAFT: voice pass Rainers -->
              Join the list.
            </h2>
            <p class="text-[#0B0B0C]/55 text-sm leading-relaxed mb-8">
              <!-- DRAFT: voice pass Rainers -->
              You will get the date and link before it opens publicly. No commitment.
            </p>

            <form id="waitlist-form" class="flex flex-col gap-4 flex-1">
              <div class="flex flex-col gap-1.5">
                <label for="wl-name" class="text-[#0B0B0C]/40 text-[10px] tracking-widest uppercase font-bold">First name</label>
                <input type="text" id="wl-name" name="full_name" required autocomplete="given-name"
                  class="border-b border-[#0B0B0C]/15 bg-transparent py-3 text-[#0B0B0C] text-sm focus:border-[var(--terra)] focus:outline-none transition-colors" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="wl-email" class="text-[#0B0B0C]/40 text-[10px] tracking-widest uppercase font-bold">Email</label>
                <input type="email" id="wl-email" name="email" required autocomplete="email"
                  class="border-b border-[#0B0B0C]/15 bg-transparent py-3 text-[#0B0B0C] text-sm focus:border-[var(--terra)] focus:outline-none transition-colors" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="wl-phone" class="text-[#0B0B0C]/40 text-[10px] tracking-widest uppercase font-bold">Phone <span class="text-[#0B0B0C]/25 normal-case not-uppercase">(optional)</span></label>
                <input type="tel" id="wl-phone" name="phone" autocomplete="tel"
                  class="border-b border-[#0B0B0C]/15 bg-transparent py-3 text-[#0B0B0C] text-sm focus:border-[var(--terra)] focus:outline-none transition-colors" />
              </div>
              <input type="text" name="website" class="hidden" autocomplete="off" tabindex="-1" />
              <button type="submit" id="wl-submit"
                class="tr-btn mt-2" style="justify-content:center;">
                <!-- DRAFT: voice pass Rainers -->
                Add me to the list
              </button>
            </form>

            <div id="waitlist-success" class="hidden flex-col justify-center flex-1 py-6">
              <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-3">You are on the list.</p>
              <p class="font-black text-[#0B0B0C] uppercase tracking-tighter text-2xl leading-tight mb-3">
                <!-- DRAFT: voice pass Rainers -->
                Details coming soon.
              </p>
              <p class="text-[#0B0B0C]/45 text-sm leading-relaxed">
                <!-- DRAFT: voice pass Rainers -->
                You will get an email when the date is confirmed and before the link goes public.
              </p>
            </div>
          </div>

        </div>
      </section>

      <!-- Replay proof below -->
      <Testimonials ids={["giancarlo-remote", "elizabeth-inperson"]} heading="What fighters say" kicker="On Film" background="void" />
    </>
  )}

  <!-- ================================================================ -->
  <!-- STATE: BETWEEN — no date or date passed                          -->
  <!-- ================================================================ -->
  {state === 'between' && (
    <>
      <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 pt-32 pb-20 md:pt-44 md:pb-28 border-b border-white/5">
        <div class="max-w-[680px]">
          <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">Defense Workshop</p>
          <h1 class="font-black text-white uppercase tracking-tighter leading-[0.84] mb-5"
            style="font-size: clamp(2.75rem, 6vw, 5rem);">
            <!-- DRAFT: voice pass Rainers -->
            No active cohort<br/>at the moment.
          </h1>
          <div class="h-0.5 w-12 bg-[var(--terra)] mb-8"></div>
          <p class="text-white/50 text-base leading-relaxed max-w-[440px]">
            <!-- DRAFT: voice pass Rainers -->
            The full recording from the last session is available. Add your name below and you will hear about the next one first.
          </p>
        </div>
      </section>

      <section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 py-20">
        <div class="max-w-[1100px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-px bg-[#0B0B0C]/10">
          <div class="bg-white p-10 md:p-12 flex flex-col">
            <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-4">Available Now · $49</p>
            <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-tight mb-4"
              style="font-size: clamp(1.75rem, 3vw, 2.25rem);">
              <!-- DRAFT: voice pass Rainers -->
              Train the system now.
            </h2>
            <p class="text-[#0B0B0C]/55 text-sm leading-relaxed flex-1 mb-8">
              <!-- DRAFT: voice pass Rainers -->
              The full Defense Workshop recording. 90 minutes. Same framework. Watch when you are ready.
            </p>
            <a href="/workshop-replay" class="tr-btn" style="justify-content:center;">
              Get the Replay · $49
            </a>
          </div>
          <div class="bg-white p-10 md:p-12 flex flex-col">
            <p class="text-[var(--navy)] text-[10px] tracking-widest uppercase font-bold mb-4">Next Workshop · TBA</p>
            <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-tight mb-4"
              style="font-size: clamp(1.75rem, 3vw, 2.25rem);">
              <!-- DRAFT: voice pass Rainers -->
              Get notified first.
            </h2>
            <p class="text-[#0B0B0C]/55 text-sm leading-relaxed mb-8">
              <!-- DRAFT: voice pass Rainers -->
              Add your name. No commitment. You will hear about the next date before it is announced publicly.
            </p>
            <form id="waitlist-form" class="flex flex-col gap-4 flex-1">
              <div class="flex flex-col gap-1.5">
                <label for="wl-name" class="text-[#0B0B0C]/40 text-[10px] tracking-widest uppercase font-bold">First name</label>
                <input type="text" id="wl-name" name="full_name" required autocomplete="given-name"
                  class="border-b border-[#0B0B0C]/15 bg-transparent py-3 text-[#0B0B0C] text-sm focus:border-[var(--terra)] focus:outline-none transition-colors" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="wl-email" class="text-[#0B0B0C]/40 text-[10px] tracking-widest uppercase font-bold">Email</label>
                <input type="email" id="wl-email" name="email" required autocomplete="email"
                  class="border-b border-[#0B0B0C]/15 bg-transparent py-3 text-[#0B0B0C] text-sm focus:border-[var(--terra)] focus:outline-none transition-colors" />
              </div>
              <input type="text" name="website" class="hidden" autocomplete="off" tabindex="-1" />
              <button type="submit" id="wl-submit" class="tr-btn mt-2" style="justify-content:center;">
                <!-- DRAFT: voice pass Rainers -->
                Notify me
              </button>
            </form>
            <div id="waitlist-success" class="hidden flex-col justify-center flex-1 py-6">
              <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold mb-3">You are on the list.</p>
              <p class="font-black text-[#0B0B0C] uppercase tracking-tighter text-2xl leading-tight mb-3">
                <!-- DRAFT: voice pass Rainers -->
                Details coming soon.
              </p>
              <p class="text-[#0B0B0C]/45 text-sm leading-relaxed">
                <!-- DRAFT: voice pass Rainers -->
                You will get an email when the next date is confirmed.
              </p>
            </div>
          </div>
        </div>
      </section>

      <Testimonials ids={["giancarlo-remote", "elizabeth-inperson"]} heading="What fighters say" kicker="On Film" background="void" />
    </>
  )}

  <!-- ================================================================ -->
  <!-- STATE: SELLING — tickets open, future date set                   -->
  <!-- ================================================================ -->
  {state === 'selling' && (
    <>
      <!-- 1. Hero -->
      <section class="bg-[var(--warm)] overflow-hidden border-b border-[#0B0B0C]/8">
        <div class="md:hidden w-full overflow-hidden bg-[#0B0B0C]" style="height: 65vw; max-height: 360px;">
          <picture>
            <source srcset="/images/rainers-training-opt.webp" type="image/webp" />
            <img src="/images/rainers-training-opt.jpg" alt="Rainers demonstrating defensive mechanics"
              width="1166" height="1099" loading="eager" fetchpriority="high"
              class="w-full h-full object-cover grayscale" style="object-position: 42% 5%;" />
          </picture>
        </div>

        <div class="max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-[60%_40%] md:min-h-[90vh]">
          <div class="px-8 md:px-16 lg:px-24 pt-14 md:pt-40 pb-12 md:pb-16 flex flex-col justify-center">
            <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">Defense Workshop · Live · {WORKSHOP_DATE_SHORT}</p>
            <!-- Quote headline or fallback -->
            {heroHeadline ? (
              <h1 class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-[0.84] mb-4"
                style="font-size: clamp(2.25rem, 5vw, 3.75rem);">
                <!-- DRAFT: voice pass Rainers -->
                {heroHeadline}
              </h1>
              <p class="text-[#0B0B0C]/45 text-sm tracking-wide uppercase font-bold mb-8">{WORKSHOP_QUOTE_ATTR}</p>
            ) : (
              <h1 class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-[0.84] mb-8"
                style="font-size: clamp(2.25rem, 5vw, 3.75rem);">
                <!-- DRAFT: voice pass Rainers -->
                {heroFallback}
              </h1>
            )}
            <div class="h-0.5 w-12 bg-[var(--terra)] mb-8"></div>
            <p class="text-[#0B0B0C]/60 text-base max-w-[460px] leading-relaxed mb-10">
              90 minutes. Camera on. Real-time correction on defensive structure, movement, and mechanics. {WORKSHOP_DATE_LONG} · {WORKSHOP_TIME}.
            </p>
            <div class="flex flex-col gap-3 max-w-[400px]">
              <a href={WORKSHOP_PAYMENT_LINK} class="tr-btn" style="justify-content:center;">
                Reserve your seat · ${WORKSHOP_PRICE}
              </a>
              <p class="text-[11px] text-[#0B0B0C]/30">
                Secure checkout via Stripe ·
                <a href="/legal/refund-policy" class="underline hover:text-[#0B0B0C]/60">Refund Policy</a>
              </p>
            </div>
          </div>
          <div class="hidden md:block relative overflow-hidden bg-[#0B0B0C]">
            <picture>
              <source srcset="/images/rainers-training-opt.webp" type="image/webp" />
              <img src="/images/rainers-training-opt.jpg" alt="Rainers demonstrating defensive mechanics"
                width="1166" height="1099" loading="eager" fetchpriority="high"
                class="absolute inset-0 w-full h-full object-cover grayscale" style="object-position: 42% 5%;" />
            </picture>
          </div>
        </div>
      </section>

      <!-- 2. Video slot — hidden when WORKSHOP_VIDEO_ID is empty -->
      {WORKSHOP_VIDEO_ID && (
        <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 py-16 md:py-24 border-b border-white/5">
          <div class="max-w-[760px] mx-auto">
            <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-8 text-center">Before you decide</p>
            <div class="relative w-full" style="aspect-ratio: 16/9;">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${WORKSHOP_VIDEO_ID}?rel=0`}
                title="Defense Workshop preview"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
                class="absolute inset-0 w-full h-full border-0"
              ></iframe>
            </div>
          </div>
        </section>
      )}

      <!-- 3. Pain block -->
      <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 py-20 md:py-28 border-b border-white/5">
        <div class="max-w-[860px]">
          <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-8">The problem</p>
          <h2 class="font-black text-white uppercase tracking-tighter leading-[0.86] mb-8"
            style="font-size: clamp(2rem, 4vw, 3.25rem);">
            <!-- DRAFT: voice pass Rainers -->
            You can see the punch coming.<br/>You still get hit.
          </h2>
          <div class="h-0.5 w-12 bg-[var(--terra)] mb-8"></div>
          <p class="text-white/50 text-base leading-relaxed max-w-[560px] mb-6">
            <!-- DRAFT: voice pass Rainers -->
            The punch you did not see is not the problem. The one you saw and could not move away from is. That is a position problem. Position is a stance problem. Stance is where this session starts.
          </p>
          <p class="text-white/35 text-sm leading-relaxed max-w-[520px]">
            <!-- DRAFT: voice pass Rainers -->
            Most defense training starts at the hands. This starts at the base. You cannot use your hands correctly if your feet and position are wrong first.
          </p>
        </div>
        <div class="mt-14">
          <a href={WORKSHOP_PAYMENT_LINK} class="tr-btn">
            Reserve your seat · ${WORKSHOP_PRICE}
          </a>
        </div>
      </section>

      <!-- 4. Fit list -->
      <section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 py-20 md:py-28 border-b border-[#0B0B0C]/8">
        <div class="max-w-[1100px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24">
          <div>
            <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">This is for you if</p>
            <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-[0.86] mb-8"
              style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
              <!-- DRAFT: voice pass Rainers -->
              Right for you.
            </h2>
            <ul class="flex flex-col gap-4">
              {[
                'You train boxing and want to stop eating punches you should be avoiding.',
                'Your defense breaks down when pressure comes and you do not know why.',
                'You can shadowbox cleanly but it does not transfer to sparring.',
                'You want a structure you can drill, not advice you forget.',
              ].map(item => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-[var(--terra)]"></span>
                  <p class="text-[#0B0B0C]/60 text-sm leading-relaxed">
                    <!-- DRAFT: voice pass Rainers -->
                    {item}
                  </p>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <p class="text-[#0B0B0C]/35 text-[11px] tracking-widest uppercase font-bold mb-6">Pass on this if</p>
            <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-[0.86] mb-8"
              style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
              <!-- DRAFT: voice pass Rainers -->
              Not the right fit.
            </h2>
            <ul class="flex flex-col gap-4">
              {[
                'You are looking for motivation or general fitness content.',
                'You are a complete beginner with no boxing training at all.',
                'You want recorded advice with no camera on.',
              ].map(item => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-[#0B0B0C]/20"></span>
                  <p class="text-[#0B0B0C]/40 text-sm leading-relaxed">
                    <!-- DRAFT: voice pass Rainers -->
                    {item}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- 5. Objection pair -->
      <section class="bg-[#0B0B0C] px-6 md:px-12 lg:px-20 py-20 md:py-28 border-b border-white/5">
        <div class="max-w-[1100px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20">
          <div>
            <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">How this is different</p>
            <h2 class="font-black text-white uppercase tracking-tighter leading-[0.86] mb-6"
              style="font-size: clamp(1.75rem, 3vw, 2.25rem);">
              <!-- DRAFT: voice pass Rainers -->
              Base first.
            </h2>
            <div class="h-0.5 w-10 bg-[var(--terra)] mb-8"></div>
            <p class="text-white/50 text-sm leading-relaxed">
              <!-- DRAFT: voice pass Rainers -->
              Most workshops teach you what to do under pressure. This session teaches you why the position breaks before pressure arrives. The base controls everything. Fix the base and the rest becomes trainable.
            </p>
          </div>
          <div>
            <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">How you know it is real</p>
            <h2 class="font-black text-white uppercase tracking-tighter leading-[0.86] mb-6"
              style="font-size: clamp(1.75rem, 3vw, 2.25rem);">
              <!-- DRAFT: voice pass Rainers -->
              Documented work.
            </h2>
            <div class="h-0.5 w-10 bg-[var(--terra)] mb-8"></div>
            <p class="text-white/50 text-sm leading-relaxed mb-4">
              <!-- DRAFT: voice pass Rainers -->
              Rainers has run documented 1-on-1 coaching engagements. The Footwork Blueprint has been downloaded by fighters training at home, in gyms, and preparing for competition.
            </p>
            <p class="text-white/30 text-sm leading-relaxed">
              <!-- DRAFT: voice pass Rainers -->
              The Composure Guarantee: show up and do the work. If you leave without a clear framework for how you defend yourself, email rainers@theerainers.com within 24 hours. Full refund. No forms.
            </p>
          </div>
        </div>
        <div class="mt-14">
          <a href={WORKSHOP_PAYMENT_LINK} class="tr-btn">
            Reserve your seat · ${WORKSHOP_PRICE}
          </a>
        </div>
      </section>

      <!-- 6. What you get -->
      <section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 py-20 md:py-28 border-b border-[#0B0B0C]/8">
        <div class="max-w-[860px]">
          <p class="text-[var(--terra)] text-[11px] tracking-widest uppercase font-bold mb-6">What is included</p>
          <h2 class="font-black text-[#0B0B0C] uppercase tracking-tighter leading-[0.86] mb-4"
            style="font-size: clamp(2rem, 4vw, 3rem);">
            <!-- DRAFT: voice pass Rainers -->
            The full session.
          </h2>
          <div class="h-0.5 w-12 bg-[var(--terra)] mb-10"></div>
          <div class="flex flex-col divide-y divide-[#0B0B0C]/8 mb-10">
            {inclusions.map(item => (
              <div class="py-5 grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-2 sm:gap-8">
                <p class="text-[#0B0B0C] text-sm font-bold uppercase tracking-wide">{item.label}</p>
                <p class="text-[#0B0B0C]/50 text-sm leading-relaxed">{item.detail}</p>
              </div>
            ))}
          </div>
          <div class="flex items-center gap-6 flex-wrap">
            <span class="font-black text-[#0B0B0C] text-4xl">${WORKSHOP_PRICE}</span>
            <a href={WORKSHOP_PAYMENT_LINK} class="tr-btn">
              Reserve your seat
            </a>
          </div>
          <p class="mt-4 text-[11px] text-[#0B0B0C]/30">
            Secure checkout via Stripe ·
            <a href="/legal/terms" class="underline hover:text-[#0B0B0C]/60">Terms</a> &amp;
            <a href="/legal/refund-policy" class="underline hover:text-[#0B0B0C]/60">Refund Policy</a>
          </p>
        </div>
      </section>

      <!-- 7. Proof slots -->
      <Testimonials ids={["giancarlo-remote", "elizabeth-inperson"]} heading="What fighters say" kicker="On Film" background="void" />

      <!-- 8. Final CTA -->
      <section class="bg-[var(--warm)] px-6 md:px-12 lg:px-20 py-16 md:py-24 border-t border-[#0B0B0C]/8">
        <div class="max-w-[1100px] mx-auto flex flex-col md:flex-row items-start md:items-end justify-between gap-10">
          <div class="max-w-[560px]">
            <p class="text-[#0B0B0C]/25 font-black uppercase tracking-tighter leading-[0.9] mb-4"
              style="font-size: clamp(1.5rem, 3.5vw, 2.5rem);">
              "I do not run aimlessly. I do not box as one beating the air."
            </p>
            <p class="text-[var(--terra)] text-[10px] tracking-widest uppercase font-bold">1 Corinthians 9:26</p>
          </div>
          <div class="flex flex-col gap-4 shrink-0">
            <a href={WORKSHOP_PAYMENT_LINK} class="tr-btn">
              Reserve your seat · ${WORKSHOP_PRICE}
            </a>
            <a href="/workshop-replay"
              class="tr-btn tr-btn--secondary">
              Get the Replay · $49
            </a>
          </div>
        </div>
      </section>
    </>
  )}

</Layout>

<script>
  // Waitlist form handler — same pattern as popup
  (function () {
    var form    = document.getElementById('waitlist-form') as HTMLFormElement | null;
    var submit  = document.getElementById('wl-submit') as HTMLButtonElement | null;
    var success = document.getElementById('waitlist-success');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name  = ((document.getElementById('wl-name')  as HTMLInputElement)?.value ?? '').trim();
      var email = ((document.getElementById('wl-email') as HTMLInputElement)?.value ?? '').trim();
      var phone = ((document.getElementById('wl-phone') as HTMLInputElement)?.value ?? '').trim();
      if (!email) return;
      if (submit) { submit.disabled = true; submit.textContent = 'Adding you...'; }

      fetch('/api/lead-capture', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ full_name: name, email: email, phone: phone, source: 'workshop-waitlist' }),
      }).catch(() => {}).finally(() => {
        if (form) form.classList.add('hidden');
        if (success) {
          success.classList.remove('hidden');
          success.style.display = 'flex';
        }
        if (window.trackEvent) window.trackEvent('generate_lead', { lead_source: 'workshop-waitlist', currency: 'USD', value: 0 });
      });
    });
  })();
</script>
