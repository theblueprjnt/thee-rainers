---
import LinkPage from '../layouts/LinkPage.astro';
import { SOCIAL_STATS } from '../data/social-stats';
import { WORKSHOP_DATE_SHORT } from '../data/workshop.ts';
---
<LinkPage title="Thee Rainers · Links">

  <div class="max-w-[440px] mx-auto px-6 py-12 flex flex-col items-center gap-8">

    <!-- Identity -->
    <div class="flex flex-col items-center gap-3 text-center">
      <a href="/">
        <img src="/images/logo-trb.png" alt="Thee Rainers" class="h-10 w-auto" />
      </a>
      <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase">Boxing Performance</p>
      <p class="text-[#0A0A0A]/45 text-sm leading-relaxed max-w-[280px]">Built for people who think in structures.</p>
    </div>

    <!-- Links stack -->
    <div class="w-full flex flex-col gap-3">

      <!-- 1. Free Footwork Blueprint — top of funnel, every visitor sees this -->
      <a href="/foundation"
        class="tr-link tr-link-primary group">
        <span class="tr-link-label">Footwork Blueprint</span>
        <span class="tr-link-meta">$9 →</span>
      </a>

      <!-- 2. Live Workshop — gradient, 2026 hero offer -->
      <a href="/defense-workshop"
        class="tr-link tr-link-accent group">
        <span class="tr-link-label text-white">Defense Workshop</span>
        <span class="tr-link-meta text-white/85">$39 · Aug 29 →</span>
      </a>

      <!-- 3. Latest video — pairs topically with the Workshop offer above -->
      <a href="https://youtu.be/vdUDuFRUqGo"
        target="_blank" rel="noopener"
        class="tr-link tr-link-quiet group">
        <span class="tr-link-label">Why You Can't Defend Yourself</span>
        <span class="tr-link-meta">New · YouTube →</span>
      </a>

      <!-- 4. YouTube subscribe -->
      <a href="https://www.youtube.com/@theerainers"
        target="_blank" rel="noopener"
        class="tr-link tr-link-quiet group">
        <span class="tr-link-label">Subscribe on YouTube</span>
        <span class="tr-link-meta">@theerainers →</span>
      </a>

      <!-- 5. Shop — Blueprints -->
      <a href="/shop"
        class="tr-link tr-link-quiet group">
        <span class="tr-link-label">Shop</span>
        <span class="tr-link-meta">Blueprints · from $9 →</span>
      </a>

      <!-- 6. Workshop Replay — now included with Defense Workshop -->
      <a href="/defense-workshop"
        class="tr-link tr-link-quiet group">
        <span class="tr-link-label">Workshop Replay</span>
        <span class="tr-link-meta">Included with Workshop →</span>
      </a>

      <!-- Divider -->
      <div class="border-t border-[#0A0A0A]/8 my-1"></div>

      <!-- 8. Social platforms — follow loop -->
      <div class="grid grid-cols-2 gap-3">
        <a href="https://www.instagram.com/theerainers" target="_blank" rel="noopener"
          class="flex items-center justify-between gap-2 border border-[#0A0A0A]/10 px-4 py-3 text-[10px] text-[#0A0A0A]/45 tracking-widest uppercase hover:text-[#0A0A0A] hover:border-[#0A0A0A]/25 transition-all duration-200">
          <span>Instagram</span>
          <span class="opacity-60 whitespace-nowrap">{SOCIAL_STATS.instagram}K →</span>
        </a>
        <a href="https://www.tiktok.com/@theerainers" target="_blank" rel="noopener"
          class="flex items-center justify-between gap-2 border border-[#0A0A0A]/10 px-4 py-3 text-[10px] text-[#0A0A0A]/45 tracking-widest uppercase hover:text-[#0A0A0A] hover:border-[#0A0A0A]/25 transition-all duration-200">
          <span>TikTok</span>
          <span class="opacity-60 whitespace-nowrap">{SOCIAL_STATS.tiktok}K →</span>
        </a>
        <a href="https://www.facebook.com/theerainers" target="_blank" rel="noopener"
          class="flex items-center justify-between gap-2 border border-[#0A0A0A]/10 px-4 py-3 text-[10px] text-[#0A0A0A]/45 tracking-widest uppercase hover:text-[#0A0A0A] hover:border-[#0A0A0A]/25 transition-all duration-200">
          <span>Facebook</span>
          <span class="opacity-60 whitespace-nowrap">{SOCIAL_STATS.facebook}K →</span>
        </a>
        <a href="https://www.threads.com/@theerainers" target="_blank" rel="noopener"
          class="flex items-center justify-between gap-2 border border-[#0A0A0A]/10 px-4 py-3 text-[10px] text-[#0A0A0A]/45 tracking-widest uppercase hover:text-[#0A0A0A] hover:border-[#0A0A0A]/25 transition-all duration-200">
          <span>Threads</span>
          <span class="opacity-60 whitespace-nowrap">{SOCIAL_STATS.threads}K →</span>
        </a>
      </div>

      <!-- Divider -->
      <div class="border-t border-[#0A0A0A]/8 my-1"></div>

      <!-- 9. Private Architecture — bottom, highest intent -->
      <a href="/command"
        class="w-full flex items-center justify-between gap-3 px-6 py-4 text-sm font-bold tracking-widest uppercase transition-opacity duration-200 hover:opacity-80 text-white bg-[var(--purple)]">
        <span>1-on-1 Coaching</span>
        <span class="text-xs opacity-80 whitespace-nowrap">Application Only →</span>
      </a>

    </div>

    <!-- Scripture anchor -->
    <p class="text-[#0A0A0A]/15 text-[10px] tracking-widest uppercase text-center mt-4">
      1 Corinthians 9:26-27
    </p>

  </div>

</LinkPage>
