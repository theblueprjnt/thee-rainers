---
export const prerender = false;
import Layout from '../layouts/Base.astro';
import { env as cfEnv } from 'cloudflare:workers';

const e = cfEnv as unknown as Record<string, string>;
const meetLink = e['COMMUNITY_MEET_LINK'] ?? '';
const sessionId = Astro.url.searchParams.get('session_id') ?? '';
---
<Layout title="Welcome · The Weekly Session · Thee Rainers">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <style>
      /* ── Entry curtain ───────────────────────── */
      #tr-curtain {
        position: fixed; inset: 0; z-index: 200;
        display: flex;
        pointer-events: none;
      }
      .tr-c-left, .tr-c-right {
        flex: 1;
        background: #0A0A0A;
      }
      .tr-c-left {
        transform-origin: left center;
        animation: curtain-l 0.65s cubic-bezier(0.76, 0, 0.24, 1) 1.5s forwards;
      }
      .tr-c-right {
        transform-origin: right center;
        animation: curtain-r 0.65s cubic-bezier(0.76, 0, 0.24, 1) 1.5s forwards;
      }
      @keyframes curtain-l { to { transform: scaleX(0); } }
      @keyframes curtain-r { to { transform: scaleX(0); } }
      /* ── Main content ────────────────────────── */
      .tr-main { animation: tr-reveal 0.5s ease-out 1.85s both; }
      @keyframes tr-reveal {
        from { opacity: 0; }
        to   { opacity: 1; }
      }
    </style>
  </Fragment>

  <!-- Curtain animation -->
  <div id="tr-curtain" aria-hidden="true">
    <div class="tr-c-left"></div>
    <div class="tr-c-right"></div>
  </div>

  <section class="tr-main bg-white min-h-screen px-6 md:px-12 lg:px-20 py-28 md:py-36">
    <div class="max-w-[640px] mx-auto w-full flex flex-col gap-16">

      <!-- Welcome -->
      <div>
        <div class="flex items-center gap-3 mb-8">
          <div class="w-2 h-2 rounded-full bg-[#22C55E] shrink-0" aria-hidden="true"></div>
          <p class="text-[var(--ink-soft)] text-[11px] tracking-widest uppercase">Membership confirmed</p>
        </div>
        <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.85]"
          style="font-size: clamp(2.5rem, 6vw, 4rem);">
          You're in.<br/>Welcome to<br/>The Weekly Session.
        </h1>
      </div>

      <!-- First drill -->
      <div class="border-l-4 border-[var(--purple)] pl-6">
        <p class="text-[var(--purple)] text-[10px] tracking-widest uppercase mb-5">Your First Drill</p>
        <p class="font-black text-[#0A0A0A] uppercase tracking-tight text-base mb-6">Week 1. Fundamentals</p>
        <div class="flex flex-col gap-3 mb-6">
          <div class="flex items-baseline gap-3">
            <span class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase shrink-0 w-16">Round 1</span>
            <span class="text-[#0A0A0A]/70 text-sm leading-relaxed">Walking Left + Jab &amp; Feints</span>
          </div>
          <div class="flex items-baseline gap-3">
            <span class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase shrink-0 w-16">Round 2</span>
            <span class="text-[#0A0A0A]/70 text-sm leading-relaxed">Walking Right + Jab &amp; Feints</span>
          </div>
          <div class="flex items-baseline gap-3">
            <span class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase shrink-0 w-16">Round 3</span>
            <span class="text-[#0A0A0A]/70 text-sm leading-relaxed">Shadowboxing (Going Left &amp; Right)</span>
          </div>
        </div>
        <p class="text-[#0A0A0A]/60 text-sm leading-relaxed">
          Work this into your training during the week in 2 or 3-minute rounds. This is your foundation. The main training happens on Tuesday where we correct movement and work through Q&amp;A.
        </p>
      </div>

      <!-- How this works -->
      <div class="flex flex-col gap-8">
        <div>
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-5">How This Works</p>
          <p class="text-[#0A0A0A] text-base leading-relaxed mb-2">
            The Weekly Session is every Tuesday at 3pm ET. <!-- DRAFT: voice pass Rainers -->
          </p>
          <p class="text-[#0A0A0A]/60 text-sm leading-relaxed mb-6">
            This is where the work and feedback connect.
          </p>
          <div class="flex flex-col divide-y divide-[#0A0A0A]/8">
            <div class="py-4 flex items-start gap-4">
              <div class="w-1 h-1 rounded-full bg-[#0A0A0A]/30 mt-2 shrink-0"></div>
              <p class="text-[#0A0A0A]/60 text-sm leading-relaxed">You'll receive the next drill every week by email.</p>
            </div>
            <div class="py-4 flex items-start gap-4">
              <div class="w-1 h-1 rounded-full bg-[#0A0A0A]/30 mt-2 shrink-0"></div>
              <p class="text-[#0A0A0A]/60 text-sm leading-relaxed">All session recordings are available in the member area after each call.</p>
            </div>
          </div>
        </div>

        <!-- Meet link / checkpoint CTA -->
        {meetLink ? (
          <a href={meetLink} target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center font-bold text-white px-8 py-4 text-sm tracking-widest uppercase transition-opacity hover:opacity-85 self-start"
            style="background: var(--red);">
            Join The Weekly Session →
          </a>
        ) : (
          <div class="bg-[#F6F6F6] border border-[#0A0A0A]/8 px-6 py-5">
            <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-1">Next Session</p>
            <p class="text-[#0A0A0A] font-black uppercase tracking-tight text-sm">Tuesday · 3pm ET</p>
            <p class="text-[#0A0A0A]/50 text-xs mt-1">Google Meet link sent by email before each session.</p>
          </div>
        )}
      </div>

      <!-- Customer Portal -->
      {sessionId && (
        <div class="border-t border-[#0A0A0A]/8 pt-8">
          <p class="text-[var(--ink-soft)] text-[10px] tracking-widest uppercase mb-3">Manage Membership</p>
          <p class="text-[#0A0A0A]/50 text-xs leading-relaxed mb-4">Update your card, switch plans, or cancel anytime. No forms. No questions.</p>
          <button id="portal-btn"
            class="text-[var(--blue)] text-xs font-bold tracking-widest uppercase hover:opacity-60 transition-opacity cursor-pointer bg-transparent border-0 p-0 disabled:opacity-40"
            aria-label="Open Customer Portal to manage your subscription">
            Open Customer Portal →
          </button>
        </div>
      )}

      <!-- Questions + member area link -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-4 border-t border-[#0A0A0A]/8">
        <p class="text-[#0A0A0A]/40 text-xs leading-relaxed">
          Questions? Reply to the email or reach out at<br/>
          <a href="mailto:rainers@stepintoring.com" class="text-[var(--blue)] font-bold hover:opacity-60 transition-opacity">rainers@stepintoring.com</a>
        </p>
        <a href="/community/inside" class="text-[var(--purple)] text-xs tracking-widest uppercase font-bold hover:opacity-60 transition-opacity whitespace-nowrap">
          Member Area →
        </a>
      </div>

    </div>
  </section>

</Layout>

<script>
  (function () {
    const seen = sessionStorage.getItem('trb_curtain_1');
    if (seen) {
      const el = document.getElementById('tr-curtain');
      if (el) el.remove();
    } else {
      sessionStorage.setItem('trb_curtain_1', '1');
    }
  })();
</script>

{sessionId && (
  <script define:vars={{ sessionId }}>
    function initPortalButton() {
      const btn = document.getElementById('portal-btn');
      if (!btn || btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.textContent = 'Opening...';
        try {
          const res = await fetch('/api/portal', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ session_id: sessionId }),
          });
          const data = await res.json();
          if (data.url) window.location.href = data.url;
          else { btn.disabled = false; btn.textContent = 'Open Customer Portal →'; }
        } catch {
          btn.disabled = false;
          btn.textContent = 'Open Customer Portal →';
        }
      });
    }
    initPortalButton();
  </script>
)}
