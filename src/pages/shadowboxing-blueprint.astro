---
import Layout from '../layouts/Base.astro';
import Testimonials from '../components/site/Testimonials.astro';

const productSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "The Shadowboxing Blueprint",
  "description": "A practical playbook to build boxing skill with or without a partner. Foundations video on the 6 punches, the 3 mistakes that kill skill, full structured sessions, and a printable round structure PDF.",
  "url": "https://theerainers.com/shadowboxing-blueprint",
  "image": "https://theerainers.com/images/shadowboxingblueprint_covernew.png",
  "brand": { "@type": "Brand", "name": "Thee Rainers" },
  "offers": {
    "@type": "Offer",
    "price": "47.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://buy.stripe.com/5kQdR91X5dlIeqm8cc6J20l",
  },
});
---
<Layout
  title="The Shadowboxing Blueprint: Common Mistakes + Done-With-Me Session + Skill Test"
  description="Build boxing skill with or without a partner. The 6 punches, the 3 mistakes that kill skill, structured sessions, a 3-minute skill test, printable round PDF. $47.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={productSchema} />
  </Fragment>

  <!-- HERO -->
  <section id="buy-bar-sentinel" class="bg-white border-b border-[#0A0A0A]/8 pt-28 md:pt-36 pb-16 md:pb-20">
    <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-20 grid grid-cols-1 md:grid-cols-[58%_42%] gap-10 md:gap-16 items-center">

      <div>
        <p class="text-[#D4A373] text-[11px] tracking-widest uppercase mb-4">Blueprint</p>
        <h1 class="font-black text-[#0A0A0A] uppercase tracking-tighter leading-[0.88] mb-6"
          style="font-size: clamp(2.5rem, 5.5vw, 4.25rem);">
          The Shadowboxing<br/>Blueprint.
        </h1>
        <p class="text-[#0A0A0A]/60 text-base md:text-lg leading-relaxed mb-8 max-w-[520px]">
          A practical playbook to build boxing skill. With or without a partner. Every round has a focus, a constraint, and an intention.
        </p>

        <div class="flex flex-col gap-3 mb-6 max-w-[420px]">
          <div class="flex items-baseline gap-3">
            <span class="font-black text-[#0A0A0A] text-4xl">$47</span>
            <span class="text-[#0A0A0A]/40 text-xs uppercase tracking-widest">One time</span>
          </div>
          <a href="https://buy.stripe.com/5kQdR91X5dlIeqm8cc6J20l"
            class="inline-flex items-center justify-center rounded-none whitespace-nowrap bg-[#0057FF] text-white font-bold px-8 py-4 text-sm tracking-wide uppercase hover:bg-[#0A0A0A] active:bg-[#0A0A0A]/90 transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D4A373] focus-visible:ring-offset-2">
            Get the Shadowboxing Blueprint →
          </a>
          <p class="text-[11px] text-[#0A0A0A]/30">Secure checkout via Stripe · Instant delivery · <a href="/legal/refund-policy" class="underline hover:text-[#0A0A0A]/60">Refund Policy</a></p>
