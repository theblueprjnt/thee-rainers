            <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold">Language</span>
            <span class="text-[#0A0A0A] text-sm font-bold">English</span>
          </div>
          <div class="flex justify-between items-baseline py-3 border-b border-[#0A0A0A]/10">
            <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold">Foundations video</span>
            <span class="text-[#0A0A0A] text-sm font-bold">Included</span>
          </div>
          <div class="flex justify-between items-baseline py-3">
            <span class="text-[#D4A373] text-[10px] tracking-widest uppercase font-bold">Round structure PDF</span>
            <span class="text-[#0A0A0A] text-sm font-bold">Printable</span>
